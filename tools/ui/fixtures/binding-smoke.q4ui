  "state": {
    "progress": {
      "type": "number",
      "initial": 25
    },
    "limit": {
      "type": "number",
      "initial": 100
    },
    "available": {
      "type": "boolean",
      "initial": true
    },
    "shown": {
      "type": "boolean",
      "initial": true
    },
    "heading": {
      "type": "string",
      "initial": "#str_200009"
    },
    "scale": {
      "type": "number",
      "initial": 1,
      "cvar": "ui_retainedScale"
    }
  },
  "bindings": [
    {
      "id": "progress-width",
      "node": "progress-fill",
      "property": "width",
      "value": {
        "op": "clamp",
        "args": [
          {
            "op": "*",
            "args": [
              100,
              {
                "op": "/",
                "args": [
                  {
                    "state": "progress"
                  },
                  {
                    "state": "limit"
                  }
                ]
              }
            ]
          },
          0,
          100
        ]
      }
    },
    {
      "id": "progress-number",
      "node": "reading",
      "property": "text",
      "value": {
        "op": "numberText",
        "args": [
          {
            "state": "progress"
          }
        ]
      }
    },
    {
      "id": "heading-text",
      "node": "reference-title",
      "property": "text",
      "value": {
        "state": "heading"
      }
    },
    {
      "id": "action-availability",
      "node": "reference-controls",
      "property": "enabled",
      "value": {
        "state": "available"
      }
    },
    {
      "id": "panel-visibility",
      "node": "reference-panel",
      "property": "display",
      "value": {
        "op": "select",
        "args": [
          {
            "state": "shown"
          },
          "block",
          "none"
        ]
      }
    },
    {
      "id": "scale-number",
      "node": "scale-reading",
      "property": "text",
      "value": {
        "op": "numberText",
        "args": [
          {
            "state": "scale"
          }
        ],
        "decimals": 2
      }
    }
  ]
