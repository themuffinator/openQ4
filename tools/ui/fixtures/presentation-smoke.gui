// Authored engine contract fixture, not a replacement interface.
windowDef desktop {
    rect 0, 0, 640, 480
    backcolor 0.03, 0.04, 0.05, 1
    float probe "gui::source"
    onNamedEvent first {
        set "gui::source" "1";
    }
    onNamedEvent second {
        set "gui::source" "2";
    }
    windowDef panel {
        rect 40, 40, 560, 400
        visible 1
        noevents 1
        backcolor 0.15, 0.18, 0.10, 1
    }
}
