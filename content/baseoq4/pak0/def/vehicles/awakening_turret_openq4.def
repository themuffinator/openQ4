/*
	openQ4: what The Awakening's mannable Strogg chaingun turret
	(vehicle_q4x_turret_chaingun on model common_turret_strogg, m01 and m04)
	was missing in the alpha.

	While q4xbase is the active game, idGameLocal::FindEntityDef finds
	"<name>_q4x_openq4" ahead of <name>, so the turret, its parts and its
	weapon pick up the definitions below. Each inherits the expansion's own,
	so its damage per round and rate of fire are unchanged. Added: a heavier
	Strogg muzzle flash and its light, tracers, ejected casings, barrel smoke
	after a long burst, servo sound as the gun traverses, rounds that meet
	the crosshair, a zoom, and barrel heat (idVehicleTurretGun) with its own
	HUD. Outside The Awakening these definitions are never looked up.
*/

entityDef vehicle_q4x_turret_chaingun_q4x_openq4
{
	"inherit"				"vehicle_q4x_turret_chaingun"
	"gui_hud"				"guis/vehicles/turret_hud.gui"
}

entityDef vehicle_q4x_turret_chaingun_trench_q4x_openq4
{
	"inherit"				"vehicle_q4x_turret_chaingun_trench"
	"gui_hud"				"guis/vehicles/turret_hud.gui"
}

// The traverse servos: the parts' defs name a move sound and its volume range,
// which no vehicle code ever played. m01's trench turret turns on its own
// parts, m04's on the acid gun's (the expansion's turnrate edit to the acid
// gun's yaw never took effect: retail's acidgun.def is read first).
entityDef vehicle_q4x_turret_chaingun_yaw_q4x_openq4
{
	"inherit"				"vehicle_q4x_turret_chaingun_yaw"
	"playMoveSound"			"1"
}

entityDef vehicle_q4x_turret_chaingun_pitch_q4x_openq4
{
	"inherit"				"vehicle_q4x_turret_chaingun_pitch"
	"playMoveSound"			"1"
}

entityDef vehicle_acidgun_turret_yaw_q4x_openq4
{
	"inherit"				"vehicle_acidgun_turret_yaw"
	"playMoveSound"			"1"
}

entityDef vehicle_acidgun_turret_pitch_q4x_openq4
{
	"inherit"				"vehicle_acidgun_turret_pitch"
	"playMoveSound"			"1"
}

entityDef vehicle_chaingun_weapon_q4x_openq4
{
	"inherit"				"vehicle_chaingun_weapon"
	"spawnclass"			"idVehicleTurretGun"

	// the muzzle sits 14 units off the gunner's eye line: bend each round
	// onto the point under the crosshair instead of firing parallel to it
	"convergence"			"1"

	// zoom: the player machinegun's magnification, at half the spread
	"zoomFov"				"50"
	"zoomTime"				"0.15"
	"zoomSpreadScale"		"0.5"

	// barrel heat, for a player gunner only (m04's scripted gunner never
	// overheats). A cold gun throws its rounds within the 2 degrees the
	// expansion's turret position asked for (its "spread", which nothing
	// read); the weapon's 5 degrees is the spread of a gun at its limit.
	// About five seconds of fire overheats it; a pause of 0.35 s starts the
	// barrel cooling, from full in about two seconds. Overheated, it vents
	// until it is back under 40% (about two seconds) and will not fire.
	"spreadCold"			"2"
	"heatPerShot"			"1.2"
	"heatTolerance"			"100"
	"safeHeatLevel"			"40"
	"heatCoolDelay"			"0.35"
	"heatDissipationPerSecond"	"45"
	"overheatDissipationPerSecond"	"30"
	"heatWarnLevel"			"0.75"
	"snd_overheat"			"space_cannon_overheat"
	"snd_overheatFire"		"space_cannon_overheatfire"
	"snd_overheatRecover"	"space_cannon_recover"
	"fx_overheat"			"effects/openq4/awakening/turret_overheat.fx"

	"def_hitscan"			"hitscan_awakening_turret_chaingun"
	"fx_muzzleflash"		"effects/openq4/awakening/turret_muzzleflash.fx"

	// muzzle flash light: lights the turret's own armour and the area in front
	"flashColor"			"1 0.58 0.28"
	"flashRadius"			"240"
	"flashTime"				"0.05"
	"flashOffset"			"6 0 0"

	// casings leave the port on the gun's right flank, opposite the drum
	"def_ejectBrass"		"debris_brass_awakening_turret"
	"joint_view_eject"		"muzzle"
	"ejectOffset"			"-35 -4 -1.8"

	// smoke from the muzzle once a burst of a second or more ends
	"fx_burstSmoke"			"effects/openq4/awakening/turret_burstsmoke.fx"
	"burstSmokeShots"		"16"
}

entityDef hitscan_awakening_turret_chaingun
{
	"inherit"				"hitscan_bullet"

	// the walker's and GEV's heavier impacts, as a mounted gun's rounds
	"fx_impact"				"effects/vehicles/walker/machinegun/impact_default.fx"
	"fx_impact_concrete"	"effects/vehicles/walker/machinegun/impact_concrete.fx"
	"fx_impact_rock"		"effects/vehicles/walker/machinegun/impact_rock.fx"
	"fx_impact_electronics"	"effects/vehicles/walker/machinegun/impact_electronics.fx"
	"fx_impact_flesh"		"effects/vehicles/walker/machinegun/impact_flesh.fx"
	"fx_impact_glass"		"effects/vehicles/walker/machinegun/impact_glass.fx"
	"fx_impact_monstermetal"	"effects/vehicles/walker/machinegun/impact_monstermetal.fx"

	"fx_tracer"				"effects/openq4/awakening/turret_tracer.fx"
	"tracerchance"			"0.6"

	"def_damage"			"damage_awakening_turret_chaingun"
}

// The expansion's turret file sets the turret's 40 damage a round by
// redefining damage_machinegun, which every hitscan_bullet weapon shares:
// read first, it replaced retail's for the player's machinegun too, which
// then hit for 40 (more than its zoomed 20), lost its bleeding, flesh sounds,
// knockback and view kick (damage_bullet), and its zoom did half the damage.
// The turret keeps its 40 here; the player's machinegun gets retail's back.
entityDef damage_awakening_turret_chaingun
{
	"inherit"				"damage_bullet"
	"damage"				"40"

	"deathPush"				"100"
	"deathPushMin"			"3000 350"
	"deathPushMax"			"5000 500"
}

entityDef damage_machinegun_q4x_openq4
{
	"inherit"				"damage_bullet"
	"damage"				"15"

	"deathPush"				"100"
	"deathPushMin"			"3000 350"
	"deathPushMax"			"5000 500"
}

entityDef damage_machinegun_flesh_q4x_openq4
{
	"inherit"				"damage_machinegun_q4x_openq4"
	"damage"				"18"
}

entityDef damage_machinegun_zoom_q4x_openq4
{
	"inherit"				"damage_machinegun_q4x_openq4"
	"damage"				"20"
}

entityDef damage_machinegun_zoom_flesh_q4x_openq4
{
	"inherit"				"damage_machinegun_q4x_openq4"
	"damage"				"24"
}

entityDef debris_brass_awakening_turret
{
	"spawnclass"			"rvClientMoveable"
	"model"					"models/weapons/machinegun/brass.lwo"
	"clipmodel"				"simpletri"
	"scale"					"1"

	// one casing every other round; joint frame: x along the barrel, y to the gun's left
	"delay"					"0.11"
	"linear_velocity"		"-25 -120 80"
	"linear_velocity_range"	"0.25 0.2 0.3"
	"angular_velocity"		"0 6000 1500"
	"angular_velocity_range"	"0 0.6 1"

	"density"				"0.02"
	"linear_friction"		"0.4"
	"angular_friction"		"0.1"
	"friction"				"0.2"
	"bouncyness"			"0.15"
	"snd_bounce"			"brass_casing"
	"bounce_sound_once"		"1"
}
