// The system check for the stock interface (docs/dev/ui/performance-presets.md
// "System check"): shown before the main menu when the performance presets have
// changed since this configuration last checked them. The retained interface
// shows its own document instead. The session publishes every value
// below already localized (src/framework/Session_presetcheck.cpp) and takes
// the answers presetCheckApply, presetCheckKeep and presetCheckLater.
windowDef Desktop
{
	rect		0,0,640,480
	menugui		1
	noclip		1
	backcolor	0,0,0,1

	onActivate {
		resetTime "pc_intro" "0" ;
	}

	// Back asks again at the next start; it changes no setting.
	onESC {
		if ( "gui::check_busy" == 0 ) {
			set "cmd" "play main_menu_selection ; presetCheckLater" ;
		}
	}

	windowDef pc_backdrop
	{
		rect		( 0 - "gui::virtual_screen_x_expand" ),( 0 - "gui::virtual_screen_y_expand" ),( 640 + ( "gui::virtual_screen_x_expand" * 2 ) ),( 480 + ( "gui::virtual_screen_y_expand" * 2 ) )
		backcolor	0,0,0,1
		noevents	1
	}

	windowDef pc_screen_tint
	{
		rect		( 0 - "gui::virtual_screen_x_expand" ),( 0 - "gui::virtual_screen_y_expand" ),( 640 + ( "gui::virtual_screen_x_expand" * 2 ) ),( 480 + ( "gui::virtual_screen_y_expand" * 2 ) )
		background	"gfx/guis/mainmenu/screen"
		matcolor	0.5,0.5,0.5,1
		noclip		1
		noevents	1
	}

	windowDef pc_grid
