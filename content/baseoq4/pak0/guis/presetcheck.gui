		windowDef pc_b_apply
		{
			rect		124,335,190,23
			visible		( "gui::check_busy" == 0 )

			onMouseEnter {
				stoptransitions "pc_b_apply" ;
				set "pc_apply::matcolor_w" "0.8" ;
				transition "pc_apply_text::forecolor" "1,1,1,0.8" "0.890,0.537,0,1" "0" ;
				transition "pc_apply_corner::matcolor" "0.564,0.603,0.286,0.4" "0.890,0.537,0,1" "0" ;
				set "pc_apply_text::textscale" "0.27" ;
				set "cmd" "play main_menu_mouseover" ;
			}

			onMouseExit {
				transition "pc_apply::matcolor_w" "0.8" "0.4" "300" ;
				transition "pc_apply_text::forecolor" "0.890,0.537,0,1" "1,1,1,0.8" "300" ;
				transition "pc_apply_corner::matcolor" "0.890,0.537,0,1" "0.564,0.603,0.286,0.4" "300" ;
				transition "pc_apply_text::textscale" "0.27" "0.26" "300" ;
			}

			onAction {
				set "cmd" "play main_menu_selection ; presetCheckApply" ;
			}
		}
