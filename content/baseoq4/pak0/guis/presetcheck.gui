		windowDef pc_keep_text
		{
			rect		342,335,176,17
			visible		( "gui::check_busy" == 0 )
			forecolor	1,1,1,0.8
			text		"#str_232012"
			textscale	0.26
			nowrap		1
			font		"fonts/marine"
			noevents	1
		}
		windowDef pc_b_keep
		{
			rect		324,335,190,23
			visible		( "gui::check_busy" == 0 )

			onMouseEnter {
				stoptransitions "pc_b_keep" ;
				set "pc_keep::matcolor_w" "0.8" ;
				transition "pc_keep_text::forecolor" "1,1,1,0.8" "0.890,0.537,0,1" "0" ;
				transition "pc_keep_corner::matcolor" "0.564,0.603,0.286,0.4" "0.890,0.537,0,1" "0" ;
				set "pc_keep_text::textscale" "0.27" ;
				set "cmd" "play main_menu_mouseover" ;
			}

			onMouseExit {
				transition "pc_keep::matcolor_w" "0.8" "0.4" "300" ;
				transition "pc_keep_text::forecolor" "0.890,0.537,0,1" "1,1,1,0.8" "300" ;
				transition "pc_keep_corner::matcolor" "0.890,0.537,0,1" "0.564,0.603,0.286,0.4" "300" ;
				transition "pc_keep_text::textscale" "0.27" "0.26" "300" ;
			}

			onAction {
				set "cmd" "play main_menu_selection ; presetCheckKeep" ;
			}
		}
		// presetCheckLater: the quiet choice under the two.
		windowDef pc_later_text
		{
			rect		170,372,300,14
			visible		( "gui::check_busy" == 0 )
			forecolor	1,1,1,0.5
			text		"#str_232013"
			textscale	0.22
			textalign	1
			font		"fonts/marine"
			noevents	1
		}
		windowDef pc_b_later
		{
			rect		230,370,180,18
			visible		( "gui::check_busy" == 0 )

			onMouseEnter {
				transition "pc_later_text::forecolor" "1,1,1,0.5" "0.890,0.537,0,1" "0" ;
				set "cmd" "play main_menu_mouseover" ;
			}

			onMouseExit {
				transition "pc_later_text::forecolor" "0.890,0.537,0,1" "1,1,1,0.5" "300" ;
			}

			onAction {
				set "cmd" "play main_menu_selection ; presetCheckLater" ;
			}
		}
	}

	// The stock pop-up's entrance: the art over 200 ms, then its contents.
	windowDef pc_intro
	{
		rect		0,0,1,1
		notime		1

		onTime 0 {
			set "pc_content::visible" "0" ;
			transition "pc_glow::matcolor" "0,0,0,1" "1,1,1,1" "200" ;
			transition "pc_top::matcolor_w" "0" "0.7" "200" ;
			transition "pc_mid::matcolor_w" "0" "0.7" "200" ;
			transition "pc_btm::matcolor_w" "0" "0.7" "200" ;
		}

		onTime 200 {
			set "pc_content::visible" "1" ;
		}
	}
}
