// The stock campaign pages, the retained Campaign sub-page and campaign page
// where ui_retained is off (docs/user/campaigns.md). The Single Player page
// (arena_menu.gui) opens CAMPAIGN (campaign_view 0), which lists the story
// campaigns; a campaign opens its own page (campaign_view 1): its difficulty,
// turbo option, START GAME and CHAPTERS, every level of the campaign with the
// ones not reached yet locked. The session publishes the state and runs the
// commands (Session_menu.cpp, Session_HandleCampaignPageRequest); the pages
// stand in the stock page frame, as the retained ones do (docked bands, the
// path over the title, stock plates, BACK in the bottom band), and keep the
// Single Player hierarchy's black-frame hand-offs.
windowDef Desktop
{
	rect		0,0,640,480
	menugui		1
	noclip		1
	float		"cm_animating"	0
	float		"cm_action"	0
	float		"cm_dir"	1
	float		"cm_chapters"	0
	float		"cm_focus"	-1
	float		"cm_subject"	0

	// Every arrival reveals the page from the side it was reached from:
	// deeper from the trailing edge, back from the leading one.
	onActivate {
		stopTransitions "cm_reveal_timeline" ;
		stopTransitions "cm_exit_timeline" ;
		set "Desktop::cm_animating" "1" ;
		set "Desktop::cm_action" "0" ;
		set "Desktop::cm_subject" "0" ;
		set "Desktop::cm_chapters" "0" ;
		set "Desktop::cm_focus" "-1" ;
		setfocus "cm_blocker" ;
		resetTime "cm_reveal_timeline" "0" ;
	}

	// Leaving: 1 Quake 4, 2 The Awakening (deeper), 3 back to Single Player,
	// 4 back to CAMPAIGN. The command goes once the black frame is up.
	onNamedEvent cmEnterQuake4 {
		if ( "Desktop::cm_animating" == 0 ) {
			set "Desktop::cm_action" "1" ;
			namedevent "cmLeave" ;
		}
	}

	onNamedEvent cmEnterAwakening {
		if ( "Desktop::cm_animating" == 0 && "gui::awakening_ready" == 1 ) {
			set "Desktop::cm_action" "2" ;
			namedevent "cmLeave" ;
		}
	}

	onNamedEvent cmLeaveHome {
		if ( "Desktop::cm_animating" == 0 ) {
			set "Desktop::cm_action" "3" ;
			namedevent "cmLeave" ;
		}
	}

	onNamedEvent cmLeaveBack {
		if ( "Desktop::cm_animating" == 0 ) {
			set "Desktop::cm_action" "4" ;
			namedevent "cmLeave" ;
		}
	}

	onNamedEvent cmLeave {
		set "Desktop::cm_animating" "1" ;
		set "Desktop::cm_focus" "-1" ;
		setfocus "cm_blocker" ;
		resetTime "cm_exit_timeline" "0" ;
	}

	// The campaign page's chapters take the difficulty's place; BACK and
	// Escape bring the difficulty back.
	onNamedEvent cmOpenChapters {
		if ( "Desktop::cm_animating" == 0 ) {
			set "Desktop::cm_chapters" "1" ;
			set "Desktop::cm_focus" "-1" ;
			transition "cm_chapter_view::rect" "24,0,640,480" "0,0,640,480" "200" ;
		}
	}

	onNamedEvent cmCloseChapters {
		if ( "Desktop::cm_animating" == 0 ) {
			set "Desktop::cm_chapters" "0" ;
			set "Desktop::cm_focus" "-1" ;
			transition "cm_skill_view::rect" "-24,0,640,480" "0,0,640,480" "200" ;
		}
	}

	// The focus follows the visible context, chosen once it changes: the
	// campaign being played, the chosen difficulty, or the chapter list.
	onEvent {
		if ( "Desktop::cm_animating" == 1 ) {
			if ( "Desktop::cm_focus" != 9 ) {
				setfocus "cm_blocker" ;
				set "Desktop::cm_focus" "9" ;
			}
		} else if ( "gui::campaign_view" == 0 ) {
			if ( "Desktop::cm_focus" != 0 ) {
				if ( "gui::awakening_chosen" == 1 && "gui::awakening_ready" == 1 ) {
					setfocus "cm_awakening_card" ;
				} else {
					setfocus "cm_quake4_card" ;
				}
				set "Desktop::cm_focus" "0" ;
			}
		} else if ( "Desktop::cm_chapters" == 1 ) {
			if ( "Desktop::cm_focus" != 2 ) {
				setfocus "cm_chapter_list" ;
				set "Desktop::cm_focus" "2" ;
			}
		} else if ( "Desktop::cm_focus" != 1 ) {
			if ( "gui::skill" == 0 ) {
				setfocus "cm_skill0" ;
			} else if ( "gui::skill" == 2 ) {
				setfocus "cm_skill2" ;
			} else if ( "gui::skill" == 3 ) {
				setfocus "cm_skill3" ;
			} else if ( "gui::skill" == 4 ) {
				setfocus "cm_skill4" ;
			} else {
				setfocus "cm_skill1" ;
			}
			set "Desktop::cm_focus" "1" ;
		}
	}

	onESC {
		if ( "Desktop::cm_animating" == 1 ) {
			set "Desktop::cm_focus" "9" ;
		} else if ( "gui::campaign_view" == 1 && "Desktop::cm_chapters" == 1 ) {
			set "cmd" "play main_menu_selection" ;
			namedevent "cmCloseChapters" ;
		} else if ( "gui::campaign_view" == 1 ) {
			set "cmd" "play main_menu_selection" ;
			namedevent "cmLeaveBack" ;
		} else {
			set "cmd" "play main_menu_selection" ;
			namedevent "cmLeaveHome" ;
		}
	}

	windowDef cm_backdrop
	{
		rect		( 0 - "gui::virtual_screen_x_expand" ),( 0 - "gui::virtual_screen_y_expand" ),( 640 + ( "gui::virtual_screen_x_expand" * 2 ) ),( 480 + ( "gui::virtual_screen_y_expand" * 2 ) )
		backcolor	0,0,0,1
		noevents	1
