	windowDef cm_curtain
	{
		rect		( 0 - "gui::virtual_screen_x_expand" ),( 0 - "gui::virtual_screen_y_expand" ),( 640 + ( "gui::virtual_screen_x_expand" * 2 ) ),( 480 + ( "gui::virtual_screen_y_expand" * 2 ) )
		visible		( "Desktop::cm_animating" == 1 )
		backcolor	0,0,0,0
		noevents	1
	}

	windowDef cm_reveal_timeline
	{
		rect		0,0,1,1
		visible		1
		notime		1
		onTime 0 {
			stopTransitions "cm_reveal_timeline" ;
			set "cm_curtain::backcolor" "0,0,0,0.86" ;
			if ( "Desktop::cm_dir" < 0 ) {
				set "cm_content::rect" "-36,0,640,480" ;
				transition "cm_content::rect" "-36,0,640,480" "0,0,640,480" "320" ;
			} else {
				set "cm_content::rect" "36,0,640,480" ;
				transition "cm_content::rect" "36,0,640,480" "0,0,640,480" "320" ;
			}
			transition "cm_curtain::backcolor" "0,0,0,0.86" "0,0,0,0" "360" ;
		}

		onTime 380 {
			set "Desktop::cm_animating" "0" ;
			set "Desktop::cm_dir" "1" ;
			set "Desktop::cm_focus" "-1" ;
		}
	}

	windowDef cm_exit_timeline
	{
		rect		0,0,1,1
		visible		1
		notime		1
		onTime 0 {
			stopTransitions "cm_exit_timeline" ;
			set "cm_curtain::backcolor" "0,0,0,0" ;
			transition "cm_curtain::backcolor" "0,0,0,0" "0,0,0,1" "260" ;
			if ( "Desktop::cm_action" <= 2 ) {
				transition "cm_content::rect" "0,0,640,480" "-36,0,640,480" "240" ;
			} else {
				transition "cm_content::rect" "0,0,640,480" "36,0,640,480" "240" ;
			}
		}

		onTime 280 {
			if ( "Desktop::cm_action" == 1 ) {
				set "cmd" "campaignQuake4" ;
			} else if ( "Desktop::cm_action" == 2 ) {
				set "cmd" "campaignAwakening" ;
			} else if ( "Desktop::cm_action" == 3 ) {
				set "cmd" "campaignBack" ;
			} else {
				set "Desktop::cm_dir" "-1" ;
				set "cmd" "campaignSkillBack" ;
			}
		}
	}

	windowDef cm_blocker
	{
		rect		( 0 - "gui::virtual_screen_x_expand" ),( 0 - "gui::virtual_screen_y_expand" ),( 640 + ( "gui::virtual_screen_x_expand" * 2 ) ),( 480 + ( "gui::virtual_screen_y_expand" * 2 ) )
		visible		( "Desktop::cm_animating" == 1 )
		backcolor	0,0,0,0
		onAction {
			set "Desktop::cm_focus" "9" ;
			set "cmd" "campaignBlockInput" ;
		}

		onESC {
			set "Desktop::cm_focus" "9" ;
		}
	}
}
