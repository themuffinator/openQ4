			onNamedEvent crosshairSize {
				if ( "gui::cvar_g_crosshairSize" == 16 ) {
					set "set_game_previewxhair_size_16::visible" "1" ;
					set "set_game_previewxhair_size_24::visible" "0" ;
					set "set_game_previewxhair_size_32::visible" "0" ;
					set "set_game_previewxhair_size_40::visible" "0" ;
					set "set_game_previewxhair_size_48::visible" "0" ;
				} else if ( "gui::cvar_g_crosshairSize" == 24 ) {
					set "set_game_previewxhair_size_16::visible" "0" ;
