					transition "screen10_bar1::rect" "$screen10_bar1::rect" "$d_screen10_bar1::rect" "300" "100" "150" ;
					transition "screen10_bar1::matcolor" "$desktop::cr_orange" "0,0,0,0" "1000" ;
					
