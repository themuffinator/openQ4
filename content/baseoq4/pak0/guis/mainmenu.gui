					transition "screen10_ts_2::forecolor" "$desktop::cr_orange_0" "$desktop::cr_orange" "2000" ;
					
					transition "screen10_ns_1::forecolor" "$desktop::cr_green_0" "$desktop::cr_green" "2000" ;
