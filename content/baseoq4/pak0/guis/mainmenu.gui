					transition "mp_browse_lan::forecolor"  "$desktop::orange" "$desktop::white_8" "300" ; 
					transition "mp_browse_lan::textscale" "0.23" "0.22" "300" ;
				}
			}

			onAction {
				set "gui::lanSet" "1" ;
				
				set "mp_b_browse_src_internet::visible" "1" ;
				set "mp_b_browse_src_lan::visible" "0" ;
				
				set "mp_browse_internet_boxcheck::matcolor_w" "0" ;
				set "mp_browse_lan_boxcheck::matcolor_w" "1" ;
				
				set "mp_browse_internet::forecolor" "$desktop::white_8"; 
				set "mp_browse_internet::textscale" "0.22" ;
				
				namedevent "p_anims::hideMpBrowseSort" ;
				set "desktop::sort" "0" ;
				
				set "cmd" "play main_menu_selection updateServers" ;
			}

		}
