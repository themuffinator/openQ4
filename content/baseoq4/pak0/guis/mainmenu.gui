		windowDef anim_pop_createAdvIn
		{
			rect	0,0,1,1
			visible	1
			notime	1

			onTime 0 {
				set "pop_p_createAdv::visible" "1" ;
				namedevent "p_btns::hideMpCreate" ;
				transition "pop_createAdv_black::backcolor_w" "0" "0.94" "200" ;
				transition "pop_createAdv_bg::matcolor" "0,0,0,1" "1,1,1,1" "200" ;
				transition "pop_createAdv_top::matcolor_w" "0" "0.7" "200" ;
				transition "pop_createAdv_mid::matcolor_w" "0" "0.7" "200" ;
				transition "pop_createAdv_btm::matcolor_w" "0" "0.7" "200" ;
				
				// back button
				transition "pop_createAdv_close::matcolor_w" "0" "0.4" "150" ;
				transition "pop_createAdv_t_close::forecolor_w"  "0" "0.8" "150" ; 
				transition "pop_createAdv_close_corner::matcolor_w"  "0" "0.4" "150" ; 
