				transition "bg_temp3::matcolor_w" "0" "1" "2000" ;
				set "bg_temp3::rect" "$bg_rect_center_glitch::rect" ;
				set "glitch_static::matcolor_w" "0.24" ;
				set "glitch_scan::matcolor_w" "0.14" ;
				set "glitch_band_top::matcolor_w" "0.20" ;
				set "glitch_band_mid::matcolor_w" "0.16" ;
				transition "glitch_static::matcolor_w" "0.24" "0" "260" ;
				transition "glitch_scan::matcolor_w" "0.14" "0" "220" ;
				transition "glitch_band_top::matcolor_w" "0.20" "0" "200" ;
				transition "glitch_band_mid::matcolor_w" "0.16" "0" "240" ;
				transition "bg_temp3::rect" "$bg_rect_center_glitch::rect" "$bg_rect_center_zoom::rect" "6800" ;
			}

			onTime 15000 {
				transition "bg_temp3::matcolor_w" "1" "0" "2000" ;
				transition "bg_temp4::matcolor_w" "0" "1" "2000" ;
				set "bg_temp4::rect" "$bg_rect_center_glitch::rect" ;
				set "glitch_static::matcolor_w" "0.24" ;
				set "glitch_scan::matcolor_w" "0.14" ;
				set "glitch_band_top::matcolor_w" "0.20" ;
				set "glitch_band_mid::matcolor_w" "0.16" ;
				transition "glitch_static::matcolor_w" "0.24" "0" "260" ;
				transition "glitch_scan::matcolor_w" "0.14" "0" "220" ;
				transition "glitch_band_top::matcolor_w" "0.20" "0" "200" ;
				transition "glitch_band_mid::matcolor_w" "0.16" "0" "240" ;
				transition "bg_temp4::rect" "$bg_rect_center_glitch::rect" "$bg_rect_center_zoom::rect" "6800" ;
			}

			onTime 20000 {
				transition "bg_temp4::matcolor_w" "1" "0" "2000" ;
				transition "bg_temp5::matcolor_w" "0" "1" "2000" ;
				set "bg_temp5::rect" "$bg_rect_center_glitch::rect" ;
				set "glitch_static::matcolor_w" "0.24" ;
				set "glitch_scan::matcolor_w" "0.14" ;
				set "glitch_band_top::matcolor_w" "0.20" ;
				set "glitch_band_mid::matcolor_w" "0.16" ;
				transition "glitch_static::matcolor_w" "0.24" "0" "260" ;
				transition "glitch_scan::matcolor_w" "0.14" "0" "220" ;
				transition "glitch_band_top::matcolor_w" "0.20" "0" "200" ;
				transition "glitch_band_mid::matcolor_w" "0.16" "0" "240" ;
				transition "bg_temp5::rect" "$bg_rect_center_glitch::rect" "$bg_rect_center_zoom::rect" "6800" ;
			}

			onTime 25000 {
				set "bg_temp::matcolor_w" "0" ;
				transition "bg_temp5::matcolor_w" "1" "0" "2000" ;
				transition "bg_temp::matcolor_w" "0" "1" "2000" ;
				set "bg_temp::rect" "$bg_rect_center_glitch::rect" ;
				set "glitch_static::matcolor_w" "0.24" ;
				set "glitch_scan::matcolor_w" "0.14" ;
				set "glitch_band_top::matcolor_w" "0.20" ;
				set "glitch_band_mid::matcolor_w" "0.16" ;
				transition "glitch_static::matcolor_w" "0.24" "0" "260" ;
				transition "glitch_scan::matcolor_w" "0.14" "0" "220" ;
				transition "glitch_band_top::matcolor_w" "0.20" "0" "200" ;
				transition "glitch_band_mid::matcolor_w" "0.16" "0" "240" ;
				transition "bg_temp::rect" "$bg_rect_center_glitch::rect" "$bg_rect_center_zoom::rect" "6800" ;
				resettime "0" ;
			}

		}
		windowDef anim_mainIn
		{
			rect	0,0,1,1
			visible	1
			notime	1

			onTime 0 {
				set "p_main::visible" "1" ;
				
				transition "q4logo::matcolor" "$desktop::black" "$desktop::white" "150" ;
				transition "q4text::matcolor" "$desktop::black" "$desktop::white" "150" ;	
				
				transition "main_b1::matcolor_w" "0" "0.4" "150" ;
				transition "main_t_b1::forecolor_w"  "0" "0.8" "150" ; 
				transition "main_b1_corner::matcolor_w"  "0" "0.4" "150" ;
				transition "main_b2::matcolor_w" "0" "0.4" "150" ;
				transition "main_t_b2::forecolor_w"  "0" "0.8" "150" ; 
				transition "main_b2_corner::matcolor_w"  "0" "0.4" "150" ;
				transition "main_b3::matcolor_w" "0" "0.4" "150" ;
				transition "main_t_b3::forecolor_w"  "0" "0.8" "150" ; 
				transition "main_b3_corner::matcolor_w"  "0" "0.4" "150" ;
				transition "main_b4::matcolor_w" "0" "0.4" "150" ;
				transition "main_t_b4::forecolor_w"  "0" "0.8" "150" ; 
				transition "main_b4_corner::matcolor_w"  "0" "0.4" "150" ;
				transition "main_t_b8::forecolor_w"  "0" "0.5" "150" ; 
				transition "main_b8_corner::matcolor_w"  "0" "0.4" "150" ; 
				
				transition "main_motd::forecolor_w"  "0" "0.8" "150" ; 
				
				transition "bg2::matcolor_w"  "0" "0.3" "150" ; 
				
				
				
				if ("gui::ingame" == 1) {	
					//transition "main_b3::matcolor_w" "0" "0.4" "150" ;
					//transition "main_t_b3::forecolor_w"  "0" "0.8" "150" ; 
					//transition "main_b3_corner::matcolor_w"  "0" "0.4" "150" ;
					transition "main_b9::matcolor_w" "0" "0.4" "150" ;
					transition "main_t_b9::forecolor_w"  "0" "0.8" "150" ; 
					transition "main_b9_corner::matcolor_w"  "0" "0.4" "150" ;
					
					set "main_t_b1::text" "#str_200003" ;
					set "main_t_b2::text" "#str_200001" ;
					set "main_t_b3::text" "#str_200004" ;	
					set "main_t_b9::text" "#str_200005" ;
					
				} else	if ("gui::ingame" == 2) {
					
					transition "main_t_b5::forecolor_w"  "0" "0.5" "150" ; 
					transition "main_b5_corner::matcolor_w"  "0" "0.4" "150" ; 
					transition "main_t_b6::forecolor_w"  "0" "0.5" "150" ; 
					transition "main_b6_corner::matcolor_w"  "0" "0.4" "150" ; 
					transition "main_t_b7::forecolor_w"  "0" "0.5" "150" ; 
					transition "main_b7_corner::matcolor_w"  "0" "0.4" "150" ;
					
					
					//set "main_t_b5::text" "#str_200005" ;
					//set "main_t_b6::text" "#str_200006" ;
					
				} else	if ("gui::ingame" == 0) {	
					//transition "main_b3::matcolor_w" "0" "0.4" "150" ;
					//transition "main_t_b3::forecolor_w"  "0" "0.8" "150" ; 
					//transition "main_b3_corner::matcolor_w"  "0" "0.4" "150" ;
					transition "main_t_b5::forecolor_w"  "0" "0.5" "150" ; 
					transition "main_b5_corner::matcolor_w"  "0" "0.4" "150" ; 
					transition "main_t_b6::forecolor_w"  "0" "0.5" "150" ; 
					transition "main_b6_corner::matcolor_w"  "0" "0.4" "150" ; 
					transition "main_t_b7::forecolor_w"  "0" "0.5" "150" ; 
					transition "main_b7_corner::matcolor_w"  "0" "0.4" "150" ;					
					transition "main_b9::matcolor_w" "0" "0.4" "150" ;
					transition "main_t_b9::forecolor_w" "0" "0.8" "150" ;
					transition "main_b9_corner::matcolor_w" "0" "0.4" "150" ;
					
					set "main_t_b1::text" "#str_42000" ;
					set "main_t_b2::text" "#str_200001" ;
					set "main_t_b3::text" "#str_200002" ;
					set "main_t_b9::text" "#str_41500" ;
				}
			}

			onTime +200 {
				set "desktop::active" "0" ;
				namedevent "p_btns::showMain" ;
				set "desktop::curr" "0" ;
			}

		}
		windowDef anim_mainOut
		{
			rect	0,0,1,1
			visible	1
			notime	1

			onTime 0 {
				namedevent "p_btns::hideMain" ;
				
				transition "q4logo::matcolor" "$desktop::white" "$desktop::black" "250" ;
				transition "q4text::matcolor" "$desktop::white" "$desktop::black" "250" ;	
				
				stoptransitions "main_b_newgame" ;
				stoptransitions "main_b_savegame" ;
				stoptransitions "main_b_loadgame" ;
				stoptransitions "main_b_multiplayer" ;
				stoptransitions "main_b_disconnect" ;
				stoptransitions "main_b_quitcurrent" ;
				stoptransitions "main_b_settings" ;
				stoptransitions "main_b_demos" ;
				stoptransitions "main_b_mods" ;
				stoptransitions "main_b_updates" ;
				stoptransitions "main_b_credits" ;
				stoptransitions "main_b_exit" ;
				
				transition "main_b1::matcolor_w" "0.4" "0" "250" ;
				transition "main_t_b1::forecolor_w"  "0.8" "0" "250" ; 
				transition "main_b1_corner::matcolor_w"  "0.4" "0" "250" ;
				transition "main_b2::matcolor_w" "0.4" "0" "250" ;
				transition "main_t_b2::forecolor_w"  "0.8" "0" "250" ; 
				transition "main_b2_corner::matcolor_w"  "0.4" "0" "250" ;
				transition "main_b3::matcolor_w" "0.4" "0" "250" ;
				transition "main_t_b3::forecolor_w"  "0.8" "0" "250" ; 
				transition "main_b3_corner::matcolor_w"  "0.4" "0" "250" ;
				transition "main_b4::matcolor_w" "0.4" "0" "250" ;
				transition "main_t_b4::forecolor_w"  "0.8" "0" "250" ; 
				transition "main_b4_corner::matcolor_w"  "0.4" "0" "250" ;
				transition "main_t_b8::forecolor_w"  "0.5" "0" "50" ; 
				transition "main_b8_corner::matcolor_w"  "0.4" "0" "50" ;
				
				transition "main_motd::forecolor_w"  "0.8" "0" "250" ; 
				
				transition "bg2::matcolor_w"  "0.3" "0" "50" ; 
				
				if ("gui::ingame" == 1) {	
					//transition "main_b3::matcolor_w" "0.4" "0" "250" ;
					//transition "main_t_b3::forecolor_w"  "0.8" "0" "250" ; 
					//transition "main_b3_corner::matcolor_w"  "0.4" "0" "250" ;
					transition "main_b9::matcolor_w" "0.4" "0" "250" ;
					transition "main_t_b9::forecolor_w"  "0.8" "0" "250" ; 
					transition "main_b9_corner::matcolor_w"  "0.4" "0" "250" ;
				} else	if ("gui::ingame" == 2) {	
					transition "main_t_b5::forecolor_w"  "0.5" "0" "50" ; 
					transition "main_b5_corner::matcolor_w"  "0.4" "0" "50" ; 
					transition "main_t_b6::forecolor_w"  "0.5" "0" "50" ; 
					transition "main_b6_corner::matcolor_w"  "0.4" "0" "50" ; 
					transition "main_t_b7::forecolor_w"  "0.5" "0" "50" ; 
					transition "main_b7_corner::matcolor_w"  "0.4" "0" "50" ; 
				} else	if ("gui::ingame" == 0) {	
					//transition "main_b3::matcolor_w" "0.4" "0" "250" ;
					//transition "main_t_b3::forecolor_w"  "0.8" "0" "250" ; 
					//transition "main_b3_corner::matcolor_w"  "0.4" "0" "250" ;
					transition "main_t_b5::forecolor_w"  "0.5" "0" "50" ; 
					transition "main_b5_corner::matcolor_w"  "0.4" "0" "50" ; 
					transition "main_t_b6::forecolor_w"  "0.5" "0" "50" ; 
					transition "main_b6_corner::matcolor_w"  "0.4" "0" "50" ; 
					transition "main_t_b7::forecolor_w"  "0.5" "0" "50" ; 
					transition "main_b7_corner::matcolor_w"  "0.4" "0" "50" ; 
					transition "main_b9::matcolor_w" "0.4" "0" "250" ;
					transition "main_t_b9::forecolor_w" "0.8" "0" "250" ;
					transition "main_b9_corner::matcolor_w" "0.4" "0" "250" ;
				}
				
			}

			onTime +50 {
				transition "p_main::rect" "$d_main::rect" "$d_main_r::rect" "500" "150" "150" ;
				
				transition "topbar::rect"  "$topbar::rect"  "$d_topbar::rect" "500" "150" "150" ;
				transition "btmbar::rect"  "$btmbar::rect"  "$d_btmbar::rect" "500" "150" "150" ;
			}

			onTime +500 {
				set "p_main::visible" "0" ;
				
				if ("desktop::dest" == 2) {
					resettime "anim_loadIn" "0" ;
					namedevent "p_anims::backReset0" ;
				} else if ("desktop::dest" == 7) {
					resettime "anim_creditsIn" "0" ;
					namedevent "p_anims::backReset0" ;
				} else if ("desktop::dest" == 4) {
					resettime "anim_settingsIn" "0" ;
					namedevent "p_anims::backReset0" ;
				} else if ("desktop::dest" == 3) {
					resettime "anim_mpIn" "0" ;
					namedevent "p_anims::backReset0" ;
				} else if ("desktop::dest" == 2) {
					resettime "anim_loadIn" "0" ;
					namedevent "p_anims::backReset0" ;
				} else if ("desktop::dest" == 1) {
					resettime "anim_newIn" "0" ;
					namedevent "p_anims::backReset0" ;
				} else if ("desktop::dest" == 37) {
					// Let the stock main-menu exit complete before the dedicated
					// Single Player selector takes ownership of the screen.
					set "cmd" "singlePlayerOpen" ;
				} else if ("desktop::dest" == 21) {
					resettime "anim_settingsIn" "0" ;
					namedevent "p_anims::backReset0" ;
				} else if ("desktop::dest" == 22) {
					resettime "anim_settingsIn" "0" ;
					namedevent "p_anims::backReset0" ;
				} else if ("desktop::dest" == 36) {
					resettime "anim_settingsIn" "0" ;
					namedevent "p_anims::backReset0" ;
				} else if ("desktop::dest" == 23) {
					resettime "anim_saveIn" "0" ;
					namedevent "p_anims::backReset0" ;
				} else if ("desktop::dest" == 14) {
					resettime "anim_mpBrowseIn" "0" ;
					namedevent "p_anims::backReset0" ;
				}
			}

		}
		windowDef anim_newIn
		{
			rect	0,0,1,1
			visible	1
			notime	1

			onTime 0 {
				consoleCMD "g_skill 1" ;
				consoleCMD "g_turboMode 0" ;
				set "desktop::skill" "1" ;
				set "desktop::turboMode" "0" ;
				
				transition "p_newgame::rect" "$d_main_l::rect" "$d_main::rect" "0" ;
				set "p_newgame::visible" "1" ;
				transition "t_new_title::forecolor_w" "0" "0.5" "150" ;
				transition "grad2::matcolor_w" "0" "0.6" "150" ;
				
				namedevent "p_btns::skillCheck" ;
				namedevent "p_btns::turboCheck" ;
				
				
				// back button
				transition "new_back::matcolor_w" "0" "0.4" "150" ;
				transition "new_t_back::forecolor_w"  "0" "0.8" "150" ; 
				transition "new_back_corner::matcolor_w"  "0" "0.4" "150" ;
				transition "new_bturbo::matcolor_w" "0" "0.4" "150" ;
				transition "new_t_turbo::forecolor_w" "0" "0.8" "150" ;
				transition "new_t_turbo_value::forecolor_w" "0" "0.8" "150" ;
				transition "new_bturbo_corner::matcolor_w" "0" "0.4" "150" ;
			}

			onTime +150 {
				set "desktop::active" "0" ;
				namedevent "p_btns::showNew" ;
				set "desktop::curr" "1" ;
			}

		}
		windowDef anim_newOut
		{
			rect	0,0,1,1
			visible	1
			notime	1

			onTime 0 {
				namedevent "p_btns::hideNew" ;
				
				transition "p_main::rect" "$d_main_r::rect" "$d_main::rect" "0" ;
				transition "p_newgame::rect" "$d_main::rect" "$d_main_l::rect" "300" ;
				
				transition "topbar::rect"  "$d_topbar::rect"  "$topbar::rect" "500" "150" "150" ;
				transition "btmbar::rect"  "$d_btmbar::rect"  "$btmbar::rect" "500" "150" "150" ;
				
				
				// transitions
				transition "t_new_title::forecolor_w" "0.5" "0" "0" ;
				transition "grad2::matcolor_w" "0.6" "0" "250" ;
				
				
				// back button	
				transition "new_back::matcolor_w" "0.8" "0" "100" ;
				transition "new_t_back::forecolor_w"  "1" "0" "100" ; 
				transition "new_back_corner::matcolor_w"  "1" "0" "100" ; 
				transition "new_bturbo::matcolor_w" "0.8" "0" "100" ;
				transition "new_t_turbo::forecolor_w" "1" "0" "100" ;
				transition "new_t_turbo_value::forecolor_w" "1" "0" "100" ;
				transition "new_bturbo_corner::matcolor_w" "1" "0" "100" ;
			}

			onTime +500 {
				set "p_newgame::visible" "0" ;

				if ("desktop::dest" == 37) {
					// Mission is a child of the Single Player choice screen.  Reset
					// the legacy page before returning there so that reopening the
					// main menu later always starts from a valid top-level state.
					set "desktop::curr" "0" ;
					set "desktop::active" "0" ;
					set "p_main::visible" "0" ;
					namedevent "p_anims::mainReset0" ;
					set "cmd" "singlePlayerOpen" ;
				} else {
					resettime "anim_mainIn" "0" ;
					namedevent "p_anims::mainReset0" ;
				}
			}

		}
