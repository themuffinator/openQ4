			onNamedEvent corpseTime {
				if ( "gui::ingame" == 2 ) {
					if ( "gui::cvar_g_corpseRemoveDelayMP" == 0 ) {
						set "corpse_time_choice" "0" ;
					} else if ( "gui::cvar_g_corpseRemoveDelayMP" == -1 ) {
						set "corpse_time_choice" "1" ;
					} else if ( "gui::cvar_g_corpseRemoveDelayMP" == 5 ) {
						set "corpse_time_choice" "2" ;
					} else if ( "gui::cvar_g_corpseRemoveDelayMP" == 10 ) {
						set "corpse_time_choice" "3" ;
					} else if ( "gui::cvar_g_corpseRemoveDelayMP" == 15 ) {
						set "corpse_time_choice" "4" ;
					} else if ( "gui::cvar_g_corpseRemoveDelayMP" == 30 ) {
						set "corpse_time_choice" "5" ;
					} else if ( "gui::cvar_g_corpseRemoveDelayMP" == 60 ) {
						set "corpse_time_choice" "6" ;
					} else {
						set "corpse_time_choice" "7" ;
					}
				} else {
					if ( "gui::cvar_g_corpseRemoveDelaySP" == 0 ) {
						set "corpse_time_choice" "0" ;
					} else if ( "gui::cvar_g_corpseRemoveDelaySP" == -1 ) {
						set "corpse_time_choice" "1" ;
					} else if ( "gui::cvar_g_corpseRemoveDelaySP" == 5 ) {
						set "corpse_time_choice" "2" ;
					} else if ( "gui::cvar_g_corpseRemoveDelaySP" == 10 ) {
						set "corpse_time_choice" "3" ;
					} else if ( "gui::cvar_g_corpseRemoveDelaySP" == 15 ) {
						set "corpse_time_choice" "4" ;
					} else if ( "gui::cvar_g_corpseRemoveDelaySP" == 30 ) {
						set "corpse_time_choice" "5" ;
					} else if ( "gui::cvar_g_corpseRemoveDelaySP" == 60 ) {
						set "corpse_time_choice" "6" ;
					} else {
						set "corpse_time_choice" "7" ;
					}
				}
			}

