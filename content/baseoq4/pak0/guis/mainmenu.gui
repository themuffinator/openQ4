			windowDef p_screen10
			{
				rect	0,0,640,480
				visible	0
				notime	1

				onTime 0 {
					set "rect" "0,0,640,480" ;
					set "visible" "1" ;
					
					set "screen10_bar1::matcolor" "$desktop::cr_orange" ;
					set "screen10_bar2::matcolor" "$desktop::cr_orange" ;
					set "screen10_bar1::rect" "-370,150,370,23" ;
					set "screen10_bar2::rect" "-478,254,478,23" ;
					
