				resettime "anim_mainIn" "0" ;
				namedevent "p_anims::mainReset0" ;
			}

		}
		windowDef anim_credits
		{
			rect	0,0,1,1
			visible	1
			notime	1

			onTime 0 {
				transition "raven::matcolor" "0,0,0,1" "0.839,1,0.658,1" "1000" ;
			}

			onTime +3000 {
				transition "raven::matcolor" "0.839,1,0.658,1" "0,0,0,1" "1000" ;
