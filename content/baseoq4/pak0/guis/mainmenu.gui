					transition "pop_createAdv_banlist_1_corner::matcolor"  "$desktop::orange" "$desktop::corner" "300" ; 
					
					transition "pop_createAdv_banlist_t_1::textscale" "0.29" "0.28" "300" ;
				}
			}

			onAction {
				set "cmd" "handleServerAdminRemoveBan" ;
				set "cmd" "play main_menu_selection" ;
			}

		}
