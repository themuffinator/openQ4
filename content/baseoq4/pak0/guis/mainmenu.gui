				transition "credits_t_back::forecolor_w"  "0" "0.8" "150" ; 
				transition "credits_back_corner::matcolor_w"  "0" "0.4" "150" ;
			}

			onTime +150 {
				set "desktop::active" "0" ;
				set "credits_b_back::visible" "1" ;
				set "desktop::curr" "7" ;
				
				if ("desktop::credits" == 0) {
					resettime "anim_credits" "0" ;
					set "desktop::credits" "1" ;
				}
			}

		}
