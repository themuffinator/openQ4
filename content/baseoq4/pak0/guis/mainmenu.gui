		onNamedEvent showMain {
			if ("gui::ingame" == 0) {
				set "main_b_returnmp::visible" "0" ;		
				set "main_b_newgame::visible" "1" ;
				set "main_b_savegame::visible" "0" ;
				set "main_b_quitcurrent::visible" "0" ;
