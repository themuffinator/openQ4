	// openQ4: the Remastered pickup lines (14.8), each centred at 401 u while
	// it is the newest and 377 u above it once a newer one arrives, on the
	// stock rounded plate fitted to its line (at least 96 u): the icon 6 u in,
	// the name 25 u in and 7 u clear of the plate's end. Each holds 3000 ms
	// and fades over 250 ms.
	windowDef p_pickup0
	{
		rect	0,377 + 24 * ("gui::oq4_pick_newest" == 0),640,24
		screenalignx	middle
		screenaligny	bottom
		visible	0
		notime	1
		definefloat	"plate"	("gui::oq4_pick0_width" > 64) ? ("gui::oq4_pick0_width" + 32) : 96

		onTime 3000 {
			transition "pickup0_plate::matcolor" "0,0,0,0.5" "0,0,0,0" "250" ;
			transition "pickup0_icon::matcolor" "0.666,0.674,0.435,0.8" "0.666,0.674,0.435,0" "250" ;
			transition "pickup0_text::forecolor" "0.862,0.917,0.760,1" "0.862,0.917,0.760,0" "250" ;
		}

		onTime 3250 {
			set "visible" "0" ;
		}

		windowDef pickup0_plate
		{
			rect	320 - "p_pickup0::plate" / 2,1.5,"p_pickup0::plate",21
			background	"gfx/guis/hud/pickupbar"
			matcolor	0,0,0,0.5
			shear	0,-.22
		}
		windowDef pickup0_icon
		{
			rect	327.7 - "p_pickup0::plate" / 2,4,16,16
			background	"gui::oq4_pick0_icon"
			matcolor	0.666,0.674,0.435,0.8
		}
		windowDef pickup0_text
		{
			rect	344.5 - "p_pickup0::plate" / 2,2.2,"p_pickup0::plate",15
			forecolor	0.862,0.917,0.760,1
			text	"gui::oq4_pick0_text"
			textscale	0.19
			font	"fonts/marine"
			textspacing	0
			nowrap	1
		}
	}
