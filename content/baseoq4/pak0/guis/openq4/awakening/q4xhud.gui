//-----------------------		
// hit indicator
//-----------------------	

	// openQ4: the damage direction setting and Minimal hide the hit indicator.
	windowDef p_hit_layout
	{
		rect	0,0,640,480
		noclip	1
		visible	"gui::oq4_hudShowDamage"
		windowDef hit_indicator
		{
			rect		0,0,640,480
			hudanchorx	middle
			hudanchory	middle
			background	"gfx/guis/hud/directional_hit"
			matcolor	1,.1,.1,.7
			rotate		"gui::hitdir"
			visible		0
			notime		1
		
			onTime 0 
			{
				set "visible" "1";
				set "matcolor" "1,.1,.1,.7";
				transition "matcolor" "1,.1,.1,.7" "1,.1,.1,0" "500" ;
			}
		
			onTime +600
			{
				set "visible" "0";
			}
			// openQ4: a mark at the dome's peak, so the direction never depends on color (14.7).
			windowDef hit_chevron
			{
				rect	308,42.67,24,10.67
				background	"gfx/guis/maps/process2/nodecontroller_lil_triangle2"
				matcolor	1,0.1,0.1,1.2857 * "hit_indicator::matcolor_w"
				matscaley	-1
				visible	"gui::oq4_hudRemastered"
			}
		}

		windowDef hit_indicator_reduced
		{
			rect		0,0,640,480
			hudanchorx	middle
			hudanchory	middle
			background	"gfx/guis/hud/directional_hit"
			matcolor	1,.1,.1,.4
			rotate		"gui::hitdir"
			visible		0
			notime		1

			onTime 0
			{
				set "visible" "1";
				set "matcolor" "1,.1,.1,.4";
				transition "matcolor" "1,.1,.1,.4" "1,.1,.1,0" "500" ;
			}

			onTime +600
			{
				set "visible" "0";
			}
			// openQ4: a mark at the dome's peak, so the direction never depends on color (14.7).
			windowDef hit_chevron_reduced
			{
				rect	308,42.67,24,10.67
				background	"gfx/guis/maps/process2/nodecontroller_lil_triangle2"
				matcolor	1,0.1,0.1,1.2857 * "hit_indicator_reduced::matcolor_w"
				matscaley	-1
				visible	"gui::oq4_hudRemastered"
			}
		}
	}

//-----------------------		
// over top black/failed text
//-----------------------	
	
		// openQ4: the fade covers the whole view, not the 4:3 canvas alone (a wide
		// screen kept lit strips beside a failed mission's black).
		windowDef fade
		{
			rect	0 - "gui::virtual_screen_x_expand",0 - "gui::virtual_screen_y_expand",640 + 2 * "gui::virtual_screen_x_expand",480 + 2 * "gui::virtual_screen_y_expand"
			backcolor	0,0,0,0
			visible	1
		}	
		
		windowDef failedtext
		{
			rect	0,220,640,20
			visible	1
			forecolor	1,1,1,0
			text	"#str_200279"
			textscale	0.5
			font	"fonts/marine"
			textalign	1
		}	
	
//-----------------------		
// animations
//-----------------------		
	
	windowDef anim_fade
	{
		rect	0,0,1,1
		visible	1
		notime	1

		onTime 0 {
			transition "fade::backcolor" "0,0,0,0" "0,0,0,1" "3000" ;
		}
		
		onTime 3000 {
			transition "failedtext::forecolor" "1,1,1,0" "1,1,1,1" "250" ;
		}
	}	
	
	windowDef anim_levelExitAlert
	{
		rect	0,0,0.1,0.1
		visible	0
		notime	1
		
		onTime 5000	{
			set "p_exit_level::visible" "0";
		}
	}

