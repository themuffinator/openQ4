	}

	onNamedEvent ship_target_04_on {
		set "ship_target_04::visible" "1" ;
	}

	onNamedEvent ship_target_04_off {
		set "ship_target_04::visible" "0" ;
	}

	onNamedEvent ship_target_05_on {
