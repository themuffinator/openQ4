// Generated by tools/ui/build_awakening_legacy_hud.py from guis/vehicles/hud.gui; do not edit.
// The stock interface's HUD for The Awakening's dropship guns: the engine reads this definition
// in place of the expansion's guis/vehicles/airassault/turretplayerhud.gui (docs/dev/ui/legacy-hud-layout.md).

windowDef Desktop
{
	rect	0,0,640,480
	visible	1
	nocursor	1
	menugui	0
	float	"locked"	0

	onInit {
		namedEvent "radioChatterDown";
	}

//-----------------------
// The Awakening: the dropship panel (m03)
//-----------------------

	onNamedEvent ship_health_01_on {
		set "ship_core_02::visible" "1" ;
	}

	onNamedEvent ship_health_01_off {
		set "ship_core_02::visible" "0" ;
	}

	onNamedEvent ship_health_02_on {
