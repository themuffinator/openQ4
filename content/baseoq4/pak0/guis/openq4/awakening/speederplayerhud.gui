	// line in place of the exit line, and the Remastered prompt Vehicle locked.
	windowDef lock_state_msg
	{
		rect	310 + "gui::oq4_hudEdgeRight",457 + "gui::oq4_hudEdgeBottom",319,19
		hudanchorx	right
