// Generated by tools/ui/build_awakening_legacy_hud.py from guis/vehicles/hud.gui; do not edit.
// The stock interface's HUD for The Awakening's speeder bike: the engine reads this definition
// in place of the expansion's guis/vehicles/speederplayerhud.gui (docs/dev/ui/legacy-hud-layout.md).

windowDef Desktop
{
	rect	0,0,640,480
	visible	1
	nocursor	1
	menugui	0
	float	"locked"	0

	onInit {
		namedEvent "radioChatterDown";
	}

//-----------------------
// The Awakening: the race display and the boost (m07)
//-----------------------

	// The race script's countdown. The expansion showed its placeholder
	// digits until the first of these arrived.
	onNamedEvent updatetimer {
		set "speedertimer::text" "$gui::currenttime" ;
		set "speedertimer::visible" "1" ;
	}

	onNamedEvent updatetimer2 {
		set "speedertimer2::text" "$gui::currenttime2" ;
		set "speedertimer2::visible" "1" ;
		set "speedertimerdot::visible" "1" ;
	}

	onNamedEvent showspeedertimer {
		set "speedertimer::visible" "1" ;
	}

	onNamedEvent hidespeedertimer {
		set "speedertimer::visible" "0" ;
	}

	onNamedEvent showspeedertimer2 {
		set "speedertimer2::visible" "1" ;
		set "speedertimerdot::visible" "1" ;
	}

	onNamedEvent hidespeedertimer2 {
		set "speedertimer2::visible" "0" ;
		set "speedertimerdot::visible" "0" ;
	}

	onNamedEvent showprogress0 {
