	// openQ4: the Remastered HUD prompt (14.8): one sheared plate at black 0.50
	// at the bottom-trailing corner, never wider than its content: the jump
	// key's cap (the engine's inline keycap) and Exit, or Vehicle locked in
	// #FF8000 while a script locks the vehicle (its lock events or the game's
	// vehicle_locked).
	windowDef oq4_prompt
	{
		rect	0,0,640,480
		hudanchorx	right
		hudanchory	bottom
		noclip	1
		visible	"gui::oq4_hudRemastered" * (("exit_msg::visible" * ("gui::vehicle_locked" == 0)) + (("lock_msg::visible" + "gui::vehicle_locked") > 0) + ("gui::oq4_boost" < 2))
		definefloat	"chip"	"oq4_prompt_key::textwidth"
		definefloat	"boost"	("gui::oq4_boost" == 0) * (15 + "oq4_prompt_boostkey::textwidth" + "oq4_prompt_boostword::textwidth") + ("gui::oq4_boost" == 1) * (24 + "oq4_prompt_boosting::textwidth")
		definefloat	"width"	"oq4_prompt::boost" + ("exit_msg::visible" * ("gui::vehicle_locked" == 0)) * (15 + "oq4_prompt::chip" + "oq4_prompt_exit::textwidth") + (("lock_msg::visible" + "gui::vehicle_locked") > 0) * (23 + "oq4_prompt_locked::textwidth")
		definefloat	"left"	629 + "gui::oq4_hudEdgeRight" - "oq4_prompt::width"
		definefloat	"top"	460 + "gui::oq4_hudEdgeBottom"
		windowDef oq4_prompt_plate
		{
			rect	"oq4_prompt::left","oq4_prompt::top","oq4_prompt::width",16
			background	"gfx/guis/hud/pickupbar"
			matcolor	0,0,0,0.5
			shear	0,-.22
		}
		windowDef oq4_prompt_key
		{
			rect	"oq4_prompt::left" + "oq4_prompt::boost" + 5.5,"oq4_prompt::top" + 1,96,14
			text	"gui::oq4_key_jump"
			font	"fonts/lowpixel"
			textscale	0.2
			forecolor	1,1,1,0.92
			visible	("exit_msg::visible" * ("gui::vehicle_locked" == 0))
			nowrap	1
		}
		windowDef oq4_prompt_exit
		{
			rect	"oq4_prompt::left" + "oq4_prompt::boost" + 9.5 + "oq4_prompt::chip","oq4_prompt::top" + 1,96,14
			text	"#str_231229"
			font	"fonts/lowpixel"
			textscale	0.2
			forecolor	1,1,1,0.92
			visible	("exit_msg::visible" * ("gui::vehicle_locked" == 0))
			nowrap	1
		}
		// openQ4: the lock before Vehicle locked (14.8), the stock padlock in the notice's #FF8000.
		windowDef oq4_prompt_padlock
		{
			rect	"oq4_prompt::left" + "oq4_prompt::boost" + 5,"oq4_prompt::top" + 2.5,11,11
			background	"gfx/guis/mainmenu/icon_locked"
			matcolor	1,0.5,0,1
			visible	(("lock_msg::visible" + "gui::vehicle_locked") > 0)
		}
		windowDef oq4_prompt_locked
		{
			rect	"oq4_prompt::left" + "oq4_prompt::boost" + 17.5,"oq4_prompt::top" + 1,160,14
			text	"#str_231230"
			font	"fonts/lowpixel"
			textscale	0.2
			forecolor	1,0.5,0,1
			visible	(("lock_msg::visible" + "gui::vehicle_locked") > 0)
			nowrap	1
		}
			windowDef oq4_prompt_boostkey
		{
			rect	"oq4_prompt::left" + 5.5,"oq4_prompt::top" + 1,96,14
			text	"gui::oq4_key_crouch"
			font	"fonts/lowpixel"
			textscale	0.2
			forecolor	1,1,1,0.92
			visible	"gui::oq4_boost" == 0
			nowrap	1
		}
		windowDef oq4_prompt_boostword
		{
			rect	"oq4_prompt::left" + 9.5 + "oq4_prompt_boostkey::textwidth","oq4_prompt::top" + 1,96,14
			text	"#str_231244"
			font	"fonts/lowpixel"
			textscale	0.2
			forecolor	1,1,1,0.92
			visible	"gui::oq4_boost" == 0
			nowrap	1
		}
		windowDef oq4_prompt_hazard
		{
			rect	"oq4_prompt::left" + 5.5,"oq4_prompt::top" + 2.7,9,10.6
			background	"gfx/guis/vehicle/speeder/boosticon"
			matcolor	1,1,1,1
			visible	"gui::oq4_boost" == 1
		}
		windowDef oq4_prompt_boosting
		{
			rect	"oq4_prompt::left" + 18.5,"oq4_prompt::top" + 1,96,14
			text	"#str_231245"
			font	"fonts/lowpixel"
			textscale	0.2
			forecolor	1,0.2,0.2,1
			visible	"gui::oq4_boost" == 1
			nowrap	1
		}
	}
