			matcolor	0.6,0,0,1
		}
		windowDef right_elecwarn
		{
			rect	512 + "gui::oq4_hudEdgeRight",167,128,128
			hudanchorx	right
			visible	0
			background	"gfx/guis/vehicles/veh_elecwarn"
			matcolor	0.6,0,0,1
			matscalex	-1
		}
	}
