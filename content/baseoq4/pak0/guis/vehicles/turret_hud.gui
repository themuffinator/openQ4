			}
		}
		windowDef icon_armorvest
		{
			rect	262,458,16,16
			visible	1
			background	"gfx/guis/hud/icons/item_armor"
			matcolor	0.658,0.639,0.376,0.6
		}
		windowDef t_shields
		{
			rect	203,453,52,13
			visible	1
			forecolor	0.658,0.639,0.376,0.6
			text	"#str_200911"
			textscale	0.14
			font	"fonts/lowpixel"
		}
		windowDef t_armor_val
		{
			rect	230,429,52,26
			visible	1
			forecolor	0.866,0.921,0.764,1
			text	"gui::player_armor"
			textscale	0.5
			shear	0,-.22
			font	"fonts/chain"
			textalign	2
		}
	}
	windowDef p_ammo
	{
		rect	170.5 * "gui::oq4_hudRemastered","gui::oq4_hudEdgeBottom",640,480
		visible	1
		windowDef ammo_backbar
		{
			rect	9,403,152,74
			visible	1
			background	"gfx/guis/hud/veh_backbar2"
			matcolor	0,0,0,0.5
			shear	0,-.22
		}
	}
	// The gun's glyph and its barrel heat where the vehicle HUD shows its
	// weapons and charge: the bar fills #FF9E1A, turns #FF3300 and pulses at
	// 2 Hz from the warning level and while the gun vents, when OVERHEATED
	// takes the HEAT label's place.
	windowDef p_mgun
	{
		rect	170.5 * "gui::oq4_hudRemastered","gui::oq4_hudEdgeBottom",640,480
		visible	1
		windowDef mgun_turret
		{
			rect	16,432,74,32
			background	"gfx/guis/vehicles/veh_mgun"
			visible	1
			matcolor	0.658,0.639,0.376,0.8 - 0.5 * "gui::vehicle_overheat"
		}
		windowDef t_heat
		{
			rect	23,413,90,13
			visible	"gui::vehicle_overheat" == 0
			forecolor	0.658,0.639,0.376,0.6
			text	"#str_231708"
			textscale	0.14
			font	"fonts/lowpixel"
		}
	}
	windowDef p_heat
	{
		rect	170.5 * "gui::oq4_hudRemastered","gui::oq4_hudEdgeBottom",640,480
		visible	1
		windowDef heat_bg
		{
			rect	9,465,85,8
			visible	1
			background	"gfx/guis/vehicles/bar2"
			matcolor	0.701,0.815,0.431,0.3
			shear	0,-.22
		}
		windowDef p_heat_bar
		{
			rect	15,467,74 * "gui::vehicle_heat",4
			visible	"gui::vehicle_heat" < "gui::vehicle_heatwarn" && "gui::vehicle_overheat" == 0
			windowDef heat_bar
			{
				rect	0,0,74,4
				visible	1
				background	"gfx/guis/vehicles/bar2"
				matcolor	1,0.621,.1,1
				shear	0,-.22
			}
		}
		windowDef p_heat_bar_warn
		{
			rect	15,467,74 * "gui::vehicle_heat",4
			visible	"gui::vehicle_heat" >= "gui::vehicle_heatwarn" || "gui::vehicle_overheat"
			windowDef heat_bar_warn
			{
				rect	0,0,74,4
				visible	1
				background	"gfx/guis/vehicles/bar2"
				matcolor	1,0.2,0,1*guitable_10_5[time*0.002]
				shear	0,-.22
			}
		}
		windowDef t_overheat
		{
			rect	21,407,130,19
			visible	"gui::vehicle_overheat"
			forecolor	1,0.2,0,1*guitable_10_5[time*0.002]
			text	"#str_231709"
			textscale	0.22
			font	"fonts/marine"
			textstyle	1
		}
	}
	// Under the crosshair, the heat as a short bar once the barrel is warm,
	// and OVERHEATED while it vents (Minimal keeps both: the gun is unusable
	// without them).
	windowDef p_cross_heat
	{
		rect	0,0,640,480
		noclip	1
		visible	"gui::vehicle_heat" > 0.02 || "gui::vehicle_overheat"
		windowDef cross_heat_bg
		{
			rect	300,262,40,3
			visible	1
			background	"_white"
			matcolor	0,0,0,0.45
		}
		windowDef cross_heat
		{
			rect	300,262,40 * "gui::vehicle_heat",3
			visible	"gui::vehicle_heat" < "gui::vehicle_heatwarn" && "gui::vehicle_overheat" == 0
			background	"_white"
			matcolor	1,0.621,.1,0.85
		}
		windowDef cross_heat_warn
		{
			rect	300,262,40 * "gui::vehicle_heat",3
			visible	"gui::vehicle_heat" >= "gui::vehicle_heatwarn" || "gui::vehicle_overheat"
			background	"_white"
			matcolor	1,0.2,0,0.9*guitable_10_5[time*0.002]
		}
		windowDef cross_overheat
		{
			rect	200,268,240,20
			visible	"gui::vehicle_overheat"
			forecolor	1,0.2,0,0.55 + 0.45*guitable_10_5[time*0.002]
			text	"#str_231709"
			textscale	0.26
			font	"fonts/marine"
			textalign	1
			textstyle	1
		}
	}
