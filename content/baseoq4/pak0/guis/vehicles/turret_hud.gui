	// openQ4: the Remastered HUD prompt (14.8): one sheared plate at black 0.50
	// at the bottom-trailing corner, never wider than its content: the jump
	// key's cap (the engine's inline keycap) and Exit, or Vehicle locked in
	// #FF8000 while a script locks the vehicle.
	windowDef oq4_prompt
	{
		rect	0,0,640,480
		noclip	1
		visible	"gui::oq4_hudRemastered" * ("exit_msg::visible" + "lock_msg::visible")
		definefloat	"chip"	"oq4_prompt_key::textwidth"
		definefloat	"width"	"exit_msg::visible" * (15 + "oq4_prompt::chip" + "oq4_prompt_exit::textwidth") + "lock_msg::visible" * (11 + "oq4_prompt_locked::textwidth")
		definefloat	"left"	629 + "gui::oq4_hudEdgeRight" - "oq4_prompt::width"
		definefloat	"top"	460 + "gui::oq4_hudEdgeBottom"
		windowDef oq4_prompt_plate
		{
			rect	"oq4_prompt::left","oq4_prompt::top","oq4_prompt::width",16
			background	"gfx/guis/hud/pickupbar"
			matcolor	0,0,0,0.5
			shear	0,-.22
		}
		windowDef oq4_prompt_key
		{
			rect	"oq4_prompt::left" + 5.5,"oq4_prompt::top" + 1,96,14
			text	"gui::oq4_key_jump"
			font	"fonts/lowpixel"
			textscale	0.2
			forecolor	1,1,1,0.92
			visible	"exit_msg::visible"
			nowrap	1
		}
		windowDef oq4_prompt_exit
		{
			rect	"oq4_prompt::left" + 9.5 + "oq4_prompt::chip","oq4_prompt::top" + 1,96,14
			text	"#str_231229"
			font	"fonts/lowpixel"
			textscale	0.2
			forecolor	1,1,1,0.92
			visible	"exit_msg::visible"
			nowrap	1
		}
		windowDef oq4_prompt_locked
		{
			rect	"oq4_prompt::left" + 5.5,"oq4_prompt::top" + 1,160,14
			text	"#str_231230"
			font	"fonts/lowpixel"
			textscale	0.2
			forecolor	1,0.5,0,1
			visible	"lock_msg::visible"
			nowrap	1
		}
	}
