		{
			rect	164,420,125,59
			visible	0
			background	"gfx/guis/hud/veh_valbar"
			matcolor	1,0.2,0,0.6*guitable_10_5[time*0.002]
			shear	0,-.22
		}
		windowDef p_armor_val
		{
			rect	283 - ( "gui::player_armorpct" * 80 ),420,80,59
			visible	1
			shear	0,-.22
			windowDef armor_val
			{
				rect	-120 + ( "gui::player_armorpct" * 80 ),0,125,59
				visible	1
				background	"gfx/guis/hud/veh_valbar"
				matcolor	0.698,0.811,0.427,0.349
