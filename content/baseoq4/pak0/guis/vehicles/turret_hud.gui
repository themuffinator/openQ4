	// openQ4: Minimal leaves out the missile warning.
	windowDef p_missile_layout
	{
		rect	0,0,640,480
		noclip	1
		visible	"gui::oq4_hudShowExtras"
		windowDef missile_indicator
		{
			rect	0,0,640,480
			background	"gfx/guis/hud/directional_hit2"
