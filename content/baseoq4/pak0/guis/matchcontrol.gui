		visible	1
		background	"gfx/guis/mainmenu/horiz_line2"
		matcolor	1,1,1,0.2
	}

	// Tabs remain local presentation state.  Refreshing a tab never mutates the
	// authoritative match aggregates.
	windowDef match_tab_status
	{
		rect	196,82,58,23
		visible	1
		text	"#str_41701"
		textscale	0.21
		font	"fonts/lowpixel"
		textspacing	-1
		textalign	1
		forecolor	1,1,1,( 0.55 + ( ( "desktop::match_tab" == 0 ) * 0.35 ) )
		background	"gfx/guis/mainmenu/b6_light"
		matcolor	0.545,0.588,0.294,0.45

		onAction {
			set "desktop::match_tab" "0" ;
			set "cmd" "play main_menu_selection" ;
		}
	}
	windowDef match_tab_teams
