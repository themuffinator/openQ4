	// Persistent, localized feedback. Hovering or focusing an operation shows
	// its server-projected availability reason. Both fields wrap and can scroll
	// so translated explanations and authoritative results remain accessible.
	windowDef match_feedback_line
	{
		rect	200,375,362,4
		visible	1
		background	"gfx/guis/mainmenu/horiz_line2"
		matcolor	1,1,1,0.18
