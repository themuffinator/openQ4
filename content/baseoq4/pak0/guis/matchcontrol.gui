		// Camera requests use fixed verbs; live server permissions choose targets.
		windowDef match_follow_controls
		{
			rect	0,0,640,480
			visible	( "gui::match_follow_visible" == 1 )
			windowDef match_follow_prev_button
			{
				rect	202,344,116,24
				visible	1
				background	"gfx/guis/mainmenu/b6_light"
				matcolor	0.545,0.588,0.294,0.45
				onMouseEnter {
					if ( "desktop::active" == 0 && "desktop::match_confirm" == 0 ) {
						stoptransitions "match_follow_prev_button" ;
						set "matcolor_w" "1" ;
						set "match_follow_prev_label::forecolor" "$desktop::orange" ;
						set "match_follow_prev_label::textscale" "0.21" ;
						set "match_follow_prev_corner::matcolor" "$desktop::orange" ;
						set "match_action_reason::text" "#str_42888" ;
						set "cmd" "play main_menu_mouseover" ;
					}
				}
				onMouseExit {
					if ( "desktop::active" == 0 && "desktop::match_confirm" == 0 ) {
						transition "matcolor_w" "1" "0.45" "300" ;
						transition "match_follow_prev_label::forecolor" "$desktop::orange" "$desktop::white_8" "300" ;
						transition "match_follow_prev_label::textscale" "0.21" "0.20" "300" ;
						transition "match_follow_prev_corner::matcolor" "$desktop::orange" "$desktop::corner" "300" ;
					}
				}
				onGainFocus { set "match_action_reason::text" "#str_42888" ; }
				onAction {
					if ( "desktop::active" == 0 && "desktop::match_confirm" == 0 && "gui::match_follow_visible" == 1 ) {
						set "cmd" "play main_menu_selection" ;
						set "cmd" "matchControl follow_prev" ;
					}
				}
			}
			windowDef match_follow_prev_label
			{
				rect	218,347,98,18
				visible	1
				noevents	1
				text	"#str_42885"
				textscale	0.20
				font	"fonts/lowpixel"
				textspacing	-1
				forecolor	1,1,1,0.8
			}
			windowDef match_follow_prev_corner
			{
				rect	209,353,6,6
				visible	1
				noevents	1
				background	"gfx/guis/mainmenu/corner"
				matcolor	0.564,0.603,0.286,0.4
			}
			windowDef match_follow_next_button
			{
				rect	322,344,116,24
				visible	1
				background	"gfx/guis/mainmenu/b6_light"
				matcolor	0.545,0.588,0.294,0.45
				onMouseEnter {
					if ( "desktop::active" == 0 && "desktop::match_confirm" == 0 ) {
						stoptransitions "match_follow_next_button" ;
						set "matcolor_w" "1" ;
						set "match_follow_next_label::forecolor" "$desktop::orange" ;
						set "match_follow_next_label::textscale" "0.21" ;
						set "match_follow_next_corner::matcolor" "$desktop::orange" ;
						set "match_action_reason::text" "#str_42888" ;
						set "cmd" "play main_menu_mouseover" ;
					}
				}
				onMouseExit {
					if ( "desktop::active" == 0 && "desktop::match_confirm" == 0 ) {
						transition "matcolor_w" "1" "0.45" "300" ;
						transition "match_follow_next_label::forecolor" "$desktop::orange" "$desktop::white_8" "300" ;
						transition "match_follow_next_label::textscale" "0.21" "0.20" "300" ;
						transition "match_follow_next_corner::matcolor" "$desktop::orange" "$desktop::corner" "300" ;
					}
				}
				onGainFocus { set "match_action_reason::text" "#str_42888" ; }
				onAction {
					if ( "desktop::active" == 0 && "desktop::match_confirm" == 0 && "gui::match_follow_visible" == 1 ) {
						set "cmd" "play main_menu_selection" ;
						set "cmd" "matchControl follow_next" ;
					}
				}
			}
			windowDef match_follow_next_label
			{
				rect	338,347,98,18
				visible	1
				noevents	1
				text	"#str_42886"
				textscale	0.20
				font	"fonts/lowpixel"
				textspacing	-1
				forecolor	1,1,1,0.8
			}
			windowDef match_follow_next_corner
			{
				rect	329,353,6,6
				visible	1
				noevents	1
				background	"gfx/guis/mainmenu/corner"
				matcolor	0.564,0.603,0.286,0.4
			}
			windowDef match_follow_free_button
			{
				rect	442,344,116,24
				visible	1
				background	"gfx/guis/mainmenu/b6_light"
				matcolor	0.545,0.588,0.294,0.45
				onMouseEnter {
					if ( "desktop::active" == 0 && "desktop::match_confirm" == 0 ) {
						stoptransitions "match_follow_free_button" ;
						set "matcolor_w" "1" ;
						set "match_follow_free_label::forecolor" "$desktop::orange" ;
						set "match_follow_free_label::textscale" "0.21" ;
						set "match_follow_free_corner::matcolor" "$desktop::orange" ;
						set "match_action_reason::text" "#str_42888" ;
						set "cmd" "play main_menu_mouseover" ;
					}
				}
				onMouseExit {
					if ( "desktop::active" == 0 && "desktop::match_confirm" == 0 ) {
						transition "matcolor_w" "1" "0.45" "300" ;
						transition "match_follow_free_label::forecolor" "$desktop::orange" "$desktop::white_8" "300" ;
						transition "match_follow_free_label::textscale" "0.21" "0.20" "300" ;
						transition "match_follow_free_corner::matcolor" "$desktop::orange" "$desktop::corner" "300" ;
					}
				}
				onGainFocus { set "match_action_reason::text" "#str_42888" ; }
				onAction {
					if ( "desktop::active" == 0 && "desktop::match_confirm" == 0 && "gui::match_follow_visible" == 1 ) {
						set "cmd" "play main_menu_selection" ;
						set "cmd" "matchControl follow_free" ;
					}
				}
			}
			windowDef match_follow_free_label
			{
				rect	458,347,98,18
				visible	1
				noevents	1
				text	"#str_42887"
				textscale	0.20
				font	"fonts/lowpixel"
				textspacing	-1
				forecolor	1,1,1,0.8
			}
			windowDef match_follow_free_corner
			{
				rect	449,353,6,6
				visible	1
				noevents	1
				background	"gfx/guis/mainmenu/corner"
				matcolor	0.564,0.603,0.286,0.4
			}
		}
	}

