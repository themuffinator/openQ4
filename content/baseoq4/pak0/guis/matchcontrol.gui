	// Every operation whose protocol descriptor advertises a confirmation
	// localization requires this second, modal step.  The branch still emits
	// fixed tokens; no display text becomes command data.
	windowDef match_confirm_modal
	{
		rect	0,0,640,480
		visible	( "desktop::match_confirm" != 0 )
		modal	1
		backcolor	0,0,0,0.48

		windowDef match_confirm_panel
		{
			rect	244,151,274,150
			visible	1
			background	"gfx/guis/mainmenu/screen"
			matcolor	0.05,0.07,0.06,0.98
