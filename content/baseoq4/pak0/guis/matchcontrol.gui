// openQ4 competitive Match Control surface.
//
// This file is a windowDef fragment included by guis/mpmain.gui.  The game
// adapter owns every gui::match_* state and handles only the fixed
// "matchControl <token>" commands emitted below.  The GUI never constructs a
// console command from a participant name, map token, credential, or list row.

windowDef p_matchcontrol
{
	rect	0,0,640,480
	visible	0

	windowDef match_panel
	{
		rect	188,44,386,396
		visible	1
		background	"gfx/guis/mainmenu/screen"
		matcolor	0.05,0.07,0.06,0.92
	}
	windowDef match_panel_grad
	{
		rect	188,44,386,396
		visible	1
		background	"gfx/guis/mainmenu/bg_darkgrad"
		matcolor	0.545,0.588,0.294,0.24
	}
	windowDef match_frame_top
	{
		rect	188,44,386,16
		visible	1
		noevents	1
		background	"gfx/guis/mainmenu/tooltip_edge"
		matcolor	0.545,0.588,0.294,0.95
	}
	windowDef match_frame_mid
	{
		rect	188,60,386,364
		visible	1
		noevents	1
		background	"gfx/guis/mainmenu/tooltip_mid"
