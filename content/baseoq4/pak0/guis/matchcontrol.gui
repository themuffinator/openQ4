	// ----------------------------------------------------------------------
	// Status, readiness, pause and referee session.
	// ----------------------------------------------------------------------
	windowDef match_status_page
	{
		rect	0,0,640,480
		visible	( "gui::match_surface_available" == 1 && "desktop::match_tab" == 0 )

		// The localized summary already includes its labels. Let long blocker
		// lists wrap and scroll together without displacing unrelated row labels.
		editDef match_status_values
		{
			rect	204,116,354,93
			visible	1
			text	"gui::match_status_lines"
			textscale	0.20
			font	"fonts/lowpixel"
			textspacing	-1
			readonly	1
			wrap	1
			forecolor	1,1,1,0.8
		}

		// One explicit selector drives every side-scoped action.  The accepted
		// recipient model supplies both labels and which choices are legal; the
		// GUI emits only fixed selection tokens.
		windowDef match_action_side_label
		{
			rect	202,212,116,18
			visible	( "gui::match_action_side_visible" == 1 )
			text	"gui::match_action_side_label"
			textscale	0.20
			font	"fonts/lowpixel"
			textspacing	-1
			forecolor	1,1,1,0.65
		}
		windowDef match_action_side_0_button
		{
			rect	322,210,116,20
			visible	( "gui::match_action_side_visible" == 1 )
			text	"gui::match_action_side_0_label"
			textscale	0.19
			font	"fonts/lowpixel"
			textspacing	-1
			textalign	1
			forecolor	1,1,1,( 0.38 + ( "gui::match_action_side_0_enabled" * 0.22 ) + ( "gui::match_action_side_0_selected" * 0.30 ) )
			background	"gfx/guis/mainmenu/b6_light"
			matcolor	0.545,0.588,0.294,( 0.35 + ( "gui::match_action_side_0_selected" * 0.45 ) )

			onAction {
				if ( "gui::match_action_side_0_enabled" == 1 ) {
					set "cmd" "play main_menu_selection" ;
					set "cmd" "matchControl action_side_a" ;
				}
			}
		}
		windowDef match_action_side_1_button
		{
			rect	442,210,116,20
			visible	( "gui::match_action_side_visible" == 1 )
			text	"gui::match_action_side_1_label"
			textscale	0.19
			font	"fonts/lowpixel"
			textspacing	-1
			textalign	1
			forecolor	1,1,1,( 0.38 + ( "gui::match_action_side_1_enabled" * 0.22 ) + ( "gui::match_action_side_1_selected" * 0.30 ) )
			background	"gfx/guis/mainmenu/b6_light"
			matcolor	0.545,0.588,0.294,( 0.35 + ( "gui::match_action_side_1_selected" * 0.45 ) )

			onAction {
				if ( "gui::match_action_side_1_enabled" == 1 ) {
					set "cmd" "play main_menu_selection" ;
					set "cmd" "matchControl action_side_b" ;
				}
			}
		}

		windowDef match_ready_button
		{
