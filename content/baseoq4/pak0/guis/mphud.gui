		// openQ4: the Remastered respawn prompt (ui-visual-design.md 14.9): while you lie dead and the
		// rules let you back in, the attack control and Respawn on a fitted plate at 0.50 in the lower
		// third, with the seconds left in Chain while the server holds the respawn.
		windowDef oq4_respawn
		{
			rect	0,318,640,21
			screenalignx	middle
			screenaligny	bottom
			noclip	1
			visible	"gui::oq4_hudRemastered" * ("gui::oq4_respawn" > 0)
			definefloat	"held"	("gui::oq4_respawn" == 2) * ("oq4_respawn_in::textwidth" + 8)
			definefloat	"width"	"oq4_respawn_key::textwidth" + "oq4_respawn_word::textwidth" + "oq4_respawn::held" + 21
			definefloat	"left"	320 - "oq4_respawn::width" / 2
			windowDef oq4_respawn_plate
			{
				rect	"oq4_respawn::left",0,"oq4_respawn::width",21
				background	"gfx/guis/hud/pickupbar"
				matcolor	0,0,0,0.5
				shear	0,-.22
			}
			windowDef oq4_respawn_key
			{
				rect	"oq4_respawn::left" + 8,3.4,120,16
				text	"gui::oq4_key_attack"
				font	"fonts/lowpixel"
				textscale	0.2
				forecolor	1,1,1,0.92
				nowrap	1
			}
			windowDef oq4_respawn_word
			{
				rect	"oq4_respawn::left" + 12 + "oq4_respawn_key::textwidth",2.2,160,18
				text	"#str_231233"
				font	"fonts/lowpixel"
				textscale	0.225
				forecolor	1,1,1,1
				nowrap	1
			}
			windowDef oq4_respawn_in
			{
				rect	"oq4_respawn::left" + 20 + "oq4_respawn_key::textwidth" + "oq4_respawn_word::textwidth",1,60,20
