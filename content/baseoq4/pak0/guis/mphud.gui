					textscale	0.225
					ellipsis	1
					forecolor	"gui::oq4_feed0_youAttacker" + (1 - "gui::oq4_feed0_youAttacker") * ("gui::oq4_feed0_team" * (0.667 + 0.333 * ("gui::oq4_feed0_attackerTeam" == 1)) + (1 - "gui::oq4_feed0_team") * 1),"gui::oq4_feed0_youAttacker" + (1 - "gui::oq4_feed0_youAttacker") * ("gui::oq4_feed0_team" * (0.89 - 0.333 * ("gui::oq4_feed0_attackerTeam" == 1)) + (1 - "gui::oq4_feed0_team") * 1),"gui::oq4_feed0_youAttacker" + (1 - "gui::oq4_feed0_youAttacker") * ("gui::oq4_feed0_team" * (0.333 - 0.333 * ("gui::oq4_feed0_attackerTeam" == 1)) + (1 - "gui::oq4_feed0_team") * 0.553),"gui::oq4_feed0_alpha"
