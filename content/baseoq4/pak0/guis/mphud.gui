						set "sel1_round3_bracket1::matcolor" "$desktop::aqua_0" ;
						set "sel2_round3_bracket1::matcolor" "$desktop::aqua_0" ;
					}
				} else if ( "gui::bracket" == 2 ) {
					if ( "desktop::round3_bracket2_done" == 0 ) {
