		windowDef d_aimText
		{
			rect	0,0,640,480
			notime	1
			visible	1

			onTime 0 {
				transition "aimText::forecolor" "1,0,0,1" "$desktop::aim_text_color" "400";
				transition "aimTextHealth::forecolor" "1,0,0,1" "$desktop::aim_text_color" "400";
			}

			onTime 500 {
				set "notime" "1";
			}

		}
		windowDef d_aimText2
		{
			rect	0,0,640,480
			notime	1
			visible	1

			onTime 100 {
				transition "aimText::forecolor_w" "0" "0.8" "200";
				transition "aimTextHealth::forecolor_w" "0" "0.8" "200";
			}

