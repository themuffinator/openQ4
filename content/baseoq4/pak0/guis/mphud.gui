							set "sel1_round3_bracket1::matcolor" "$desktop::aqua_4" ;
						}else if ( "gui::sel" == 2 ) {
							set "sel2_round3_bracket1::matcolor" "$desktop::aqua_4" ;
						}else {
							set "hover_round3_bracket1::matcolor" "$desktop::aqua_4" ;
						}		
					} else {
