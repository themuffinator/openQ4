				font	"fonts/lowpixel"
				textscale	0.18
			}
		}
	}

	windowDef oq4_main_plate
	{
		rect	320 - ("mainNotice::textwidth" + 16) / 2,81 + 26.4 * ("fragNotice::textwidth" > 0) * "fragNotice::visible","mainNotice::textwidth" + 16,20.8
		screenalignx	middle
