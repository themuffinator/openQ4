	// openQ4: an Arena presentation shot keeps only its letterbox and cards
	// (the oq4_arena windows) and the centre notice; the game sets
	// arena_hudHidden for its introductions, entrance, spawn-in and result.
	windowDef oq4_match_hud
	{
		rect	0,0,640,480
		visible	( "gui::arena_hudHidden" == 0 )
		// The panels anchor into the wide-screen margins, outside this rect.
