	// One beat per introduced combatant.  The first opens the frame at a lighter
	// shade than the entrance, so the fighter reads clearly; every beat fades
	// its own copy in.  Nothing here closes the frame: the countdown entrance
	// takes it over, or a clear retires it.
	windowDef oq4_arena_present_intro
	{
		rect	0,0,1,1
		visible	1
		notime	1

		onTime 0 {
			stopTransitions "oq4_arena_present_intro" ;
			set "oq4_arena_entrance_kicker::forecolor" "0.95,0.72,0.25,0" ;
			set "oq4_arena_entrance_title::forecolor" "1,0.97,0.84,0" ;
			set "oq4_arena_entrance_subtitle::forecolor" "0.78,0.84,0.69,0" ;
			set "oq4_arena_entrance_ready::forecolor" "0.95,0.49,0.06,0" ;
			if ( "Desktop::arena_presentHold" == 1 ) {
				// Already framed: settle any interrupted fade on the held frame.
				set "oq4_arena_frame::open" "1" ;
				set "oq4_arena_present_shade::backcolor" "0,0,0,0.3" ;
				set "oq4_arena_rule_top::backcolor" "0.95,0.49,0.06,0.9" ;
				set "oq4_arena_rule_bottom::backcolor" "0.95,0.49,0.06,0.9" ;
			} else {
				set "oq4_arena_frame::open" "0" ;
				set "oq4_arena_present_shade::backcolor" "0,0,0,0" ;
				set "oq4_arena_rule_top::backcolor" "0.95,0.49,0.06,0" ;
				set "oq4_arena_rule_bottom::backcolor" "0.95,0.49,0.06,0" ;
				transition "oq4_arena_present_shade::backcolor" "0,0,0,0" "0,0,0,0.3" "400" ;
				transition "oq4_arena_frame::open" "0" "1" "400" ;
				transition "oq4_arena_rule_top::backcolor" "0.95,0.49,0.06,0" "0.95,0.49,0.06,0.9" "500" ;
				transition "oq4_arena_rule_bottom::backcolor" "0.95,0.49,0.06,0" "0.95,0.49,0.06,0.9" "500" ;
			}
		}

		onTime 60 {
			transition "oq4_arena_entrance_kicker::forecolor" "0.95,0.72,0.25,0" "0.95,0.72,0.25,1" "260" ;
		}

		onTime 140 {
			transition "oq4_arena_entrance_title::forecolor" "1,0.97,0.84,0" "1,0.97,0.84,1" "320" ;
			transition "oq4_arena_entrance_subtitle::forecolor" "0.78,0.84,0.69,0" "0.78,0.84,0.69,1" "320" ;
		}
	}

	windowDef oq4_arena_present_entrance
	{
		rect	0,0,1,1
		visible	1
		notime	1

		onTime 0 {
			// stopTransitions only reaches the calling window's own subtree, so a
			// timeline can clear the transitions it owns and nothing else.  The
			// Desktop event that starts this timeline stops the sibling ones.
			stopTransitions "oq4_arena_present_entrance" ;
			set "oq4_arena_entrance_kicker::forecolor" "0.95,0.72,0.25,0" ;
			set "oq4_arena_entrance_title::forecolor" "1,0.97,0.84,0" ;
			set "oq4_arena_entrance_subtitle::forecolor" "0.78,0.84,0.69,0" ;
			set "oq4_arena_entrance_ready::forecolor" "0.95,0.49,0.06,0" ;
			if ( "Desktop::arena_presentHold" == 1 ) {
				// The introductions left the frame open: keep it and only deepen
				// the shade, instead of collapsing the bars to reopen them.
				set "oq4_arena_frame::open" "1" ;
				set "oq4_arena_rule_top::backcolor" "0.95,0.49,0.06,0.9" ;
				set "oq4_arena_rule_bottom::backcolor" "0.95,0.49,0.06,0.9" ;
				transition "oq4_arena_present_shade::backcolor" "0,0,0,0.3" "0,0,0,0.42" "400" ;
			} else {
				set "oq4_arena_frame::open" "0" ;
				set "oq4_arena_present_shade::backcolor" "0,0,0,0" ;
				set "oq4_arena_rule_top::backcolor" "0.95,0.49,0.06,0" ;
				set "oq4_arena_rule_bottom::backcolor" "0.95,0.49,0.06,0" ;
				transition "oq4_arena_present_shade::backcolor" "0,0,0,0" "0,0,0,0.42" "400" ;
				transition "oq4_arena_frame::open" "0" "1" "400" ;
				transition "oq4_arena_rule_top::backcolor" "0.95,0.49,0.06,0" "0.95,0.49,0.06,0.9" "500" ;
				transition "oq4_arena_rule_bottom::backcolor" "0.95,0.49,0.06,0" "0.95,0.49,0.06,0.9" "500" ;
			}
		}

		onTime 220 {
			transition "oq4_arena_entrance_kicker::forecolor" "0.95,0.72,0.25,0" "0.95,0.72,0.25,1" "320" ;
		}

		onTime 520 {
			transition "oq4_arena_entrance_title::forecolor" "1,0.97,0.84,0" "1,0.97,0.84,1" "420" ;
			transition "oq4_arena_entrance_subtitle::forecolor" "0.78,0.84,0.69,0" "0.78,0.84,0.69,1" "420" ;
		}

		onTime 1050 {
			transition "oq4_arena_entrance_ready::forecolor" "0.95,0.49,0.06,0" "0.95,0.49,0.06,1" "250" ;
		}

		// The arena countdown is max( 3000, si_countDown * 1000 ) and the campaign
		// always launches with si_countDown 4, so the entrance owns 4000ms before
		// FIGHT hands control back.  Land the frame lift on that beat instead of
		// finishing at 3350 and leaving a dead 650ms of frozen, unframed camera.
		// A shorter countdown simply runs into the presentation-clear event, which
		// now retires this timeline and fades out from wherever it had reached.
		onTime 3100 {
			transition "oq4_arena_entrance_kicker::forecolor" "0.95,0.72,0.25,1" "0.95,0.72,0.25,0" "350" ;
			transition "oq4_arena_entrance_title::forecolor" "1,0.97,0.84,1" "1,0.97,0.84,0" "350" ;
			transition "oq4_arena_entrance_subtitle::forecolor" "0.78,0.84,0.69,1" "0.78,0.84,0.69,0" "350" ;
			transition "oq4_arena_entrance_ready::forecolor" "0.95,0.49,0.06,1" "0.95,0.49,0.06,0" "350" ;
		}

		onTime 3500 {
			transition "oq4_arena_present_shade::backcolor" "0,0,0,0.42" "0,0,0,0" "450" ;
			transition "oq4_arena_frame::open" "1" "0" "450" ;
			transition "oq4_arena_rule_top::backcolor" "0.95,0.49,0.06,0.9" "0.95,0.49,0.06,0" "350" ;
			transition "oq4_arena_rule_bottom::backcolor" "0.95,0.49,0.06,0.9" "0.95,0.49,0.06,0" "350" ;
		}

		onTime 4000 {
			if ( "Desktop::arena_presentMode" == 1 ) {
				set "oq4_arena_frame::open" "0" ;
				set "Desktop::arena_presentVisible" "0" ;
			}
		}
	}

	windowDef oq4_arena_present_victory
	{
		rect	0,0,1,1
		visible	1
		notime	1

		onTime 0 {
			stopTransitions "oq4_arena_present_victory" ;
			set "oq4_arena_frame::open" "0" ;
			set "oq4_arena_present_shade::backcolor" "0,0,0,0" ;
			set "oq4_arena_rule_top::backcolor" "0.95,0.49,0.06,0" ;
			set "oq4_arena_rule_bottom::backcolor" "0.95,0.49,0.06,0" ;
			set "oq4_arena_victory_kicker::forecolor" "0.95,0.72,0.25,0" ;
			set "oq4_arena_victory_title::forecolor" "1,0.97,0.84,0" ;
			set "oq4_arena_victory_score::forecolor" "0.95,0.72,0.25,0" ;
			set "oq4_arena_victor_card::backcolor" "0.015,0.022,0.014,0" ;
			set "oq4_arena_victor_card::bordercolor" "0.95,0.49,0.06,0" ;
			set "oq4_arena_victor_label::forecolor" "0.67,0.75,0.56,0" ;
			set "oq4_arena_victor_name::forecolor" "1,0.94,0.76,0" ;
			set "oq4_arena_recording_result::forecolor" "0.67,0.75,0.56,0" ;
			transition "oq4_arena_present_shade::backcolor" "0,0,0,0" "0,0,0,0.18" "500" ;
			transition "oq4_arena_frame::open" "0" "1" "450" ;
			transition "oq4_arena_rule_top::backcolor" "0.95,0.49,0.06,0" "0.95,0.49,0.06,0.9" "550" ;
			transition "oq4_arena_rule_bottom::backcolor" "0.95,0.49,0.06,0" "0.95,0.49,0.06,0.9" "550" ;
		}

		onTime 220 {
			transition "oq4_arena_victory_kicker::forecolor" "0.95,0.72,0.25,0" "0.95,0.72,0.25,1" "300" ;
			transition "oq4_arena_victory_title::forecolor" "1,0.97,0.84,0" "1,0.97,0.84,1" "420" ;
		}

		onTime 620 {
			transition "oq4_arena_victory_score::forecolor" "0.95,0.72,0.25,0" "0.95,0.72,0.25,1" "300" ;
		}

		onTime 900 {
			transition "oq4_arena_victor_card::backcolor" "0.015,0.022,0.014,0" "0.015,0.022,0.014,0.78" "450" ;
			transition "oq4_arena_victor_card::bordercolor" "0.95,0.49,0.06,0" "0.95,0.49,0.06,0.9" "450" ;
			transition "oq4_arena_victor_label::forecolor" "0.67,0.75,0.56,0" "0.67,0.75,0.56,1" "400" ;
			transition "oq4_arena_victor_name::forecolor" "1,0.94,0.76,0" "1,0.94,0.76,1" "400" ;
		}

		onTime 2600 {
			transition "oq4_arena_recording_result::forecolor" "0.67,0.75,0.56,0" "0.67,0.75,0.56,0.9" "350" ;
		}
	}

	windowDef oq4_arena_present_clear
	{
		rect	0,0,1,1
		visible	1
		notime	1

		// A "$window::var" transition source is resolved once when the gui is
		// parsed, so it carries the authored value, never the live one.  Every
		// fade here would therefore snap instead of animating.  The clear only
		// has anything to dissolve after the victory tableau has fully settled,
		// so name that state explicitly.
		onTime 0 {
			stopTransitions "oq4_arena_present_clear" ;
			// The entrance and the tableau settle on different shade depths, and a
			// clear can arrive during either one.
			if ( "Desktop::arena_presentMode" == 1 ) {
				transition "oq4_arena_present_shade::backcolor" "0,0,0,0.42" "0,0,0,0" "350" ;
			} else if ( "Desktop::arena_presentMode" == 3 ) {
				transition "oq4_arena_present_shade::backcolor" "0,0,0,0.3" "0,0,0,0" "350" ;
				transition "oq4_arena_entrance_kicker::forecolor" "0.95,0.72,0.25,1" "0.95,0.72,0.25,0" "250" ;
				transition "oq4_arena_entrance_title::forecolor" "1,0.97,0.84,1" "1,0.97,0.84,0" "250" ;
				transition "oq4_arena_entrance_subtitle::forecolor" "0.78,0.84,0.69,1" "0.78,0.84,0.69,0" "250" ;
			} else {
				transition "oq4_arena_present_shade::backcolor" "0,0,0,0.18" "0,0,0,0" "350" ;
			}
			transition "oq4_arena_frame::open" "1" "0" "350" ;
			transition "oq4_arena_rule_top::backcolor" "0.95,0.49,0.06,0.9" "0.95,0.49,0.06,0" "300" ;
			transition "oq4_arena_rule_bottom::backcolor" "0.95,0.49,0.06,0.9" "0.95,0.49,0.06,0" "300" ;
			transition "oq4_arena_victory_kicker::forecolor" "0.95,0.72,0.25,1" "0.95,0.72,0.25,0" "250" ;
			transition "oq4_arena_victory_title::forecolor" "1,0.97,0.84,1" "1,0.97,0.84,0" "250" ;
			transition "oq4_arena_victory_score::forecolor" "0.95,0.72,0.25,1" "0.95,0.72,0.25,0" "250" ;
			transition "oq4_arena_victor_card::backcolor" "0.015,0.022,0.014,0.78" "0.015,0.022,0.014,0" "250" ;
			transition "oq4_arena_victor_card::bordercolor" "0.95,0.49,0.06,0.9" "0.95,0.49,0.06,0" "250" ;
			transition "oq4_arena_victor_label::forecolor" "0.67,0.75,0.56,1" "0.67,0.75,0.56,0" "250" ;
			transition "oq4_arena_victor_name::forecolor" "1,0.94,0.76,1" "1,0.94,0.76,0" "250" ;
			transition "oq4_arena_recording_result::forecolor" "0.67,0.75,0.56,0.9" "0.67,0.75,0.56,0" "250" ;
		}

		// A card armed while this was fading cancelled it: onTime events are not
		// stopped by stopTransitions, so the hide checks it is still wanted.
		onTime 400 {
			if ( "Desktop::arena_presentClearing" == 1 ) {
				set "oq4_arena_frame::open" "0" ;
				set "Desktop::arena_presentVisible" "0" ;
				set "Desktop::arena_presentMode" "0" ;
				set "Desktop::arena_presentClearing" "0" ;
			}
		}
	}

	windowDef anim_transitionIn
	{
		rect	0,0,1,1
		visible	1
		notime	1

		onTime 0 {
			transition "tourn_overbar::rect" "$tourn_overbar::rect" "$d_tourn_overbar::rect" "500" ;
		}

		onTime 2950 {
			if ( "gui::round" == 1 ) {
				set "p_round1::visible" "1" ;
				set "p_round2::visible" "0" ;
				set "p_round3::visible" "0" ;
				set "p_round4::visible" "0" ;
			} else if ( "gui::round" == 2 ) {
				set "p_round1::visible" "0" ;
				set "p_round2::visible" "1" ;
				set "p_round3::visible" "0" ;
				set "p_round4::visible" "0" ;
			} else if ( "gui::round" == 3 ) {
				set "p_round1::visible" "0" ;
				set "p_round2::visible" "0" ;
				set "p_round3::visible" "1" ;
				set "p_round4::visible" "0" ;
			} else if ( "gui::round" == 4 ) {
				set "p_round1::visible" "0" ;
				set "p_round2::visible" "0" ;
				set "p_round3::visible" "0" ;
				set "p_round4::visible" "1" ;
			}
		}

		onTime 3000 {	
			transition "tourn_overbar::rect" "$d_tourn_overbar::rect" "$tourn_overbar::rect" "500" ;
		}

	}
}
