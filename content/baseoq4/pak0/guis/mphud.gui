	// ---------------------------------------------------------------------
	// Single-player Arena presentation layer.  The world remains visible
	// beneath the translucent framing so the game-side camera can stage the
	// combatants on entry and orbit the frozen victor after the final score.
	// ---------------------------------------------------------------------

	// Letterbox geometry.  A bar authored as a fixed slice of the 640x480
	// canvas is wrong on every display that is not 4:3: it stops short of the
	// left and right edges once the canvas is expanded for a wide screen, and
	// it floats inside the picture on a tall one, where the real screen edge is
	// above y=0 and below y=480.  Size the bars from the physical viewport
	// aspect instead, so the framed window trends toward 16:9 - the same target
	// retail guis/cinematic.gui used with its 640x360 view - on narrower
	// displays, and keep a visible frame on wider ones.
	//
	// virtual_screen_aspect is the physical aspect of whatever region the
	// authored canvas covers, so this stays correct with ui_aspectCorrection
	// either way: expanded canvas or stretched canvas.

	// Unclamped bar height as a fraction of the screen height, for a 16:9 frame.
	// 0.5625 is 9/16, so this is ( 1 - aspect / (16/9) ) / 2 and goes negative on
	// anything wider than 16:9.
	windowDef oq4_arena_frame_fit
	{
		rect	0,0,1,1
		visible	1
		notime	1
		noevents	1

		float	"raw"	( ( 1 - ( "gui::virtual_screen_aspect" * 0.5625 ) ) * 0.5 )
	}

	// clamp( raw, 0.0708333, 0.11 ), written with comparisons because the gui
	// expression language has no min/max.  A comparison yields 1 or 0, so each
	// correction term only contributes past its own bound.
	//
	// The floor 34/480 reproduces the authored bar on 16:9 and wider, so those
	// displays are unchanged.  The ceiling binds at 4:3 and below: 0.11 of the
	// screen height is exactly as thick as a bar can be while the frame still
	// clears the stock HUD row at canvas y=57, so the entrance clock is never
	// clipped by the letterbox on any aspect.
	windowDef oq4_arena_frame_metrics
	{
		rect	0,0,1,1
		visible	1
		notime	1
		noevents	1

		float	"frac"	( 0.0708333 + ( ( "oq4_arena_frame_fit::raw" - 0.0708333 ) * ( "oq4_arena_frame_fit::raw" > 0.0708333 ) ) - ( ( "oq4_arena_frame_fit::raw" - 0.11 ) * ( "oq4_arena_frame_fit::raw" > 0.11 ) ) )
	}

	// "open" is the animated 0..1 reveal of the frame.  The bars are driven from
	// it rather than by transitioning their own rects, because a rect transition
	// can only interpolate between literal corners and would therefore have to
	// hard-code the very canvas-relative geometry this layer must derive.
	windowDef oq4_arena_frame
	{
		rect	0,0,1,1
		visible	1
		notime	1
		noevents	1

		float	"open"		0
		float	"bar"		( "oq4_arena_frame_metrics::frac" * ( 480 + ( "gui::virtual_screen_y_expand" * 2 ) ) )
		float	"top"		( ( 0 - "gui::virtual_screen_y_expand" ) + ( "oq4_arena_frame_metrics::frac" * ( 480 + ( "gui::virtual_screen_y_expand" * 2 ) ) ) )
		float	"bottom"	( ( 480 + "gui::virtual_screen_y_expand" ) - ( "oq4_arena_frame_metrics::frac" * ( 480 + ( "gui::virtual_screen_y_expand" * 2 ) ) ) )
	}

	windowDef oq4_arena_present_shade
	{
		rect	( 0 - "gui::virtual_screen_x_expand" ),( 0 - "gui::virtual_screen_y_expand" ),( 640 + ( "gui::virtual_screen_x_expand" * 2 ) ),( 480 + ( "gui::virtual_screen_y_expand" * 2 ) )
		visible	"Desktop::arena_presentVisible"
		backcolor	0,0,0,0
		noevents	1
	}

	windowDef oq4_arena_letterbox_top
	{
		rect	( 0 - "gui::virtual_screen_x_expand" ),( 0 - "gui::virtual_screen_y_expand" ),( 640 + ( "gui::virtual_screen_x_expand" * 2 ) ),( "oq4_arena_frame::bar" * "oq4_arena_frame::open" )
		visible	"Desktop::arena_presentVisible"
		backcolor	0.005,0.008,0.005,0.98
		noevents	1
	}

	windowDef oq4_arena_letterbox_bottom
	{
		rect	( 0 - "gui::virtual_screen_x_expand" ),( ( 480 + "gui::virtual_screen_y_expand" ) - ( "oq4_arena_frame::bar" * "oq4_arena_frame::open" ) ),( 640 + ( "gui::virtual_screen_x_expand" * 2 ) ),( "oq4_arena_frame::bar" * "oq4_arena_frame::open" )
		visible	"Desktop::arena_presentVisible"
		backcolor	0.005,0.008,0.005,0.98
		noevents	1
	}

	// The rules sit at the fully open frame edge and stay put while the bars
	// grow out to meet them; their own fade carries the reveal.
	windowDef oq4_arena_rule_top
	{
		rect	64,( "oq4_arena_frame::top" + 6 ),512,1
