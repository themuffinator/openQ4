		// openQ4: the Remastered kill feed (ui-visual-design.md 14.9) from the game's
		// oq4_feed fields: top trailing, four lines (two under Tourney's strip), each on
		// its own plate at 0.35, or the header-band plate at 0.30 when it involves you.
		// Attacker, the Quad mark, the weapon in its color code (a skull for suicides
		// and the world, the telefrag mark), a TEAM tag on a team kill, then the
		// victim; names cut at 84 u, white for you and in the team's text color in
		// team modes. The game times the lines; the player HUD's stock feed stays
		// empty outside Classic.
		windowDef oq4_feed
		{
			rect	0,0,640,480
			screenalignx	right
			screenaligny	top
