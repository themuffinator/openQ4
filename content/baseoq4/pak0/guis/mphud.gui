		// openQ4: the Remastered top-leading group (ui-visual-design.md 14.9) outside
		// Classic: the team panels with their flags, alive pips and the Dead Zone
		// plate; the timer, under the standing or panels, or under Tourney's message
		// bar; and the plates in its column. Minimal hides it.
		windowDef oq4_rem_tl
		{
			rect	0,0,640,480
			screenalignx	left
			screenaligny	top
			noclip	1
			visible	"gui::oq4_hudRemastered" * "gui::oq4_hudShowExtras"
			// openQ4: the Remastered flags' beat (ui-visual-design.md 14.9): matcolor_w runs
			// 0 to 1 over 250 ms and back over 750 ms, once a second. A taken flag grows
			// with it by the stock pulse's 34/28, and the one flag swings to its carrier's
			// team color.
			windowDef oq4_flag_beat
			{
				rect	0,0,1,1
				visible	0
				matcolor	1,1,1,0

				onTime 0 {
					transition "oq4_flag_beat::matcolor" "1,1,1,0" "1,1,1,1" "250" ;
				}

				onTime 250 {
					transition "oq4_flag_beat::matcolor" "1,1,1,1" "1,1,1,0" "750" ;
				}

				onTime 1000 {
					resetTime "0" ;
				}

			}
