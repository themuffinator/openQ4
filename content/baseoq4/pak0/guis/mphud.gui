	windowDef event_arenaDone
	{
		rect	0,0,1,1
		visible	1

		onNamedEvent arenaDone {
			if ( "gui::round" == 1 ) {
				if ( "gui::bracket" == 1 ) {
					transition "hover_round1_bracket1::matcolor" "$desktop::blue" "$desktop::blue_4" "500" ;
