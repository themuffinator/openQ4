windowDef Desktop
{
	rect		0,0,640,480
	menugui		1
	noclip		1
	float		"demo_browserOpening"	0
	float		"demo_browserClosing"	0
	float		"demo_playbackOpening"	0

	onActivate {
		if ( "gui::demo_browserMode" == 1 ) {
			// Demos enters through the same short rail-and-list reveal used by
			// the stock save browser, rather than appearing as an unrelated page.
			set "Desktop::demo_browserOpening" "1" ;
			set "Desktop::demo_browserClosing" "0" ;
			setfocus "demo_browser_transition_blocker" ;
			resetTime "demo_browser_reveal_timeline" "0" ;
		} else if ( "gui::demo_interactive" == 1 && "gui::demo_browserMode" == 0 ) {
			// Playback returns immediately to the world, but its controls still
			// rise in on the same measured cadence as the browser page.
			set "Desktop::demo_playbackOpening" "1" ;
			setfocus "demo_playback_transition_input_blocker" ;
			resetTime "demo_playback_reveal_timeline" "0" ;
		}
	}

	onESC {
		if ( "gui::demo_browserMode" == 1 && "gui::demo_interactive" == 1 && "Desktop::demo_browserOpening" != 1 && "Desktop::demo_browserClosing" != 1 ) {
			set "Desktop::demo_browserClosing" "1" ;
			setfocus "demo_browser_transition_blocker" ;
			resetTime "demo_browser_exit_timeline" "0" ;
		} else if ( "gui::demo_interactive" == 1 && "gui::demo_browserMode" == 0 ) {
			set "cmd" "demoClose" ;
		}
	}

	// Browser backdrop, the retained pages' own: black, the stock screen's light
	// band across the middle and a quiet grid, the same at every width.
	windowDef demo_browser_backdrop
	{
		rect		( 0 - "gui::virtual_screen_x_expand" ),( 0 - "gui::virtual_screen_y_expand" ),( 640 + ( "gui::virtual_screen_x_expand" * 2 ) ),( 480 + ( "gui::virtual_screen_y_expand" * 2 ) )
		visible		( "gui::demo_browserMode" == 1 && "gui::demo_interactive" == 1 )
		backcolor	0,0,0,1
		noevents	1
	}

	windowDef demo_browser_screen
	{
		rect		( 0 - "gui::virtual_screen_x_expand" ),( 0 - "gui::virtual_screen_y_expand" ),( 640 + ( "gui::virtual_screen_x_expand" * 2 ) ),( 480 + ( "gui::virtual_screen_y_expand" * 2 ) )
		visible		( "gui::demo_browserMode" == 1 && "gui::demo_interactive" == 1 )
		background	"gfx/guis/mainmenu/screen"
		matcolor	0.64,0.64,0.64,1
		noevents	1
	}

	windowDef demo_browser_grid
	{
		rect		( 0 - "gui::virtual_screen_x_expand" ),( 0 - "gui::virtual_screen_y_expand" ),( 640 + ( "gui::virtual_screen_x_expand" * 2 ) ),( 480 + ( "gui::virtual_screen_y_expand" * 2 ) )
		visible		( "gui::demo_browserMode" == 1 && "gui::demo_interactive" == 1 )
		background	"gfx/guis/loading/bg_grid_tiled"
		matcolor	0.35,0.42,0.22,0.16
		naturalmatscale	1
		noevents	1
	}

	windowDef demo_browser_topbar
	{
		rect		-77,-63,1045,129
		visible		( "gui::demo_browserMode" == 1 && "gui::demo_interactive" == 1 )
		noclip		1
		background	"gfx/guis/mainmenu/topbar"
		matcolor	1,1,1,0.9
		noevents	1

