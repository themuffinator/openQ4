		listDef demoList
		{
			rect		216,99,404,300
			visible		1
			listname	demoList
			itemheight	20
			scrollbar	1
			tabValigns	"0,0,0,0,0,0"
			tabaligns	"0,0,0,0,0,0"
			tabstops	"0,136,188,284,348,420,600"
			backgroundHover	"gfx/guis/mainmenu/bg_hover"
			backgroundLine	"gfx/guis/mainmenu/bg_line"
			backgroundFocus	"gfx/guis/mainmenu/bg_focus"
			backgroundGreyed	"gfx/guis/mainmenu/bg_line"
			forecolor	0.92,0.94,0.88,1
			hovercolor	1,0.66,0.18,1
			textscale	0.18
			font		"fonts/lowpixel"

			onMouseEnter {
				set "cmd" "play main_menu_mouseover" ;
			}

			onAction {
				set "cmd" "play main_menu_selection ; demoSelect" ;
			}

			onEnter {
				if ( "gui::demo_canPlay" == 1 ) {
					set "cmd" "play main_menu_selection ; demoPlay" ;
				}
			}
		}

		windowDef demo_browser_close_plate
		{
			rect		532,441,109,30
			background	"gfx/guis/mainmenu/b4_light"
			matcolor	0.545,0.588,0.294,0.4
			noevents	1
		}

		windowDef demo_browser_close_corner
		{
			rect		542,449,11,11
			background	"gfx/guis/mainmenu/corner"
			matcolor	0.564,0.603,0.286,0.4
			noevents	1
		}

		windowDef demo_browser_close_title
		{
			rect		552,443,88,17
			forecolor	1,1,1,0.8
			text		"#str_42005"
			textscale	0.28
			font		"fonts/marine"
			noevents	1
		}

		windowDef demo_browser_close
		{
			rect		536,444,105,23

			onMouseEnter {
				stoptransitions "demo_browser_close" ;
				set "demo_browser_close_plate::matcolor_w" "0.8" ;
				transition "demo_browser_close_title::forecolor" "1,1,1,0.8" "0.890,0.537,0,1" "0" ;
				transition "demo_browser_close_corner::matcolor" "0.564,0.603,0.286,0.4" "0.890,0.537,0,1" "0" ;
				set "demo_browser_close_title::textscale" "0.29" ;
				set "cmd" "play main_menu_mouseover" ;
			}

			onMouseExit {
				transition "demo_browser_close_plate::matcolor_w" "0.8" "0.4" "300" ;
				transition "demo_browser_close_title::forecolor" "0.890,0.537,0,1" "1,1,1,0.8" "300" ;
				transition "demo_browser_close_corner::matcolor" "0.890,0.537,0,1" "0.564,0.603,0.286,0.4" "300" ;
				transition "demo_browser_close_title::textscale" "0.29" "0.28" "300" ;
			}

			onAction {
				if ( "Desktop::demo_browserOpening" != 1 && "Desktop::demo_browserClosing" != 1 ) {
					set "cmd" "play main_menu_selection" ;
					set "Desktop::demo_browserClosing" "1" ;
					setfocus "demo_browser_transition_blocker" ;
					resetTime "demo_browser_exit_timeline" "0" ;
				}
			}
		}
	}

	// The browser uses a short shared curtain for enter/leave.  It preserves the
	// direct, responsive list behavior while making the page feel like a sibling
	// of Load Game rather than a separate application.
	windowDef demo_browser_transition_curtain
	{
		rect		( 0 - "gui::virtual_screen_x_expand" ),( 0 - "gui::virtual_screen_y_expand" ),( 640 + ( "gui::virtual_screen_x_expand" * 2 ) ),( 480 + ( "gui::virtual_screen_y_expand" * 2 ) )
		visible		( "Desktop::demo_browserOpening" == 1 || "Desktop::demo_browserClosing" == 1 )
		backcolor	0,0,0,0
		noevents	1
	}

	windowDef demo_browser_transition_blocker
	{
		rect		( 0 - "gui::virtual_screen_x_expand" ),( 0 - "gui::virtual_screen_y_expand" ),( 640 + ( "gui::virtual_screen_x_expand" * 2 ) ),( 480 + ( "gui::virtual_screen_y_expand" * 2 ) )
		visible		( "Desktop::demo_browserOpening" == 1 || "Desktop::demo_browserClosing" == 1 )
		backcolor	0,0,0,0

		onAction {
			setfocus "demo_browser_transition_blocker" ;
		}

		onESC {
			setfocus "demo_browser_transition_blocker" ;
		}
	}

	windowDef demo_browser_reveal_timeline
	{
		rect		0,0,1,1
		visible		1
		notime		1

		onTime 0 {
			stopTransitions "demo_browser_transition_curtain" ;
			stopTransitions "demo_browser" ;
			set "demo_browser_transition_curtain::backcolor" "0,0,0,0.86" ;
			set "demo_browser::rect" "32,0,640,480" ;
			transition "demo_browser_transition_curtain::backcolor" "0,0,0,0.86" "0,0,0,0" "360" ;
			transition "demo_browser::rect" "32,0,640,480" "0,0,640,480" "320" ;
		}

		onTime 380 {
			set "Desktop::demo_browserOpening" "0" ;
			setfocus "demoList" ;
		}
	}

	windowDef demo_browser_exit_timeline
	{
		rect		0,0,1,1
		visible		1
		notime		1

		onTime 0 {
			stopTransitions "demo_browser_transition_curtain" ;
			stopTransitions "demo_browser" ;
			set "demo_browser_transition_curtain::backcolor" "0,0,0,0" ;
			transition "demo_browser_transition_curtain::backcolor" "0,0,0,0" "0,0,0,1" "260" ;
			transition "demo_browser::rect" "0,0,640,480" "-32,0,640,480" "240" ;
		}

		onTime 280 {
			set "cmd" "demoClose" ;
			set "Desktop::demo_browserClosing" "0" ;
		}
	}

	// The playback deck is deliberately faster than a page change: it rises a
	// short distance from the lower rail, then releases focus to its controls.
	windowDef demo_playback_transition_blocker
	{
		rect		( 0 - "gui::virtual_screen_x_expand" ),( 0 - "gui::virtual_screen_y_expand" ),( 640 + ( "gui::virtual_screen_x_expand" * 2 ) ),( 480 + ( "gui::virtual_screen_y_expand" * 2 ) )
		visible		( "Desktop::demo_playbackOpening" == 1 )
		backcolor	0,0,0,0

		onAction {
			setfocus "demo_playback_transition_blocker" ;
		}

		onESC {
			setfocus "demo_playback_transition_blocker" ;
		}
	}

	windowDef demo_playback_reveal_timeline
	{
		rect		0,0,1,1
		visible		1
		notime		1

		onTime 0 {
			stopTransitions "demo_playback" ;
			stopTransitions "demo_playback_deck_surface" ;
			stopTransitions "demo_playback_deck_line" ;
			stopTransitions "demo_playback_reveal_curtain" ;
			set "demo_playback::rect" "0,300,640,204" ;
			set "demo_playback::backcolor" "0.015,0.02,0.018,0" ;
			set "demo_playback::bordercolor" "0.32,0.36,0.2,0" ;
			set "demo_playback_deck_surface::matcolor" "0.12,0.15,0.09,0" ;
			set "demo_playback_deck_line::matcolor" "0.95,0.49,0.06,0" ;
			set "demo_playback_reveal_curtain::backcolor" "0,0,0,1" ;
			transition "demo_playback::rect" "0,300,640,204" "0,276,640,204" "200" ;
			transition "demo_playback::backcolor" "0.015,0.02,0.018,0" "0.015,0.02,0.018,0.94" "180" ;
			transition "demo_playback::bordercolor" "0.32,0.36,0.2,0" "0.32,0.36,0.2,1" "180" ;
			transition "demo_playback_deck_surface::matcolor" "0.12,0.15,0.09,0" "0.12,0.15,0.09,0.88" "180" ;
			transition "demo_playback_deck_line::matcolor" "0.95,0.49,0.06,0" "0.95,0.49,0.06,0.68" "180" ;
		}

		onTime 220 {
			// The deck has settled before any child text or controls can appear;
			// this also masks the fixed wide-screen surface while the inner card
			// rises the final few pixels.
			transition "demo_playback_reveal_curtain::backcolor" "0,0,0,1" "0,0,0,0" "120" ;
		}

		onTime 360 {
			set "Desktop::demo_playbackOpening" "0" ;
			setfocus "demo_playback_close" ;
		}
	}

