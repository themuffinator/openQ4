	// Root-level ordering matters for GUI hit testing: this is defined after all
	// controls, so the opening deck cannot accept a stray mouse click while the
	// visual curtain is still releasing.
	windowDef demo_playback_reveal_curtain
	{
		rect		( 0 - "gui::virtual_screen_x_expand" ),276,( 640 + ( "gui::virtual_screen_x_expand" * 2 ) ),204
		visible		( "Desktop::demo_playbackOpening" == 1 )
		backcolor	0,0,0,1
		screenalignx	middle
		screenaligny	bottom
		noevents	1
	}

	windowDef demo_playback_transition_input_blocker
	{
		rect		( 0 - "gui::virtual_screen_x_expand" ),( 0 - "gui::virtual_screen_y_expand" ),( 640 + ( "gui::virtual_screen_x_expand" * 2 ) ),( 480 + ( "gui::virtual_screen_y_expand" * 2 ) )
		visible		( "Desktop::demo_playbackOpening" == 1 )
		backcolor	0,0,0,0

		onAction {
			setfocus "demo_playback_transition_input_blocker" ;
		}

		onESC {
			setfocus "demo_playback_transition_input_blocker" ;
		}
	}
}
