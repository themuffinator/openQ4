// Experimental level editor workspace; stock Quake 4 artwork only.
// Generated by tools/ui/build_level_editor_gui.py; edit the generator.
windowDef Desktop {
 rect 0,0,640,480
 menugui 1
 backcolor 0.025,0.032,0.02,1
 definevec4 white_8 1,1,1,0.8
 definevec4 orange 0.890,0.537,0,1
 definevec4 orange_4 0.890,0.537,0,0.4
 onESC {
  if ( "gui::ed_confirm" == 1 ) { set "cmd" "editorExperimentalAction cancel"; }
  else { set "cmd" "editorExperimentalAction hide"; }
 }
 onNamedEvent workspaceConfirm { setFocus "confirm_cancel"; }
 onNamedEvent workspaceResume { setFocus "edBrowser"; }
