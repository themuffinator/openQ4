 "events": {
  "team_slot_0": [
   {
    "op": "if",
    "condition": {"state": "mp.action0.available"},
    "then": [{"op": "setState", "values": {"card.team_action": 0}}, {"op": "action", "action": "mpTeamAction"}],
    "else": [{"op": "playTimeline", "timeline": "shake-team-slot-0"}]
   }
  ],
  "team_slot_1": [
   {
    "op": "if",
    "condition": {"state": "mp.action1.available"},
    "then": [{"op": "setState", "values": {"card.team_action": 1}}, {"op": "action", "action": "mpTeamAction"}],
    "else": [{"op": "playTimeline", "timeline": "shake-team-slot-1"}]
   }
  ],
  "team_slot_2": [
   {
    "op": "if",
    "condition": {"state": "mp.action2.available"},
    "then": [{"op": "setState", "values": {"card.team_action": 2}}, {"op": "action", "action": "mpTeamAction"}],
    "else": [{"op": "playTimeline", "timeline": "shake-team-slot-2"}]
   }
  ],
