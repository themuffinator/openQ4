  "tab_vote": [
   {
    "op": "if",
    "condition": {"op": "!=", "args": [{"state": "card.tab"}, 2]},
    "then": [
     {
      "op": "if",
      "condition": {"state": "cvar.s_voiceChatTest"},
      "then": [{"op": "action", "action": "voiceTestStop"}]
     },
     {"op": "setState", "values": {"card.leaving": {"state": "card.tab"}, "card.tab": 2}},
     {"op": "playTimeline", "timeline": "show-vote"},
     {
      "op": "if",
      "condition": {"state": "mp.vote.yes.available"},
      "then": [{"op": "focus", "control": "vote-yes"}],
      "else": [
       {
        "op": "if",
        "condition": {
         "op": "&&",
         "args": [{"state": "mp.vote.map.row_allowed"}, {"op": ">", "args": [{"state": "mp.vote.map_count"}, 0]}]
        },
        "then": [{"op": "focus", "control": "vote-row-map"}],
        "else": [{"op": "focus", "control": "vote-call"}]
       }
      ]
     }
    ]
   }
