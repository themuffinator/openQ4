  "tab_join": [
   {
    "op": "if",
    "condition": {"op": "!=", "args": [{"state": "card.tab"}, 0]},
    "then": [
     {"op": "setState", "values": {"card.leaving": {"state": "card.tab"}, "card.tab": 0}},
     {"op": "playTimeline", "timeline": "show-join"},
     {
      "op": "if",
      "condition": {"state": "mp.welcome.team_mode"},
      "then": [{"op": "focus", "control": "join-slot-2"}],
      "else": [{"op": "focus", "control": "join-solo-0"}]
     }
    ]
   }
  ],
  "tab_server": [
   {
    "op": "if",
    "condition": {"op": "!=", "args": [{"state": "card.tab"}, 1]},
