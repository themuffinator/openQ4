     {"op": "playTimeline", "timeline": "show-players"},
     {"op": "focus", "control": "tab-players"},
     {
      "op": "if",
      "condition": {
       "op": ">",
       "args": [
        {
         "op": "+",
         "args": [
          {
           "op": "+",
           "args": [
            {
             "op": "+",
             "args": [
              0,
              {
               "op": "+",
               "args": [
                {"op": "select", "args": [{"state": "mp.players.a.shown"}, 22.0, 0]},
                {"op": "*", "args": [{"state": "mp.players.a.count"}, 24.0]}
               ]
              }
             ]
            },
            {
             "op": "+",
             "args": [
              {"op": "select", "args": [{"state": "mp.players.b.shown"}, 28.0, 0]},
              {"op": "*", "args": [{"state": "mp.players.b.count"}, 24.0]}
             ]
            }
           ]
          },
          {
           "op": "+",
           "args": [
            {"op": "select", "args": [{"op": ">", "args": [{"state": "mp.players.s.count"}, 0]}, 28.0, 0]},
            {"op": "*", "args": [{"state": "mp.players.s.count"}, 24.0]}
           ]
          }
         ]
        },
        309.0
       ]
      },
      "then": [{"op": "focus", "control": "players-scroll"}]
     }
    ]
   }
  ],
  "tab_settings": [
   {
    "op": "if",
    "condition": {"op": "!=", "args": [{"state": "card.tab"}, 3]},
    "then": [
     {"op": "setState", "values": {"card.leaving": {"state": "card.tab"}, "card.tab": 3}},
     {"op": "playTimeline", "timeline": "show-settings"},
     {"op": "focus", "control": "settings-name"}
    ]
   }
  ],
  "pageShown": [{"op": "setState", "values": {"card.leaving": -1}}],
  "onTabPrevious": [
   {
    "op": "if",
    "condition": {"op": "==", "args": [{"state": "card.tab"}, 0]},
    "then": [{"op": "call", "event": "tab_settings"}],
    "else": [
     {
      "op": "if",
      "condition": {"op": "==", "args": [{"state": "card.tab"}, 1]},
