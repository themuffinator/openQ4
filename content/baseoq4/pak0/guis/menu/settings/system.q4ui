    "then": [{"op": "action", "action": "autoDetect"}]
   }
  ],
  "resetSizes": [
   {
    "op": "if",
    "condition": {
     "op": "&&",
     "args": [
      {
       "op": "&&",
       "args": [
        {
         "op": "&&",
         "args": [
          {
           "op": "&&",
           "args": [
            {"op": "&&", "args": [{"state": "settings.open"}, {"op": "==", "args": [{"state": "settings.phase"}, 1]}]},
            {"op": "!", "args": [{"state": "settings.busy"}]}
           ]
          },
          {"op": "!", "args": [{"state": "settings.confirmationVisible"}]}
         ]
        },
        {"op": "!", "args": [{"state": "page.discardVisible"}]}
       ]
      },
      {"op": "!", "args": [{"state": "ui.numberDraftsPending"}]}
     ]
    },
    "then": [{"op": "action", "action": "resetSizes"}]
   }
  ],
  "restartRenderer": [
   {
    "op": "if",
    "condition": {
     "op": "&&",
     "args": [
      {
       "op": "&&",
       "args": [
        {
         "op": "&&",
         "args": [
          {
           "op": "&&",
           "args": [
            {
             "op": "&&",
             "args": [
              {"op": "&&", "args": [{"state": "settings.open"}, {"op": "==", "args": [{"state": "settings.phase"}, 1]}]},
              {"op": "!", "args": [{"state": "settings.busy"}]}
             ]
            },
            {"op": "!", "args": [{"state": "settings.confirmationVisible"}]}
           ]
          },
          {"op": "!", "args": [{"state": "page.discardVisible"}]}
         ]
        },
        {"op": "!", "args": [{"state": "ui.numberDraftsPending"}]}
       ]
      },
      {"state": "settings.render.canRestart"}
     ]
    },
    "then": [{"op": "action", "action": "restartRenderer"}]
   }
  ],
  "tab_graphics": [
   {
    "op": "if",
    "condition": {
     "op": "!",
     "args": [
      {
       "op": "||",
       "args": [
        {"op": "||", "args": [{"state": "settings.confirmationVisible"}, {"state": "page.discardVisible"}]},
        {"state": "ui.numberDraftsPending"}
       ]
      }
     ]
    },
    "then": [
     {
      "op": "if",
      "condition": {"op": "!=", "args": [{"state": "page.tab"}, 0]},
      "then": [
       {"op": "setState", "values": {"page.leaving": {"state": "page.tab"}, "page.tab": 0}},
       {"op": "playTimeline", "timeline": "show-graphics"},
       {"op": "focus", "control": "settings_preset"}
      ]
     }
    ]
   }
  ],
  "tab_screen": [
   {
    "op": "if",
    "condition": {
     "op": "!",
     "args": [
      {
       "op": "||",
       "args": [
        {"op": "||", "args": [{"state": "settings.confirmationVisible"}, {"state": "page.discardVisible"}]},
        {"state": "ui.numberDraftsPending"}
       ]
      }
     ]
    },
    "then": [
     {
      "op": "if",
      "condition": {"op": "!=", "args": [{"state": "page.tab"}, 1]},
      "then": [
       {"op": "setState", "values": {"page.leaving": {"state": "page.tab"}, "page.tab": 1}},
       {"op": "playTimeline", "timeline": "show-screen"},
       {
        "op": "if",
        "condition": {
         "op": "&&",
         "args": [
          {"state": "settings.display.available"},
          {
           "op": "||",
           "args": [
            {
             "op": "||",
             "args": [
              {"op": ">", "args": [{"state": "settings.display.count"}, 1]},
              {"op": ">=", "args": [{"state": "settings.draft.r_screen"}, {"state": "settings.display.count"}]}
             ]
            },
            {"op": "!=", "args": [{"state": "settings.draft.r_screen"}, {"state": "settings.baseline.r_screen"}]}
           ]
          }
         ]
        },
        "then": [{"op": "focus", "control": "settings_display_device"}],
        "else": [
         {
          "op": "if",
          "condition": {
           "op": "&&",
           "args": [
            {"state": "settings.display.available"},
            {
             "op": "||",
             "args": [
              {
               "op": "||",
               "args": [
                {"op": ">", "args": [{"state": "settings.display.count"}, 1]},
                {"op": "!=", "args": [{"state": "settings.draft.r_multiScreen"}, 0]}
               ]
              },
              {
               "op": "!=",
               "args": [{"state": "settings.draft.r_multiScreen"}, {"state": "settings.baseline.r_multiScreen"}]
              }
             ]
            }
           ]
          },
          "then": [{"op": "focus", "control": "settings_multiscreen"}],
          "else": [{"op": "focus", "control": "settings_fullscreen"}]
         }
        ]
       }
      ]
     }
    ]
   }
  ],
  "tab_image": [
