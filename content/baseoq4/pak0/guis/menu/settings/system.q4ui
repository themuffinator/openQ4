  "events": {
    "onActivate": [
      {
        "op": "setState",
        "values": {
          "page.discardVisible": false
        }
      },
      {
        "op": "action",
        "action": "begin"
      }
    ],
    "onBack": [
      {
        "op": "if",
        "condition": {
          "state": "page.discardVisible"
        },
        "then": [
          {
            "op": "setState",
            "values": {
              "page.discardVisible": false
            }
          }
        ],
        "else": [
          {
            "op": "if",
            "condition": {
              "op": "&&",
              "args": [
                {
                  "op": "!",
                  "args": [
                    {
                      "state": "settings.busy"
                    }
                  ]
                },
                {
                  "op": "||",
                  "args": [
                    {
                      "op": "==",
                      "args": [
                        {
                          "state": "settings.phase"
                        },
                        0
                      ]
                    },
                    {
                      "op": "==",
                      "args": [
                        {
                          "state": "settings.phase"
                        },
                        1
                      ]
                    }
                  ]
                }
              ]
            },
            "then": [
              {
                "op": "if",
                "condition": {
                  "state": "settings.dirty"
                },
                "then": [
                  {
                    "op": "setState",
                    "values": {
                      "page.discardVisible": true
                    }
                  }
                ],
                "else": [
                  {
                    "op": "action",
                    "action": "dismiss"
                  }
                ]
              }
            ]
          }
        ]
      }
    ],
    "discard": [
      {
        "op": "if",
        "condition": {
          "op": "&&",
          "args": [
            {
              "op": "&&",
              "args": [
                {
                  "state": "settings.open"
                },
                {
                  "op": "==",
                  "args": [
                    {
                      "state": "settings.phase"
                    },
                    1
                  ]
                }
              ]
            },
            {
              "op": "!",
              "args": [
                {
                  "state": "settings.busy"
                }
              ]
            }
          ]
        },
        "then": [
          {
            "op": "action",
            "action": "discard"
          },
          {
            "op": "setState",
            "values": {
              "page.discardVisible": false
            }
          }
        ]
      }
    ],
    "continueEditing": [
      {
        "op": "setState",
        "values": {
          "page.discardVisible": false
        }
      }
    ]
  },
