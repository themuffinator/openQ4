 "events": {
  "onBack": [
   {
    "op": "if",
    "condition": {"state": "page.discardVisible"},
    "then": [{"op": "call", "event": "continueEditing"}],
    "else": [
     {
      "op": "if",
      "condition": {
       "op": "&&",
       "args": [
        {"op": "!", "args": [{"state": "settings.busy"}]},
        {
         "op": "||",
         "args": [
          {"op": "==", "args": [{"state": "settings.phase"}, 0]},
          {"op": "==", "args": [{"state": "settings.phase"}, 1]}
         ]
        }
       ]
      },
      "then": [
       {
        "op": "if",
        "condition": {"op": "||", "args": [{"state": "settings.dirty"}, {"state": "ui.numberDraftsPending"}]},
        "then": [{"op": "setState", "values": {"page.discardVisible": true}}],
        "else": [{"op": "action", "action": "dismiss"}]
       }
      ]
     }
    ]
   }
  ],
  "onMenuButton": [
   {
    "op": "if",
    "condition": {"state": "settings.confirmationVisible"},
    "then": [{"op": "call", "event": "confirmationBack"}],
    "else": [
     {
      "op": "if",
      "condition": {"state": "page.discardVisible"},
      "then": [{"op": "call", "event": "continueEditing"}],
      "else": [
       {
        "op": "if",
        "condition": {"state": "ui.numberDraftsPending"},
        "then": [{"op": "action", "action": "focusNumberDraft"}],
        "else": [
         {
          "op": "if",
          "condition": {"state": "settings.dirty"},
          "then": [{"op": "call", "event": "apply"}],
          "else": [{"op": "call", "event": "onBack"}]
         }
        ]
       }
      ]
     }
    ]
   }
  ],
  "discard": [
   {
    "op": "if",
    "condition": {
     "op": "&&",
     "args": [
      {
       "op": "&&",
       "args": [
        {"state": "page.discardVisible"},
        {
         "op": "&&",
         "args": [
          {"op": "!", "args": [{"state": "settings.busy"}]},
          {"op": "!", "args": [{"state": "settings.confirmationVisible"}]}
         ]
        }
       ]
      },
      {
       "op": "||",
       "args": [
        {"op": "&&", "args": [{"state": "settings.open"}, {"op": "==", "args": [{"state": "settings.phase"}, 1]}]},
        {
         "op": "&&",
         "args": [
          {
           "op": "&&",
           "args": [{"op": "!", "args": [{"state": "settings.open"}]}, {"op": "==", "args": [{"state": "settings.phase"}, 0]}]
          },
          {"state": "ui.numberDraftsPending"}
         ]
        }
       ]
      }
     ]
    },
    "then": [
     {"op": "action", "action": "cancel"},
     {"op": "setState", "values": {"page.discardVisible": false}},
     {"op": "action", "action": "dismiss"}
    ]
   }
  ],
  "continueEditing": [{"op": "setState", "values": {"page.discardVisible": false}}, {"op": "action", "action": "focusNumberDraft"}],
  "applyExit": [
   {
    "op": "if",
    "condition": {
     "op": "&&",
     "args": [
      {
       "op": "&&",
       "args": [
        {
         "op": "&&",
         "args": [
          {
           "op": "&&",
           "args": [
            {"state": "page.discardVisible"},
            {
             "op": "&&",
             "args": [
              {"op": "!", "args": [{"state": "settings.busy"}]},
              {"op": "!", "args": [{"state": "settings.confirmationVisible"}]}
             ]
            }
           ]
          },
          {"op": "&&", "args": [{"state": "settings.open"}, {"op": "==", "args": [{"state": "settings.phase"}, 1]}]}
         ]
        },
        {"state": "settings.dirty"}
       ]
      },
      {
       "op": "&&",
       "args": [{"state": "settings.canApply"}, {"op": "!", "args": [{"state": "ui.numberDraftsPending"}]}]
      }
     ]
    },
    "then": [{"op": "setState", "values": {"page.discardVisible": false}}, {"op": "action", "action": "applyExit"}]
   }
  ],
  "confirmationBack": [{"op": "if", "condition": {"state": "settings.canRevert"}, "then": [{"op": "action", "action": "revert"}]}],
  "apply": [
   {
    "op": "if",
    "condition": {
     "op": "&&",
     "args": [{"state": "settings.canApply"}, {"op": "!", "args": [{"state": "ui.numberDraftsPending"}]}]
    },
    "then": [{"op": "action", "action": "apply"}]
   }
  ],
  "autoDetect": [
   {
    "op": "if",
    "condition": {
     "op": "&&",
     "args": [
      {
       "op": "&&",
       "args": [
        {
         "op": "&&",
         "args": [
          {
           "op": "&&",
           "args": [
            {
             "op": "&&",
             "args": [
              {"op": "&&", "args": [{"state": "settings.open"}, {"op": "==", "args": [{"state": "settings.phase"}, 1]}]},
              {"op": "!", "args": [{"state": "settings.busy"}]}
             ]
            },
            {"op": "!", "args": [{"state": "settings.confirmationVisible"}]}
           ]
          },
          {"op": "!", "args": [{"state": "page.discardVisible"}]}
         ]
        },
        {"op": "!", "args": [{"state": "ui.numberDraftsPending"}]}
       ]
      },
