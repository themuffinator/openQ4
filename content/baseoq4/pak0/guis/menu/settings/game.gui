			windowDef p_settings_game
			{
				rect	0,0,640,480
				visible	0
				windowDef set_game_title
				{
					rect	259,82,326,13
					visible	1
					forecolor	1,1,1,0.4
					text	"#str_200084"
					textscale	0.2
					font	"fonts/lowpixel"
				}
				windowDef set_game_section
				{
					rect	204,104,377,16
					visible	1
					windowDef set_game_section_background
					{
						rect	0,0,377,16
						visible	1
						background	"gfx/guis/mainmenu/b3_light"
						matcolor	0.545,0.588,0.294,0.25
					}
					windowDef set_game_section_description
					{
						rect	31,1,142,14
						visible	1
						forecolor	1,1,1,0.65
						text	"#str_229959"
						textscale	0.2
						font	"fonts/lowpixel"
					}
					choiceDef set_game_section_choice
					{
						rect	154,1,223,14
						visible	1
						forecolor	1,0.745,0.137,0.8
						gui	game_section_choice
						textscale	0.2
						font	"fonts/lowpixel"
						choices	"#str_229960"
						values	"0;1;2;3;4;5;6;7"
						choiceType	1

						onAction {
							set "cmd" "play main_menu_selection" ;
						}

						onActionRelease {
							if ( "gui::game_section_choice" == 0 ) {
								set "gui::gui_set_game_scroll" "0" ;
							} else if ( "gui::game_section_choice" == 1 ) {
								set "gui::gui_set_game_scroll" "11" ;
							} else if ( "gui::game_section_choice" == 2 ) {
								set "gui::gui_set_game_scroll" "21" ;
							} else if ( "gui::game_section_choice" == 3 ) {
								set "gui::gui_set_game_scroll" "41" ;
							} else if ( "gui::game_section_choice" == 4 ) {
								set "gui::gui_set_game_scroll" "48" ;
							} else if ( "gui::game_section_choice" == 5 ) {
								set "gui::gui_set_game_scroll" "60" ;
							} else if ( "gui::game_section_choice" == 6 ) {
								set "gui::gui_set_game_scroll" "66" ;
							} else {
								set "gui::gui_set_game_scroll" "73" ;
							}
							set "cmd" "applySettingsScroll game" ;
						}
					}
				}
