				sliderDef set_game_scroll_thumb
				{
					rect	613,128,16,256
					visible	0
					background	"gfx/guis/scrollbarv"
					forecolor	1,1,1,0.8
					matcolor	1,1,1,0.4
					low	0
					high	78
					step	1
					vertical	1
					scrollbar	1
					thumbShader	"gfx/guis/scrollbar_thumb"
					cvar	gui_set_game_scroll

					onAction {
						set "cmd" "applySettingsScroll game" ;
