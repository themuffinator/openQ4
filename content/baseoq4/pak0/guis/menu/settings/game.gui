	//==============================================================//

				windowDef set_game_xhaircolor
				{
					rect  228,1162,377,25
					visible 1
											
					windowDef set_game_xhaircolor_background
					{
						rect	0,0,377,25
						visible	1
						background	"gfx/guis/mainmenu/b3_light"
						matcolor	0.545,0.588,0.294,0.4
					}
					windowDef set_game_xhaircolor_description
					{
						rect	31,3,210,18
						visible	1
						forecolor	1,1,1,0.8
						text	"#str_200299"
						textscale	0.24
						font	"fonts/lowpixel"
					}
					choiceDef set_game_xhaircolor_value
					{
						rect	240,3,162,18
						visible	1
						forecolor	1,0.745,0.137,0.8
						gui	g_crosshairColorChoice
						textscale	0.24
						font	"fonts/lowpixel"
						choices	"#str_229942"
						choiceType	0

						onAction {
							set "cmd" "play main_menu_selection" ;
						}

						onActionRelease {
							if ( "gui::g_crosshairColorChoice" == 0 ) {
								set "gui::cvar_g_crosshairColor_r" "1" ;
								set "gui::cvar_g_crosshairColor_g" "1" ;
								set "gui::cvar_g_crosshairColor_b" "1" ;
								consoleCMD "g_crosshairColor 1 1 1 1" ;
							} else if ( "gui::g_crosshairColorChoice" == 1 ) {
								set "gui::cvar_g_crosshairColor_r" "1" ;
								set "gui::cvar_g_crosshairColor_g" "0" ;
								set "gui::cvar_g_crosshairColor_b" "0" ;
								consoleCMD "g_crosshairColor 1 0 0 1" ;
							} else if ( "gui::g_crosshairColorChoice" == 2 ) {
								set "gui::cvar_g_crosshairColor_r" "1" ;
								set "gui::cvar_g_crosshairColor_g" "0.5" ;
								set "gui::cvar_g_crosshairColor_b" "0" ;
								consoleCMD "g_crosshairColor 1 0.5 0 1" ;
							} else if ( "gui::g_crosshairColorChoice" == 3 ) {
								set "gui::cvar_g_crosshairColor_r" "1" ;
								set "gui::cvar_g_crosshairColor_g" "1" ;
								set "gui::cvar_g_crosshairColor_b" "0" ;
								consoleCMD "g_crosshairColor 1 1 0 1" ;
							} else if ( "gui::g_crosshairColorChoice" == 4 ) {
								set "gui::cvar_g_crosshairColor_r" "0" ;
								set "gui::cvar_g_crosshairColor_g" "1" ;
								set "gui::cvar_g_crosshairColor_b" "0" ;
								consoleCMD "g_crosshairColor 0 1 0 1" ;
							} else if ( "gui::g_crosshairColorChoice" == 5 ) {
								set "gui::cvar_g_crosshairColor_r" "0" ;
								set "gui::cvar_g_crosshairColor_g" "1" ;
								set "gui::cvar_g_crosshairColor_b" "1" ;
								consoleCMD "g_crosshairColor 0 1 1 1" ;
							} else if ( "gui::g_crosshairColorChoice" == 6 ) {
								set "gui::cvar_g_crosshairColor_r" "0" ;
								set "gui::cvar_g_crosshairColor_g" "0" ;
								set "gui::cvar_g_crosshairColor_b" "1" ;
								consoleCMD "g_crosshairColor 0 0 1 1" ;
							} else if ( "gui::g_crosshairColorChoice" == 7 ) {
								set "gui::cvar_g_crosshairColor_r" "1" ;
								set "gui::cvar_g_crosshairColor_g" "0" ;
								set "gui::cvar_g_crosshairColor_b" "0.5" ;
								consoleCMD "g_crosshairColor 1 0 0.5 1" ;
							}
							namedevent "p_settings::crosshairColor" ;
						}
					}
					windowDef set_game_xhaircolor_xcolor0
					{
