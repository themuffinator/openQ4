 "events": {
  "onSecondary": [{"op": "action", "action": "controlsClear"}],
  "controllerTestRumble": [{"op": "action", "action": "controlsRumbleTest"}],
  "controllerTestModalShow": [
   {"op": "setState", "values": {"controllerTestModal.visible": true, "controllerTestModal.contents": false}},
   {"op": "playTimeline", "timeline": "controllerTestModalEnter"}
  ],
  "controllerTestModalShown": [
   {"op": "setState", "values": {"controllerTestModal.contents": true}},
   {"op": "playTimeline", "timeline": "controllerTestModalEnergy"}
  ],
  "controllerTestModalHide": [
   {"op": "setState", "values": {"controllerTestModal.contents": false}},
   {"op": "playTimeline", "timeline": "controllerTestModalLeave"},
   {"op": "cancelTimeline", "timeline": "controllerTestModalEnergy", "policy": "base"}
  ],
  "controllerTestModalHidden": [{"op": "setState", "values": {"controllerTestModal.visible": false}}],
  "tab_move": [
   {"op": "setState", "values": {"page.tab": 0, "touch.list": false}},
   {"op": "focus", "control": "controls_bind_0"}
  ],
  "tab_weapons": [
   {"op": "setState", "values": {"page.tab": 1, "touch.list": false}},
   {"op": "focus", "control": "controls_bind_10"}
  ],
  "tab_attack": [
   {"op": "setState", "values": {"page.tab": 2, "touch.list": false}},
   {"op": "focus", "control": "controls_bind_24"}
  ],
  "tab_other": [
   {"op": "setState", "values": {"page.tab": 3, "touch.list": false}},
   {"op": "focus", "control": "controls_bind_38"}
  ],
  "tab_mouse": [
   {"op": "setState", "values": {"page.tab": 4, "touch.list": false}},
   {
    "op": "if",
    "condition": {"op": "&&", "args": [{"state": "controls.touchLayout"}, {"op": "!", "args": [{"state": "view.mouse"}]}]},
    "then": [{"op": "focus", "control": "controls_touchcontrols"}],
    "else": [{"op": "focus", "control": "controls_freelook"}]
   }
  ],
  "tab_controller": [
   {"op": "setState", "values": {"page.tab": 5, "touch.list": false}},
   {"op": "focus", "control": "controls_controller"}
  ],
  "tab_aim": [
   {"op": "setState", "values": {"page.tab": 6, "touch.list": false}},
   {
    "op": "if",
    "condition": {"state": "cvar.in_joystick"},
    "then": [{"op": "focus", "control": "controls_response"}],
    "else": [{"op": "focus", "control": "controls_touchscreen"}]
   }
  ],
  "touchPlaced": [{"op": "setState", "values": {"touch.list": false}}],
  "touchBack": [
   {
    "op": "if",
    "condition": {"op": "!", "args": [{"state": "touch.list"}]},
    "then": [{"op": "setState", "values": {"touch.list": true}}, {"op": "focus", "control": "touch-tab-move"}],
    "else": [{"op": "action", "action": "back"}]
   }
  ],
  "onBack": [
   {
    "op": "if",
    "condition": {"op": "!", "args": [{"state": "touch.list"}]},
    "then": [{"op": "setState", "values": {"touch.list": true}}, {"op": "focus", "control": "touch-tab-move"}],
    "else": [{"op": "action", "action": "back"}]
   }
  ],
  "onActivate": [{"op": "setState", "values": {"touch.list": true}}, {"op": "focus", "control": "touch-tab-move"}]
 },
