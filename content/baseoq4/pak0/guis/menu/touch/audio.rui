    },
    "paths": [
     {
      "id": "fill",
      "commands": [
       {"id": "p0", "op": "move", "points": [[0, 0]]},
       {"id": "p1", "op": "line", "points": [[{"fraction": 1}, 0]]},
       {"id": "p2", "op": "line", "points": [[{"fraction": 1}, {"fraction": 1}]]},
       {"id": "p3", "op": "line", "points": [[0, {"fraction": 1}]]},
       {"id": "close", "op": "close"}
      ],
      "fill": {
       "type": "linear",
       "from": [0, 0],
       "to": [0, {"fraction": 1}],
