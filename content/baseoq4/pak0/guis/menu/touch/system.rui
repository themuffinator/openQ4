 "extensions": {
  "openq4": {
   "scope": "The SYSTEM settings page, generated by tools/ui/retained_system.py: a SETTINGS sub-page whose GRAPHICS, SCREEN, IMAGE QUALITY and EFFECTS tabs edit the settings service's draft, applied with APPLY CHANGES and confirmed with Keep or Revert. Every stock setting works here, so ui_retained opens it; ui_retainedSystem opens it without ui_retained.",
   "sourceContract": "docs/dev/ui/system-settings-contract.md",
   "visualContract": "docs/dev/ui-visual-design.md",
   "numberFields": {
    "pairs": {"settings_brightness": "settings_brightness_number", "settings_ambient": "settings_ambient_number"},
    "proposalPolicy": "Explicit typed commit to the same settings draft; no slider-step quantization.",
    "scope": "Each slider's typed number shares its row; the adapter holds typed text as a number draft until Enter commits it, and Apply waits for every draft."
   },
   "presets": {
    "source": "src/framework/PerformancePreset.cpp",
    "scope": "Source-backed preset and Auto-Detect draft editing. Apply runs the batch as one journaled attempt: one device restart, a sound restart for a layout or EFX change, and the status notice #str_230076 while the draft holds a change that finishes at the next start.",
    "localization": ["#str_229976", "#str_229977", "#str_229978"],
    "proposalPolicy": "Popup highlight is transient. Selected value follows authoritative draft readback before acknowledgement."
   },
   "interfaceSettings": {
    "scope": "UI and text sizes edit the SYSTEM draft and take effect through Apply. Reset sizes changes only these two draft values.",
    "localization": ["#str_230015", "#str_230016", "#str_230017", "#str_230018", "#str_230019"],
    "catalogVersion": 2
   },
   "displayControls": {
    "scope": "Display Device, Expand Across Displays, Window Mode and MSAA edit the draft. Window Mode sets r_fullscreen, r_borderless and r_fullscreenDesktop in one patch. Apply uses owned Keep/Revert recovery; unsupported device requests do not bypass validation.",
    "displayLists": "settings.display.* keys from system_display_catalog.py: owner-only lists the settings service builds from the display topology.",
    "deviceRow": "Auto and the device list slots; hidden on one display unless the draft names a display the list lacks or holds a change not yet applied, and hidden without lists.",
    "spanRow": "No or Yes over r_multiScreen; spanning needs the list to allow it and a borderless window or desktop fullscreen, and a line under the row says which is missing.",
    "msaaAvailability": "Read-only renderer observation; an unavailable renderer disables MSAA.",
    "localization": [
     "#str_229900",
     "#str_229912",
     "#str_229914",
     "#str_229915",
     "#str_200059",
     "#str_230088",
     "#str_230089",
     "#str_232926",
     "#str_232927",
     "#str_41093",
     "#str_230020"
    ]
   },
   "dimensionControls": {
    "source": "Legacy custom-size entry selects r_mode=-1; new selection and dimension changes share one owned draft patch.",
    "validation": "Exact decimal integers within renderer bounds; intermediate size tuples remain drafts and cannot Apply until the complete display request validates.",
    "availability": "Window size is editable in a windowed, bordered draft. Custom fullscreen size, Display Resolution and Refresh Rate are editable with Exclusive policy.",
    "lists": "Display Resolution and Refresh Rate pick a slot of the published mode and refresh lists with the list token (display.mode, display.refresh)."
   },
   "renderOptions": {
    "scope": "Preload Light Grids edits the draft; Apply completes it without Keep/Revert and the next map load uses it. The status line names what the loaded map does with its light grids.",
    "confirmationTitle": {"recoveryPhase": 3, "recovery": "#str_230077", "otherwise": "#str_229993"},
    "preloadRow": {
     "control": "settings_lightgrid_preload",
     "setting": "r_lightGridPreload",
     "status": {"pending": "#str_230078", "preloads": "#str_230079", "streams": "#str_230080", "noGrids": "#str_230081"}
    },
    "rendererRow": {
     "control": "settings_renderer",
     "setting": "r_renderer",
     "values": ["best", "arb2"],
     "fallbackNotice": "#str_230082"
    },
    "localization": [
     "#str_229993",
     "#str_230077",
     "#str_230073",
     "#str_230074",
     "#str_230075",
     "#str_230076",
     "#str_42820",
     "#str_42821",
     "#str_230078",
     "#str_230079",
     "#str_230080",
     "#str_230081",
     "#str_41103",
     "#str_41104",
     "#str_230082"
    ]
   }
  }
 }
