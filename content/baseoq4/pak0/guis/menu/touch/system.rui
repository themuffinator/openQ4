  ],
  "touchLeave": [
   {
    "op": "if",
    "condition": {"state": "page.discardVisible"},
    "then": [{"op": "call", "event": "continueEditing"}],
    "else": [
     {
      "op": "if",
      "condition": {
       "op": "&&",
       "args": [
        {"op": "!", "args": [{"state": "settings.busy"}]},
        {
         "op": "||",
         "args": [
          {"op": "==", "args": [{"state": "settings.phase"}, 0]},
          {"op": "==", "args": [{"state": "settings.phase"}, 1]}
         ]
        }
       ]
      },
      "then": [
       {
        "op": "if",
        "condition": {"op": "||", "args": [{"state": "settings.dirty"}, {"state": "ui.numberDraftsPending"}]},
        "then": [{"op": "setState", "values": {"page.discardVisible": true}}],
        "else": [{"op": "action", "action": "dismiss"}]
       }
      ]
     }
    ]
   }
  ],
  "tab_graphics": [
   {
    "op": "if",
    "condition": {
     "op": "!",
     "args": [
      {
       "op": "||",
       "args": [
        {"op": "||", "args": [{"state": "settings.confirmationVisible"}, {"state": "page.discardVisible"}]},
        {"state": "ui.numberDraftsPending"}
       ]
      }
     ]
    },
    "then": [
     {"op": "setState", "values": {"page.tab": 0, "touch.list": false}},
     {"op": "focus", "control": "settings_preset"}
    ]
   }
  ],
  "tab_screen": [
   {
    "op": "if",
    "condition": {
     "op": "!",
     "args": [
      {
       "op": "||",
       "args": [
        {"op": "||", "args": [{"state": "settings.confirmationVisible"}, {"state": "page.discardVisible"}]},
        {"state": "ui.numberDraftsPending"}
       ]
      }
     ]
    },
    "then": [
     {"op": "setState", "values": {"page.tab": 1, "touch.list": false}},
     {
      "op": "if",
      "condition": {
       "op": "&&",
       "args": [
        {"state": "settings.display.available"},
        {
         "op": "||",
         "args": [
          {
           "op": "||",
           "args": [
            {"op": ">", "args": [{"state": "settings.display.count"}, 1]},
            {"op": ">=", "args": [{"state": "settings.draft.r_screen"}, {"state": "settings.display.count"}]}
           ]
          },
          {"op": "!=", "args": [{"state": "settings.draft.r_screen"}, {"state": "settings.baseline.r_screen"}]}
         ]
        }
       ]
      },
      "then": [{"op": "focus", "control": "settings_display_device"}],
      "else": [
       {
        "op": "if",
        "condition": {
         "op": "&&",
         "args": [
          {"state": "settings.display.available"},
          {
           "op": "||",
           "args": [
            {
             "op": "||",
             "args": [
              {"op": ">", "args": [{"state": "settings.display.count"}, 1]},
              {"op": "!=", "args": [{"state": "settings.draft.r_multiScreen"}, 0]}
             ]
            },
            {
             "op": "!=",
             "args": [{"state": "settings.draft.r_multiScreen"}, {"state": "settings.baseline.r_multiScreen"}]
            }
           ]
          }
         ]
        },
        "then": [{"op": "focus", "control": "settings_multiscreen"}],
        "else": [{"op": "focus", "control": "settings_window_mode"}]
       }
      ]
     }
    ]
   }
  ],
  "tab_image": [
   {
    "op": "if",
    "condition": {
     "op": "!",
     "args": [
      {
       "op": "||",
       "args": [
        {"op": "||", "args": [{"state": "settings.confirmationVisible"}, {"state": "page.discardVisible"}]},
        {"state": "ui.numberDraftsPending"}
       ]
      }
     ]
    },
    "then": [
     {"op": "setState", "values": {"page.tab": 2, "touch.list": false}},
     {"op": "focus", "control": "settings_brightness"}
    ]
   }
  ],
  "tab_effects": [
   {
    "op": "if",
    "condition": {
