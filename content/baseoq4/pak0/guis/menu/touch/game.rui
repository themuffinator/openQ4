 "events": {
  "vrSetupModalShow": [
   {"op": "setState", "values": {"vrSetupModal.visible": true, "vrSetupModal.contents": false}},
   {"op": "playTimeline", "timeline": "vrSetupModalEnter"}
  ],
  "vrSetupModalShown": [
