   {"op": "focus", "control": "game_viewkick"}
  ],
  "tab_vr": [{"op": "setState", "values": {"page.tab": 4, "touch.list": false}}, {"op": "focus", "control": "game_vr"}],
  "touchPlaced": [{"op": "setState", "values": {"touch.list": false}}],
  "touchBack": [
   {
    "op": "if",
    "condition": {"op": "!", "args": [{"state": "touch.list"}]},
    "then": [{"op": "setState", "values": {"touch.list": true}}, {"op": "focus", "control": "touch-tab-general"}],
    "else": [{"op": "action", "action": "back"}]
   }
  ],
  "onBack": [
   {
    "op": "if",
    "condition": {"op": "!", "args": [{"state": "touch.list"}]},
    "then": [{"op": "setState", "values": {"touch.list": true}}, {"op": "focus", "control": "touch-tab-general"}],
    "else": [{"op": "action", "action": "back"}]
   }
  ],
  "onActivate": [
   {
    "op": "if",
    "condition": {"state": "game.languageReloaded"},
    "then": [
     {"op": "setState", "values": {"page.tab": 0, "page.leaving": -1}},
     {"op": "playTimeline", "timeline": "place-general"},
     {"op": "focus", "control": "game_language"}
    ],
    "else": [
     {
      "op": "if",
      "condition": {"op": "==", "args": [{"state": "view.variant"}, "vr"]},
      "then": [
       {"op": "setState", "values": {"page.tab": 4, "page.leaving": -1}},
       {"op": "playTimeline", "timeline": "place-vr"},
       {"op": "focus", "control": "game_vr"}
      ],
      "else": [{"op": "setState", "values": {"touch.list": true}}, {"op": "focus", "control": "touch-tab-general"}]
     }
    ]
   }
  ]
