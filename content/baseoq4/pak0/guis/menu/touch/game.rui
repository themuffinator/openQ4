   {"op": "playTimeline", "timeline": "vrSetupModalEnergy"}
  ],
  "vrSetupModalHide": [
   {"op": "setState", "values": {"vrSetupModal.contents": false}},
   {"op": "playTimeline", "timeline": "vrSetupModalLeave"},
   {"op": "cancelTimeline", "timeline": "vrSetupModalEnergy", "policy": "base"}
  ],
  "vrSetupModalHidden": [{"op": "setState", "values": {"vrSetupModal.visible": false}}],
  "tab_general": [
   {"op": "setState", "values": {"page.tab": 0, "touch.list": false}},
   {"op": "focus", "control": "game_autoreload"}
