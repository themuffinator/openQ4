	// A common black-frame handoff makes the Single Player hierarchy feel like a
	// continuation of the stock main menu instead of a collection of hard GUI
	// swaps.  It also gives keyboard/controller focus one safe owner throughout.
	windowDef arena_navigation_curtain
	{
		rect		( 0 - "gui::virtual_screen_x_expand" ),( 0 - "gui::virtual_screen_y_expand" ),( 640 + ( "gui::virtual_screen_x_expand" * 2 ) ),( 480 + ( "gui::virtual_screen_y_expand" * 2 ) )
		visible		( "Desktop::arena_navigationAnimating" == 1 )
		backcolor	0,0,0,0
		noevents	1
	}

	windowDef arena_mode_reveal_timeline
	{
		rect		0,0,1,1
		visible		1
		notime		1

		onTime 0 {
			stopTransitions "arena_mode_reveal_timeline" ;
			set "arena_navigation_curtain::backcolor" "0,0,0,0.86" ;
			set "arena_mode_selector::rect" "36,0,640,480" ;
			transition "arena_navigation_curtain::backcolor" "0,0,0,0.86" "0,0,0,0" "360" ;
			transition "arena_mode_selector::rect" "36,0,640,480" "0,0,640,480" "320" ;
		}

		onTime 380 {
			set "Desktop::arena_navigationAnimating" "0" ;
			set "Desktop::arena_focusContext" "-1" ;
		}
	}

	windowDef arena_mode_exit_timeline
	{
		rect		0,0,1,1
		visible		1
		notime		1

		onTime 0 {
			stopTransitions "arena_mode_exit_timeline" ;
			set "arena_navigation_curtain::backcolor" "0,0,0,0" ;
			transition "arena_navigation_curtain::backcolor" "0,0,0,0" "0,0,0,1" "260" ;
			transition "arena_mode_selector::rect" "0,0,640,480" "-36,0,640,480" "240" ;
		}

		onTime 280 {
			if ( "Desktop::arena_navigationAction" == 1 ) {
				set "cmd" "arenaBrowse" ;
				resetTime "arena_browser_entry_timeline" "0" ;
			} else if ( "Desktop::arena_navigationAction" == 2 ) {
				set "cmd" "arenaCampaigns" ;
			} else {
				set "cmd" "arenaClose" ;
			}
		}
	}

	windowDef arena_browser_entry_timeline
	{
		rect		0,0,1,1
		visible		1
		notime		1

		onTime 0 {
			stopTransitions "arena_browser_entry_timeline" ;
			set "Desktop::arena_navigationAnimating" "1" ;
			set "arena_navigation_curtain::backcolor" "0,0,0,1" ;
			set "arena_browser::rect" "36,0,640,480" ;
			transition "arena_navigation_curtain::backcolor" "0,0,0,1" "0,0,0,0" "380" ;
			transition "arena_browser::rect" "36,0,640,480" "0,0,640,480" "340" ;
		}

		onTime 400 {
			set "Desktop::arena_navigationAnimating" "0" ;
			set "Desktop::arena_focusContext" "-1" ;
		}
	}

	windowDef arena_browser_exit_timeline
	{
		rect		0,0,1,1
		visible		1
		notime		1

		onTime 0 {
			stopTransitions "arena_browser_exit_timeline" ;
			set "arena_navigation_curtain::backcolor" "0,0,0,0" ;
			transition "arena_navigation_curtain::backcolor" "0,0,0,0" "0,0,0,1" "260" ;
			transition "arena_browser::rect" "0,0,640,480" "36,0,640,480" "240" ;
		}

		onTime 280 {
			set "cmd" "arenaBackToModes" ;
			resetTime "arena_mode_return_timeline" "0" ;
		}
	}

	windowDef arena_mode_return_timeline
	{
		rect		0,0,1,1
		visible		1
		notime		1

		onTime 0 {
			stopTransitions "arena_mode_return_timeline" ;
			set "arena_navigation_curtain::backcolor" "0,0,0,1" ;
			set "arena_mode_selector::rect" "-36,0,640,480" ;
			transition "arena_navigation_curtain::backcolor" "0,0,0,1" "0,0,0,0" "380" ;
			transition "arena_mode_selector::rect" "-36,0,640,480" "0,0,640,480" "340" ;
		}

		onTime 400 {
			set "Desktop::arena_navigationAnimating" "0" ;
			set "Desktop::arena_focusContext" "-1" ;
		}
	}

	// Match launch: the selected card becomes a short ceremonial handoff before
	// the server starts.  Framework timing owns the launch, so this animation is
	// decorative and can never strand the player if a GUI fails to tick.
	windowDef arena_launch_shade
	{
		rect		( 0 - "gui::virtual_screen_x_expand" ),( 0 - "gui::virtual_screen_y_expand" ),( 640 + ( "gui::virtual_screen_x_expand" * 2 ) ),( 480 + ( "gui::virtual_screen_y_expand" * 2 ) )
		visible		"Desktop::arena_launchVisible"
		backcolor	0,0,0,0
		noevents	1
	}

	windowDef arena_launch_panel
	{
		rect		320,226,0,4
		visible		"Desktop::arena_launchVisible"
		backcolor	0.018,0.024,0.017,0.98
		bordercolor	0.95,0.49,0.06,0.9
		bordersize	1
		noclip		0

		windowDef arena_launch_levelshot
		{
			rect		1,1,494,218
			background	"gui::arena_levelshot"
			matcolor	0.3,0.34,0.24,0.52
			noevents	1
		}

		windowDef arena_launch_inner_shade
		{
			rect		1,1,494,218
			backcolor	0.01,0.015,0.01,0.68
			noevents	1
		}

		windowDef arena_launch_kicker
		{
			rect		32,24,430,20
			forecolor	0.95,0.72,0.25,1
			text		"#str_42079"
			textscale	0.2
			textalign	1
			font		"fonts/lowpixel"
			noevents	1
		}

		windowDef arena_launch_title
		{
			rect		24,56,446,48
			forecolor	1,0.96,0.82,1
			text		"gui::arena_selectedTitle"
			textscale	0.44
			textalign	1
			font		"fonts/marine"
			noevents	1
		}

		windowDef arena_launch_rule
		{
			rect		72,111,350,2
			backcolor	0.95,0.49,0.06,0.9
			noevents	1
		}

		windowDef arena_launch_gametype
		{
			rect		32,127,430,20
			forecolor	0.86,0.9,0.76,1
			text		"gui::arena_selectedGameType"
			textscale	0.2
			textalign	1
			font		"fonts/lowpixel"
			noevents	1
		}

		windowDef arena_launch_map
		{
			rect		32,153,430,17
			forecolor	0.63,0.69,0.52,1
			text		"gui::arena_selectedMap"
			textscale	0.16
			textalign	1
			font		"fonts/lowpixel"
			noevents	1
		}

		windowDef arena_launch_ready
		{
			rect		32,188,430,17
			forecolor	0.95,0.49,0.06,1
			text		"#str_42086"
			textscale	0.16
			textalign	1
			font		"fonts/lowpixel"
			noevents	1
		}

		// The panel grows from a pinpoint.  Hold its nested imagery and type
		// behind this front layer until there is a real card to read, instead of
		// clipping the title through the expanding edge.
		windowDef arena_launch_entry_curtain
		{
			rect		1,1,494,218
			backcolor	0,0,0,1
			noevents	1
		}

		// This last child owns the exit, so nested title and levelshot content
		// cannot outlive the panel's fade by a bright frame.
		windowDef arena_launch_exit_curtain
		{
			rect		1,1,494,218
			backcolor	0,0,0,0
			noevents	1
		}
	}

	windowDef arena_launch_timeline
	{
		rect		0,0,1,1
		visible		1
		notime		1

		onTime 0 {
			stopTransitions "arena_launch_timeline" ;
			set "arena_launch_panel::rect" "320,226,0,4" ;
			set "arena_launch_panel::backcolor" "0.018,0.024,0.017,0.98" ;
			set "arena_launch_panel::bordercolor" "0.95,0.49,0.06,0.9" ;
			set "arena_launch_entry_curtain::backcolor" "0,0,0,1" ;
			set "arena_launch_exit_curtain::backcolor" "0,0,0,0" ;
			if ( "Desktop::arena_resultAction" == 2 ) {
				set "arena_launch_shade::backcolor" "0,0,0,1" ;
				transition "arena_launch_shade::backcolor" "0,0,0,1" "0,0,0,0.72" "320" ;
			} else {
				set "arena_launch_shade::backcolor" "0,0,0,0" ;
				transition "arena_launch_shade::backcolor" "0,0,0,0" "0,0,0,0.72" "320" ;
			}
			transition "arena_launch_panel::rect" "320,226,0,4" "72,120,496,220" "480" ;
		}

		onTime 360 {
			transition "arena_launch_entry_curtain::backcolor" "0,0,0,1" "0,0,0,0" "140" ;
		}

		onTime 760 {
			transition "arena_launch_shade::backcolor" "0,0,0,0.72" "0,0,0,1" "500" ;
			transition "arena_launch_exit_curtain::backcolor" "0,0,0,0" "0,0,0,1" "320" ;
			transition "arena_launch_panel::backcolor" "0.018,0.024,0.017,0.98" "0.018,0.024,0.017,0" "380" ;
			transition "arena_launch_panel::bordercolor" "0.95,0.49,0.06,0.9" "0.95,0.49,0.06,0" "380" ;
		}

		onTime 1250 {
			set "Desktop::arena_launchVisible" "0" ;
		}
	}

	// Match result overlay.
	// The ledger owns the screen while it is up.  idWindow::HandleEvent walks
	// children in reverse, so arena_result_panel still gets its own buttons and
	// this full-screen shade absorbs everything that misses them; without it the
	// browser's back and reset controls stay clickable behind the report.
	// Blocking is done by returning a command rather than with "modal", because
	// BringToTop reorders modal windows to the front of the event walk and this
	// shade would then swallow the report's own buttons after one stray click.
	windowDef arena_result_shade
	{
		rect		( 0 - "gui::virtual_screen_x_expand" ),( 0 - "gui::virtual_screen_y_expand" ),( 640 + ( "gui::virtual_screen_x_expand" * 2 ) ),( 480 + ( "gui::virtual_screen_y_expand" * 2 ) )
		visible		( "gui::arena_result" != 0 )
		backcolor	0,0,0,0

		// Absorbing the click also takes keyboard focus, and the onEvent focus
		// machine above only re-focuses when the context changes.  Clear it so
		// the recommended action is refocused instead of being stranded.
		onAction {
			set "Desktop::arena_focusContext" "-1" ;
			set "cmd" "arenaBlockInput" ;
		}
	}

