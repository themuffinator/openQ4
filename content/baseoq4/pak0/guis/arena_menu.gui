	windowDef arena_result_reveal_timeline
	{
		rect		0,0,1,1
		visible		1
		notime		1

		onTime 0 {
			stopTransitions "arena_result_reveal_timeline" ;
			set "Desktop::arena_resultPhase" "0" ;
			set "Desktop::arena_resultReady" "0" ;
			set "arena_result_curtain::backcolor" "0,0,0,1" ;
			set "arena_result_shade::backcolor" "0,0,0,0" ;
			set "arena_result_panel::rect" "320,240,0,0" ;
			set "arena_result_panel::backcolor" "0.025,0.032,0.024,0" ;
			set "arena_result_panel::bordercolor" "0.48,0.53,0.29,0" ;
			transition "arena_result_shade::backcolor" "0,0,0,0" "0,0,0,0.82" "420" ;
			transition "arena_result_panel::rect" "320,240,0,0" "122,91,396,298" "520" ;
			transition "arena_result_panel::backcolor" "0.025,0.032,0.024,0" "0.025,0.032,0.024,0.99" "420" ;
			transition "arena_result_panel::bordercolor" "0.48,0.53,0.29,0" "0.48,0.53,0.29,1" "420" ;
			transition "arena_result_curtain::backcolor" "0,0,0,1" "0,0,0,0" "720" ;
		}

		onTime 260 {
			set "Desktop::arena_resultPhase" "1" ;
		}

		onTime 610 {
			set "Desktop::arena_resultPhase" "2" ;
		}

		onTime 930 {
			set "Desktop::arena_resultPhase" "3" ;
		}

		onTime 1260 {
			set "Desktop::arena_resultPhase" "4" ;
			set "Desktop::arena_resultReady" "1" ;
			set "Desktop::arena_focusContext" "-1" ;
		}
	}

	windowDef arena_result_exit_timeline
	{
		rect		0,0,1,1
		visible		1
		notime		1

		// "$window::var" resolves once, when the gui is parsed, so it yields the
		// authored value and never the live one.  Sourcing the exit from it left
		// the curtain snapping straight to opaque black and hid the whole staged
		// collapse behind it.  The report is only dismissable after the reveal
		// timeline has finished, so its settled values are exact here.
		onTime 0 {
			set "Desktop::arena_resultReady" "0" ;
			setfocus "arena_transition_blocker" ;
			stopTransitions "arena_result_exit_timeline" ;
			transition "arena_result_curtain::backcolor" "0,0,0,0" "0,0,0,1" "180" ;
		}

		onTime 180 {
			set "Desktop::arena_resultPhase" "0" ;
			transition "arena_result_panel::rect" "122,91,396,298" "320,240,0,0" "420" ;
			transition "arena_result_panel::backcolor" "0.025,0.032,0.024,0.99" "0.025,0.032,0.024,0" "340" ;
			transition "arena_result_panel::bordercolor" "0.48,0.53,0.29,1" "0.48,0.53,0.29,0" "340" ;
			transition "arena_result_shade::backcolor" "0,0,0,0.82" "0,0,0,1" "360" ;
		}

		onTime 620 {
			if ( "Desktop::arena_resultAction" == 2 ) {
				set "cmd" "arenaRetry" ;
			} else {
				set "cmd" "arenaDismissResult" ;
			}
		}
	}

	// Drawn after the report so the held engine wipe can be released into an
	// identical black frame; the complete ledger is then revealed beneath it.
	windowDef arena_result_curtain
	{
		rect		( 0 - "gui::virtual_screen_x_expand" ),( 0 - "gui::virtual_screen_y_expand" ),( 640 + ( "gui::virtual_screen_x_expand" * 2 ) ),( 480 + ( "gui::virtual_screen_y_expand" * 2 ) )
		visible		( "gui::arena_result" != 0 )
		backcolor	0,0,0,1
		noevents	1
	}

	// After a newly recorded win the result panel gives way to the actual
	// campaign board.  The exact completed match, tier gate, and progress delta
	// are highlighted instead of silently appearing in their final state.
	windowDef arena_progress_update_shade
	{
		rect		( 0 - "gui::virtual_screen_x_expand" ),( 0 - "gui::virtual_screen_y_expand" ),( 640 + ( "gui::virtual_screen_x_expand" * 2 ) ),( 480 + ( "gui::virtual_screen_y_expand" * 2 ) )
		visible		"Desktop::arena_progressAnimating"
		backcolor	0,0,0,0
		noevents	1
	}

