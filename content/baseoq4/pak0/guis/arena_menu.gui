			visible		( ( "gui::arena_result" == 2 || "gui::arena_result" == 3 ) && "gui::arena_resultCanRetry" == 1 && "Desktop::arena_resultPhase" >= 4 )
			backcolor	0.34,0.19,0.035,0.98
