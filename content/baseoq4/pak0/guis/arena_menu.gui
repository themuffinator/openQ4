	windowDef arena_progress_reveal_timeline
	{
		rect		0,0,1,1
		visible		1
		notime		1

		onTime 0 {
			stopTransitions "arena_progress_reveal_timeline" ;
			set "arena_progress_update_shade::backcolor" "0,0,0,1" ;
			set "arena_progress_update_panel::rect" "320,231,0,0" ;
			set "arena_progress_update_panel::backcolor" "0.018,0.027,0.017,0" ;
			set "arena_progress_update_panel::bordercolor" "0.55,0.82,0.3,0" ;
			set "arena_progress_tier_pulse::backcolor" "0.55,0.82,0.3,0" ;
			set "arena_progress_tier_pulse::bordercolor" "0.72,1,0.42,0" ;
			set "arena_progress_match_pulse::backcolor" "0.55,0.82,0.3,0" ;
			set "arena_progress_match_pulse::bordercolor" "0.72,1,0.42,0" ;
			set "arena_progress_boss_pulse::backcolor" "0.95,0.49,0.06,0" ;
			set "arena_progress_boss_pulse::bordercolor" "1,0.74,0.24,0" ;
			set "arena_progress_gain::backcolor" "0.72,1,0.42,0" ;
			set "arena_progress_entry_curtain::backcolor" "0,0,0,1" ;
			set "arena_progress_exit_curtain::backcolor" "0,0,0,0" ;
			transition "arena_progress_update_shade::backcolor" "0,0,0,1" "0,0,0,0.48" "420" ;
			transition "arena_progress_update_panel::rect" "320,231,0,0" "110,169,420,124" "480" ;
			transition "arena_progress_update_panel::backcolor" "0.018,0.027,0.017,0" "0.018,0.027,0.017,0.98" "420" ;
			transition "arena_progress_update_panel::bordercolor" "0.55,0.82,0.3,0" "0.55,0.82,0.3,1" "420" ;
		}

		onTime 360 {
			transition "arena_progress_entry_curtain::backcolor" "0,0,0,1" "0,0,0,0" "140" ;
		}

		// Let the report be read before it clears.  The target card flashes only
		// after the toast has folded away, so it cannot be hidden behind its own
		// progress panel on later match rows.
		onTime 900 {
			transition "arena_progress_exit_curtain::backcolor" "0,0,0,0" "0,0,0,1" "140" ;
		}

		// Sourced from the settled values this same timeline reached at onTime 0;
		// a "$window::var" source would be the authored hidden state and would
		// make the toast vanish in one frame instead of folding away.
		onTime 1040 {
			transition "arena_progress_update_panel::backcolor" "0.018,0.027,0.017,0.98" "0.018,0.027,0.017,0" "200" ;
			transition "arena_progress_update_panel::bordercolor" "0.55,0.82,0.3,1" "0.55,0.82,0.3,0" "200" ;
			transition "arena_progress_update_panel::rect" "110,169,420,124" "320,231,0,0" "220" ;
			transition "arena_progress_update_shade::backcolor" "0,0,0,0.48" "0,0,0,0" "220" ;
		}

		onTime 1080 {
			transition "arena_progress_tier_pulse::backcolor" "0.55,0.82,0.3,0" "0.55,0.82,0.3,0.28" "200" ;
			transition "arena_progress_tier_pulse::bordercolor" "0.72,1,0.42,0" "0.72,1,0.42,1" "200" ;
			transition "arena_progress_match_pulse::backcolor" "0.55,0.82,0.3,0" "0.55,0.82,0.3,0.28" "200" ;
			transition "arena_progress_match_pulse::bordercolor" "0.72,1,0.42,0" "0.72,1,0.42,1" "200" ;
			transition "arena_progress_gain::backcolor" "0.72,1,0.42,0" "0.72,1,0.42,1" "220" ;
		}

		onTime 1200 {
			transition "arena_progress_boss_pulse::backcolor" "0.95,0.49,0.06,0" "0.95,0.49,0.06,0.34" "160" ;
			transition "arena_progress_boss_pulse::bordercolor" "1,0.74,0.24,0" "1,0.74,0.24,1" "160" ;
		}

		onTime 1360 {
			transition "arena_progress_tier_pulse::backcolor" "0.55,0.82,0.3,0.28" "0.55,0.82,0.3,0" "180" ;
			transition "arena_progress_tier_pulse::bordercolor" "0.72,1,0.42,1" "0.72,1,0.42,0" "180" ;
			transition "arena_progress_match_pulse::backcolor" "0.55,0.82,0.3,0.28" "0.55,0.82,0.3,0" "180" ;
			transition "arena_progress_match_pulse::bordercolor" "0.72,1,0.42,1" "0.72,1,0.42,0" "180" ;
			transition "arena_progress_boss_pulse::backcolor" "0.95,0.49,0.06,0.34" "0.95,0.49,0.06,0" "180" ;
			transition "arena_progress_boss_pulse::bordercolor" "1,0.74,0.24,1" "1,0.74,0.24,0" "180" ;
			transition "arena_progress_gain::backcolor" "0.72,1,0.42,1" "0.72,1,0.42,0" "180" ;
		}

		onTime 1540 {
			set "Desktop::arena_progressAnimating" "0" ;
			set "Desktop::arena_focusContext" "-1" ;
		}
	}

	// Losses, draws, and replays have no progression delta to celebrate, but
	// still return through a deliberate black-to-browser reveal instead of
	// dropping the result overlay in a single frame.
	windowDef arena_browser_reveal_curtain
	{
		rect		( 0 - "gui::virtual_screen_x_expand" ),( 0 - "gui::virtual_screen_y_expand" ),( 640 + ( "gui::virtual_screen_x_expand" * 2 ) ),( 480 + ( "gui::virtual_screen_y_expand" * 2 ) )
		visible		"Desktop::arena_browserRevealing"
		backcolor	0,0,0,1
		noevents	1
	}

	windowDef arena_browser_reveal_timeline
	{
		rect		0,0,1,1
		visible		1
		notime		1

		onTime 0 {
			stopTransitions "arena_browser_reveal_timeline" ;
			set "arena_browser_reveal_curtain::backcolor" "0,0,0,1" ;
			transition "arena_browser_reveal_curtain::backcolor" "0,0,0,1" "0,0,0,0" "720" ;
		}

		onTime 760 {
			set "Desktop::arena_browserRevealing" "0" ;
			set "Desktop::arena_focusContext" "-1" ;
		}
	}

	// Destructive progress reset keeps the familiar Quake 4 confirmation shell,
	// then gives it a short modern frame-by-frame reveal.  The stock slices make
	// the warning feel native to the menu while the red accent preserves its
	// stronger campaign-specific meaning.
	// Blocking rather than noevents: a destructive prompt must not let a stray
	// click reach the browser underneath, and noevents made this shade invisible
	// to the event walk instead of stopping it.  arena_reset_panel is a later
	// sibling, so the confirm and cancel buttons are still reached first.
	windowDef arena_reset_shade
	{
		rect		( 0 - "gui::virtual_screen_x_expand" ),( 0 - "gui::virtual_screen_y_expand" ),( 640 + ( "gui::virtual_screen_x_expand" * 2 ) ),( 480 + ( "gui::virtual_screen_y_expand" * 2 ) )
		visible		( "Desktop::arena_resetPresentation" != 0 )
		backcolor	0,0,0,0

		// Absorbing the click also takes keyboard focus, and the onEvent focus
		// machine above only re-focuses when the context changes.  Clear it so
		// the recommended action is refocused instead of being stranded.
		onAction {
			set "Desktop::arena_focusContext" "-1" ;
			set "cmd" "arenaBlockInput" ;
		}
	}

	windowDef arena_reset_panel
	{
		rect		0,0,640,480
		visible		( "Desktop::arena_resetPresentation" != 0 )
		noclip		1

		// The full stock shell expands from its own centre, so the warning grows
		// across both axes without stretching the fixed campaign copy and buttons.
		// Its smoked olive body belongs to the stock popup family; only the thin
		// warning stripe and destructive action carry the Arena danger colour.
		windowDef arena_reset_shell
		{
			rect		140,33,360,400
			noclip		0

			windowDef arena_reset_bg
			{
				rect		0,0,360,400
				background	"gfx/guis/mainmenu/popup_bg"
				matcolor	0.07,0.085,0.045,0
				noevents	1
			}

			windowDef arena_reset_top
			{
				rect		0,118,360,19
				background	"gfx/guis/mainmenu/popup_top"
				matcolor	0.38,0.32,0.12,0
				noevents	1
			}

			windowDef arena_reset_mid
			{
				rect		0,137,360,118
				background	"gfx/guis/mainmenu/popup_mid"
				matcolor	0.16,0.14,0.055,0
				noevents	1
			}

			windowDef arena_reset_btm
			{
				rect		0,255,360,38
				background	"gfx/guis/mainmenu/popup_btm"
				matcolor	0.38,0.32,0.12,0
				noevents	1
			}

			windowDef arena_reset_accent
			{
				rect		0,118,360,3
				backcolor	0.95,0.31,0.08,0
				noevents	1
			}
		}

		windowDef arena_reset_content
		{
			rect		0,0,640,480
			visible		( "Desktop::arena_resetContentVisible" == 1 )
			noclip		1

			windowDef arena_reset_kicker
			{
				rect		160,124,300,14
				forecolor	0.76,0.7,0.55,1
				text		"#str_42011"
				textscale	0.16
				font		"fonts/lowpixel"
				noevents	1
			}

			windowDef arena_reset_title
			{
				rect		160,145,316,31
				forecolor	1,0.9,0.78,1
				text		"#str_42072"
				textscale	0.24
				font		"fonts/marine"
				textspacing	-1
				wrap		1
				noevents	1
			}

			windowDef arena_reset_message
			{
				rect		162,191,312,58
				forecolor	0.9,0.88,0.78,1
				text		"#str_42073"
				textscale	0.18
				font		"fonts/lowpixel"
				wrap		1
				noevents	1
			}

			windowDef arena_reset_cancel
			{
				rect		160,259,132,30
				background	"gfx/guis/mainmenu/b4_light"
				matcolor	0.545,0.588,0.294,0.4
				forecolor	0.95,0.95,0.88,1
				text		"#str_42074"
				textscale	0.23
				textalign	1
				font		"fonts/marine"

				onMouseEnter {
					set "matcolor" "0.95,0.49,0.06,0.92" ;
					set "cmd" "play main_menu_mouseover" ;
				}

				onMouseExit {
					set "matcolor" "0.545,0.588,0.294,0.4" ;
				}

				onAction {
					set "cmd" "play main_menu_selection" ;
					namedevent "arenaResetCancelTransition" ;
				}
			}

			windowDef arena_reset_cancel_corner
			{
				rect		170,267,11,11
				background	"gfx/guis/mainmenu/corner"
				matcolor	0.564,0.603,0.286,0.65
				noevents	1
			}

			windowDef arena_reset_confirm
			{
				rect		348,259,132,30
				background	"gfx/guis/mainmenu/b4_light"
				matcolor	0.82,0.24,0.07,0.72
				forecolor	1,0.9,0.78,1
				text		"#str_42075"
				textscale	0.22
				textalign	1
				font		"fonts/marine"

				onMouseEnter {
					set "matcolor" "1,0.46,0.16,0.98" ;
					set "cmd" "play main_menu_mouseover" ;
				}

				onMouseExit {
					set "matcolor" "0.82,0.24,0.07,0.72" ;
				}

				onAction {
					set "cmd" "play main_menu_selection" ;
					namedevent "arenaResetConfirmTransition" ;
				}
			}

			windowDef arena_reset_confirm_corner
			{
				rect		358,267,11,11
				background	"gfx/guis/mainmenu/corner"
				matcolor	0.95,0.38,0.1,0.8
				noevents	1
			}
		}

		// A late GUI tick must never let fixed copy outrun the expanding shell.
		// This smoked-olive cover lifts only after the shell has reached its full
		// legacy silhouette, then the existing content slide supplies the detail.
		windowDef arena_reset_entry_curtain
		{
			rect		( 0 - "gui::virtual_screen_x_expand" ),( 0 - "gui::virtual_screen_y_expand" ),( 640 + ( "gui::virtual_screen_x_expand" * 2 ) ),( 480 + ( "gui::virtual_screen_y_expand" * 2 ) )
			visible		( "Desktop::arena_resetPresentation" == 1 && "Desktop::arena_resetAnimating" == 1 )
			backcolor	0.018,0.026,0.014,0
			noevents	1
		}

		// This is deliberately a full-panel final layer.  It reaches opaque black
		// before the shell folds away, preventing the old empty-popup flash on
		// cancel, confirm, and externally cleared reset requests.
		windowDef arena_reset_exit_curtain
		{
			rect		( 0 - "gui::virtual_screen_x_expand" ),( 0 - "gui::virtual_screen_y_expand" ),( 640 + ( "gui::virtual_screen_x_expand" * 2 ) ),( 480 + ( "gui::virtual_screen_y_expand" * 2 ) )
			visible		( "Desktop::arena_resetAnimating" == 1 )
			backcolor	0,0,0,0
			noevents	1
		}
	}

	windowDef arena_reset_reveal_timeline
	{
		rect		0,0,1,1
		visible		1
		notime		1

		onTime 0 {
			stopTransitions "arena_reset_reveal_timeline" ;
			set "arena_reset_shade::backcolor" "0,0,0,0" ;
			set "arena_reset_shell::rect" "320,233,0,0" ;
			set "arena_reset_bg::matcolor" "0.07,0.085,0.045,0" ;
			set "arena_reset_top::matcolor" "0.38,0.32,0.12,0" ;
			set "arena_reset_mid::matcolor" "0.16,0.14,0.055,0" ;
			set "arena_reset_btm::matcolor" "0.38,0.32,0.12,0" ;
			set "arena_reset_accent::backcolor" "0.95,0.31,0.08,0" ;
			set "arena_reset_entry_curtain::backcolor" "0.018,0.026,0.014,1" ;
			set "arena_reset_exit_curtain::backcolor" "0,0,0,0" ;
			set "arena_reset_content::rect" "0,12,640,480" ;
			set "Desktop::arena_resetContentVisible" "0" ;
			transition "arena_reset_shade::backcolor" "0,0,0,0" "0,0,0,0.86" "180" ;
			transition "arena_reset_shell::rect" "320,233,0,0" "140,33,360,400" "260" ;
			transition "arena_reset_bg::matcolor" "0.07,0.085,0.045,0" "0.07,0.085,0.045,0.96" "240" ;
			transition "arena_reset_top::matcolor" "0.38,0.32,0.12,0" "0.38,0.32,0.12,0.8" "210" ;
			transition "arena_reset_mid::matcolor" "0.16,0.14,0.055,0" "0.16,0.14,0.055,0.82" "240" ;
			transition "arena_reset_btm::matcolor" "0.38,0.32,0.12,0" "0.38,0.32,0.12,0.8" "270" ;
			transition "arena_reset_accent::backcolor" "0.95,0.31,0.08,0" "0.95,0.31,0.08,1" "260" ;
		}

		onTime 260 {
			set "Desktop::arena_resetContentVisible" "1" ;
			transition "arena_reset_entry_curtain::backcolor" "0.018,0.026,0.014,1" "0.018,0.026,0.014,0" "150" ;
			transition "arena_reset_content::rect" "0,12,640,480" "0,0,640,480" "140" ;
		}

		onTime 500 {
			set "Desktop::arena_resetAnimating" "0" ;
			set "Desktop::arena_focusContext" "-1" ;
		}
	}

	windowDef arena_reset_exit_timeline
	{
		rect		0,0,1,1
		visible		1
		notime		1

		onTime 0 {
			stopTransitions "arena_reset_exit_timeline" ;
			set "arena_reset_entry_curtain::backcolor" "0.018,0.026,0.014,0" ;
			set "arena_reset_exit_curtain::backcolor" "0,0,0,0" ;
			transition "arena_reset_exit_curtain::backcolor" "0,0,0,0" "0,0,0,1" "120" ;
		}

		onTime 140 {
			set "Desktop::arena_resetContentVisible" "0" ;
			// State 2 keeps the shell and its final curtain alive while a C++ reset
			// command clears gui::arena_resetConfirm below the opaque cover.
			set "Desktop::arena_resetPresentation" "2" ;
			// Named literals rather than "$window::var": that source resolves at
			// parse time to the authored hidden state, which would collapse the
			// warning shell in a single frame.  These are the values the reveal
			// timeline settles on, and the confirm buttons cannot be reached
			// until it has finished.
			transition "arena_reset_shell::rect" "140,33,360,400" "320,233,0,0" "260" ;
			transition "arena_reset_shade::backcolor" "0,0,0,0.86" "0,0,0,0" "260" ;
			transition "arena_reset_bg::matcolor" "0.07,0.085,0.045,0.96" "0.07,0.085,0.045,0" "220" ;
			transition "arena_reset_top::matcolor" "0.38,0.32,0.12,0.8" "0.38,0.32,0.12,0" "180" ;
			transition "arena_reset_mid::matcolor" "0.16,0.14,0.055,0.82" "0.16,0.14,0.055,0" "220" ;
			transition "arena_reset_btm::matcolor" "0.38,0.32,0.12,0.8" "0.38,0.32,0.12,0" "240" ;
			transition "arena_reset_accent::backcolor" "0.95,0.31,0.08,1" "0.95,0.31,0.08,0" "200" ;
		}

		onTime 400 {
			if ( "Desktop::arena_resetRequested" == 1 ) {
				set "Desktop::arena_resetAwaitingClear" "1" ;
				set "cmd" "arenaResetCancel" ;
			} else if ( "Desktop::arena_resetRequested" == 2 ) {
				set "Desktop::arena_resetAwaitingClear" "1" ;
				set "cmd" "arenaResetConfirm" ;
			}
			transition "arena_reset_exit_curtain::backcolor" "0,0,0,1" "0,0,0,0" "180" ;
		}

		onTime 600 {
			set "Desktop::arena_resetPresentation" "0" ;
			set "Desktop::arena_resetAnimating" "0" ;
			set "Desktop::arena_resetRequested" "0" ;
			set "Desktop::arena_focusContext" "-1" ;
		}
	}

	// Sits above every actionable control while a cinematic transition owns the
	// screen.  Keyboard/controller focus is parked here as well, preventing a
	// held confirm key from skipping a reveal or accidentally replaying a match.
	// It must return a command to stop the mouse: its onAction parks a focus
	// context, and the event walk only halts on a returned cmd.
	windowDef arena_transition_blocker
	{
		rect		( 0 - "gui::virtual_screen_x_expand" ),( 0 - "gui::virtual_screen_y_expand" ),( 640 + ( "gui::virtual_screen_x_expand" * 2 ) ),( 480 + ( "gui::virtual_screen_y_expand" * 2 ) )
		visible		( "Desktop::arena_navigationAnimating" == 1 || "Desktop::arena_resetAnimating" == 1 || "Desktop::arena_launchVisible" == 1 || "Desktop::arena_progressAnimating" == 1 || "Desktop::arena_browserRevealing" == 1 || ( "gui::arena_result" != 0 && "Desktop::arena_resultReady" == 0 ) )
		backcolor	0,0,0,0

		onAction {
			set "Desktop::arena_focusContext" "12" ;
			set "cmd" "arenaBlockInput" ;
		}

		onESC {
			set "Desktop::arena_focusContext" "12" ;
		}
	}
}
