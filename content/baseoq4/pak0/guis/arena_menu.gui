windowDef Desktop
{
	rect		0,0,640,480
	menugui		1
	noclip		1
	float		"arena_focusContext"	-1
	float		"arena_launchVisible"	0
	float		"arena_resultPhase"	0
	float		"arena_resultReady"	0
	float		"arena_resultAction"	0
	float		"arena_progressAnimating"	0
	float		"arena_browserRevealing"	0
	float		"arena_navigationAnimating"	0
	float		"arena_navigationAction"	0
	float		"arena_modeSubject"	0
	float		"arena_resetPresentation"	0
	float		"arena_resetAnimating"	0
	float		"arena_resetContentVisible"	0
	float		"arena_resetRequested"	0
	float		"arena_resetAwaitingClear"	0

	// stopTransitions only reaches the calling window's own subtree, and a
	// transition always belongs to the window whose script created it.  Only the
	// Desktop can therefore retire a *different* timeline's live transitions, so
	// every entry point that can pre-empt another one clears it here.  Each
	// timeline still clears its own at onTime 0 so a restart cannot stack.
	onActivate {
		stopTransitions "arena_mode_reveal_timeline" ;
		stopTransitions "arena_mode_exit_timeline" ;
		stopTransitions "arena_browser_entry_timeline" ;
		stopTransitions "arena_browser_exit_timeline" ;
		stopTransitions "arena_mode_return_timeline" ;
		set "Desktop::arena_focusContext" "-1" ;
		set "Desktop::arena_launchVisible" "0" ;
		set "Desktop::arena_resultPhase" "0" ;
		set "Desktop::arena_resultReady" "0" ;
		set "Desktop::arena_resultAction" "0" ;
		set "Desktop::arena_progressAnimating" "0" ;
		set "Desktop::arena_browserRevealing" "0" ;
		set "Desktop::arena_navigationAnimating" "1" ;
		set "Desktop::arena_navigationAction" "0" ;
		set "Desktop::arena_modeSubject" "0" ;
		set "Desktop::arena_resetPresentation" "0" ;
		set "Desktop::arena_resetAnimating" "0" ;
		set "Desktop::arena_resetContentVisible" "0" ;
		set "Desktop::arena_resetRequested" "0" ;
		set "Desktop::arena_resetAwaitingClear" "0" ;
		setfocus "arena_transition_blocker" ;
		if ( "gui::arena_view" == 0 ) {
			resetTime "arena_mode_reveal_timeline" "0" ;
		} else {
			resetTime "arena_browser_entry_timeline" "0" ;
		}
	}

	onNamedEvent arenaMatchLaunch {
		set "Desktop::arena_focusContext" "-1" ;
		set "Desktop::arena_launchVisible" "1" ;
		setfocus "arena_transition_blocker" ;
		resetTime "arena_launch_timeline" "0" ;
	}

	onNamedEvent arenaResultReveal {
		stopTransitions "arena_result_exit_timeline" ;
		set "Desktop::arena_focusContext" "-1" ;
		set "Desktop::arena_launchVisible" "0" ;
		set "Desktop::arena_progressAnimating" "0" ;
		set "Desktop::arena_browserRevealing" "0" ;
		set "Desktop::arena_resultPhase" "0" ;
		set "Desktop::arena_resultReady" "0" ;
		set "Desktop::arena_resultAction" "0" ;
		setfocus "arena_transition_blocker" ;
		resetTime "arena_result_reveal_timeline" "0" ;
	}

	onNamedEvent arenaProgressReveal {
		set "Desktop::arena_focusContext" "-1" ;
		set "Desktop::arena_launchVisible" "0" ;
		set "Desktop::arena_browserRevealing" "0" ;
		set "Desktop::arena_progressAnimating" "1" ;
		setfocus "arena_transition_blocker" ;
		resetTime "arena_progress_reveal_timeline" "0" ;
	}

	onNamedEvent arenaBrowserReveal {
		set "Desktop::arena_focusContext" "-1" ;
		set "Desktop::arena_launchVisible" "0" ;
		set "Desktop::arena_progressAnimating" "0" ;
		set "Desktop::arena_browserRevealing" "1" ;
		setfocus "arena_transition_blocker" ;
		resetTime "arena_browser_reveal_timeline" "0" ;
	}

	// Navigation owns a short black-frame handoff before changing the authored
	// context.  The underlying C++ commands remain unchanged and are issued by
	// the timelines after their outgoing frame has been presented.
	onNamedEvent arenaOpenBrowser {
		if ( "Desktop::arena_navigationAnimating" == 0 ) {
			set "Desktop::arena_focusContext" "-1" ;
			set "Desktop::arena_navigationAnimating" "1" ;
			set "Desktop::arena_navigationAction" "1" ;
			setfocus "arena_transition_blocker" ;
			resetTime "arena_mode_exit_timeline" "0" ;
		}
	}

	onNamedEvent arenaOpenMission {
		if ( "Desktop::arena_navigationAnimating" == 0 ) {
			set "Desktop::arena_focusContext" "-1" ;
			set "Desktop::arena_navigationAnimating" "1" ;
			set "Desktop::arena_navigationAction" "2" ;
			setfocus "arena_transition_blocker" ;
			resetTime "arena_mode_exit_timeline" "0" ;
		}
	}

	onNamedEvent arenaCloseSelector {
		if ( "Desktop::arena_navigationAnimating" == 0 ) {
			set "Desktop::arena_focusContext" "-1" ;
			set "Desktop::arena_navigationAnimating" "1" ;
			set "Desktop::arena_navigationAction" "3" ;
			setfocus "arena_transition_blocker" ;
			resetTime "arena_mode_exit_timeline" "0" ;
		}
	}

	onNamedEvent arenaReturnToModes {
		if ( "Desktop::arena_navigationAnimating" == 0 ) {
			set "Desktop::arena_focusContext" "-1" ;
			set "Desktop::arena_navigationAnimating" "1" ;
			set "Desktop::arena_navigationAction" "4" ;
			setfocus "arena_transition_blocker" ;
			resetTime "arena_browser_exit_timeline" "0" ;
		}
	}

	// The framework raises this as soon as it publishes the confirmation state.
	// Keeping the reveal event-driven gives the first covered frame the same
	// deterministic ownership as the launch and results cards.
	onNamedEvent arenaResetReveal {
		if ( "Desktop::arena_resetPresentation" == 0 && "Desktop::arena_resetAwaitingClear" == 0 ) {
			stopTransitions "arena_reset_exit_timeline" ;
			set "gui::arena_resetConfirm" "1" ;
			set "Desktop::arena_resetPresentation" "1" ;
			set "Desktop::arena_resetAnimating" "1" ;
			set "Desktop::arena_resetContentVisible" "0" ;
			set "Desktop::arena_resetRequested" "0" ;
			set "Desktop::arena_focusContext" "-1" ;
			setfocus "arena_transition_blocker" ;
			resetTime "arena_reset_reveal_timeline" "0" ;
		}
	}

	onNamedEvent arenaResetCancelTransition {
		if ( "Desktop::arena_resetPresentation" == 1 && "Desktop::arena_resetAnimating" == 0 ) {
			stopTransitions "arena_reset_reveal_timeline" ;
			set "Desktop::arena_resetRequested" "1" ;
			set "Desktop::arena_resetAnimating" "1" ;
			set "Desktop::arena_focusContext" "-1" ;
			setfocus "arena_transition_blocker" ;
			resetTime "arena_reset_exit_timeline" "0" ;
		}
	}

	onNamedEvent arenaResetConfirmTransition {
		if ( "Desktop::arena_resetPresentation" == 1 && "Desktop::arena_resetAnimating" == 0 ) {
			stopTransitions "arena_reset_reveal_timeline" ;
			set "Desktop::arena_resetRequested" "2" ;
			set "Desktop::arena_resetAnimating" "1" ;
			set "Desktop::arena_focusContext" "-1" ;
			setfocus "arena_transition_blocker" ;
			resetTime "arena_reset_exit_timeline" "0" ;
		}
	}

	// GUI state is refreshed just after activation, so choose focus on the next
	// frame and only when the visible interaction context actually changes.
	onEvent {
		if ( "gui::arena_resetConfirm" != 1 && "Desktop::arena_resetAwaitingClear" == 1 ) {
			set "Desktop::arena_resetAwaitingClear" "0" ;
		} else if ( "gui::arena_resetConfirm" == 1 && "Desktop::arena_resetPresentation" == 0 && "Desktop::arena_resetAwaitingClear" == 0 ) {
			stopTransitions "arena_reset_exit_timeline" ;
			set "Desktop::arena_resetPresentation" "1" ;
			set "Desktop::arena_resetAnimating" "1" ;
			set "Desktop::arena_resetContentVisible" "0" ;
			set "Desktop::arena_resetRequested" "0" ;
			set "Desktop::arena_focusContext" "-1" ;
			setfocus "arena_transition_blocker" ;
			resetTime "arena_reset_reveal_timeline" "0" ;
		} else if ( "gui::arena_resetConfirm" != 1 && "Desktop::arena_resetPresentation" == 1 ) {
			stopTransitions "arena_reset_reveal_timeline" ;
			set "Desktop::arena_resetPresentation" "2" ;
			set "Desktop::arena_resetAnimating" "1" ;
			set "Desktop::arena_focusContext" "-1" ;
			setfocus "arena_transition_blocker" ;
			resetTime "arena_reset_exit_timeline" "0" ;
		}

		if ( "Desktop::arena_navigationAnimating" == 1 || "Desktop::arena_resetAnimating" == 1 || "Desktop::arena_launchVisible" == 1 || "Desktop::arena_progressAnimating" == 1 || "Desktop::arena_browserRevealing" == 1 || ( "gui::arena_result" != 0 && "Desktop::arena_resultReady" == 0 ) ) {
			if ( "Desktop::arena_focusContext" != 12 ) {
				setfocus "arena_transition_blocker" ;
				set "Desktop::arena_focusContext" "12" ;
			}
		} else if ( "Desktop::arena_resetPresentation" == 1 ) {
			if ( "Desktop::arena_focusContext" != 10 ) {
				setfocus "arena_reset_cancel" ;
				set "Desktop::arena_focusContext" "10" ;
			}
		} else if ( "gui::arena_result" == 1 && "gui::arena_campaignComplete" == 0 && "gui::arena_resultCanRetry" == 1 ) {
			if ( "Desktop::arena_focusContext" != 2 ) {
				setfocus "arena_result_next" ;
				set "Desktop::arena_focusContext" "2" ;
			}
		} else if ( "gui::arena_result" == 1 && "gui::arena_campaignComplete" == 0 ) {
			if ( "Desktop::arena_focusContext" != 3 ) {
				setfocus "arena_result_next_full" ;
				set "Desktop::arena_focusContext" "3" ;
			}
		} else if ( "gui::arena_result" == 1 && "gui::arena_resultCanRetry" == 1 ) {
			if ( "Desktop::arena_focusContext" != 4 ) {
				setfocus "arena_result_return" ;
				set "Desktop::arena_focusContext" "4" ;
			}
		} else if ( "gui::arena_result" == 1 ) {
			if ( "Desktop::arena_focusContext" != 5 ) {
				setfocus "arena_result_return_full" ;
				set "Desktop::arena_focusContext" "5" ;
			}
		} else if ( "gui::arena_result" == 2 && "gui::arena_resultCanRetry" == 1 ) {
			if ( "Desktop::arena_focusContext" != 6 ) {
				setfocus "arena_result_retry" ;
				set "Desktop::arena_focusContext" "6" ;
			}
		} else if ( "gui::arena_result" == 4 && "gui::arena_resultCanRetry" == 1 ) {
			if ( "Desktop::arena_focusContext" != 7 ) {
				setfocus "arena_result_replay" ;
				set "Desktop::arena_focusContext" "7" ;
			}
		} else if ( "gui::arena_result" == 2 || "gui::arena_result" == 4 ) {
			if ( "Desktop::arena_focusContext" != 8 ) {
				setfocus "arena_result_return_full" ;
				set "Desktop::arena_focusContext" "8" ;
			}
		} else if ( "gui::arena_result" == 3 && "gui::arena_resultCanRetry" == 1 ) {
			if ( "Desktop::arena_focusContext" != 13 ) {
				setfocus "arena_result_retry" ;
				set "Desktop::arena_focusContext" "13" ;
			}
		} else if ( "gui::arena_result" == 3 ) {
			if ( "Desktop::arena_focusContext" != 9 ) {
				setfocus "arena_result_continue_only" ;
				set "Desktop::arena_focusContext" "9" ;
			}
		} else if ( "gui::arena_view" == 0 ) {
			if ( "Desktop::arena_focusContext" != 0 ) {
				setfocus "arena_mode_mission_card" ;
				set "Desktop::arena_focusContext" "0" ;
			}
		} else if ( "gui::arena_canStart" == 1 ) {
			if ( "Desktop::arena_focusContext" != 1 ) {
				setfocus "arena_start_enabled" ;
				set "Desktop::arena_focusContext" "1" ;
			}
		} else {
			if ( "Desktop::arena_focusContext" != 11 ) {
				setfocus "arena_browser_back" ;
				set "Desktop::arena_focusContext" "11" ;
			}
		}
	}

	onESC {
		if ( "Desktop::arena_navigationAnimating" == 1 || "Desktop::arena_resetAnimating" == 1 || "Desktop::arena_launchVisible" == 1 || "Desktop::arena_progressAnimating" == 1 || "Desktop::arena_browserRevealing" == 1 || ( "gui::arena_result" != 0 && "Desktop::arena_resultReady" == 0 ) ) {
			set "Desktop::arena_focusContext" "12" ;
		} else if ( "gui::arena_resetConfirm" == 1 ) {
			namedevent "arenaResetCancelTransition" ;
		} else if ( "gui::arena_result" != 0 ) {
			set "Desktop::arena_resultAction" "1" ;
			set "Desktop::arena_resultReady" "0" ;
			resetTime "arena_result_exit_timeline" "0" ;
		} else if ( "gui::arena_view" == 1 ) {
			namedevent "arenaReturnToModes" ;
		} else {
			namedevent "arenaCloseSelector" ;
		}
	}

	// Shared backdrop, the retained pages' own: black, the stock screen's light
	// band across the middle and a quiet grid, the same at every width.
	windowDef arena_backdrop
	{
		rect		( 0 - "gui::virtual_screen_x_expand" ),( 0 - "gui::virtual_screen_y_expand" ),( 640 + ( "gui::virtual_screen_x_expand" * 2 ) ),( 480 + ( "gui::virtual_screen_y_expand" * 2 ) )
		backcolor	0,0,0,1
		noevents	1
	}

	windowDef arena_screen_tint
	{
		rect		( 0 - "gui::virtual_screen_x_expand" ),( 0 - "gui::virtual_screen_y_expand" ),( 640 + ( "gui::virtual_screen_x_expand" * 2 ) ),( 480 + ( "gui::virtual_screen_y_expand" * 2 ) )
		background	"gfx/guis/mainmenu/screen"
		matcolor	0.64,0.64,0.64,1
		noclip		1
		noevents	1
	}

	windowDef arena_grid
	{
		rect		( 0 - "gui::virtual_screen_x_expand" ),( 0 - "gui::virtual_screen_y_expand" ),( 640 + ( "gui::virtual_screen_x_expand" * 2 ) ),( 480 + ( "gui::virtual_screen_y_expand" * 2 ) )
		background	"gfx/guis/loading/bg_grid_tiled"
		matcolor	0.35,0.42,0.22,0.16
		naturalmatscale	1
		noevents	1
	}

	windowDef arena_topbar
	{
		rect		-77,-63,1045,129
		noclip		1
		background	"gfx/guis/mainmenu/topbar"
		matcolor	1,1,1,0.9
		noevents	1

		windowDef arena_topbar_tile_left
		{
			rect		-4096,0,4097,129
			background	"gfx/guis/mainmenu/topbar_tile_left"
			matscalex	128
			matcolor	1,1,1,0.9
			noevents	1
		}

		windowDef arena_topbar_tile_right
		{
			rect		1044,0,4097,129
			background	"gfx/guis/mainmenu/topbar_tile_right"
			matscalex	128
			matcolor	1,1,1,0.9
			noevents	1
		}
	}

	windowDef arena_btmbar
	{
		rect		-26,386,1045,129
		noclip		1
		background	"gfx/guis/mainmenu/btmbar"
		matcolor	1,1,1,0.9
		noevents	1

		windowDef arena_btmbar_tile_left
		{
			rect		-4096,0,4097,129
			background	"gfx/guis/mainmenu/btmbar_tile_left"
			matscalex	128
			matcolor	1,1,1,0.9
			noevents	1
		}

		windowDef arena_btmbar_tile_right
		{
			rect		1044,0,4097,129
			background	"gfx/guis/mainmenu/btmbar_tile_right"
			matscalex	128
			matcolor	1,1,1,0.9
			noevents	1
		}
	}

	// First level: the Single Player page, laid out as the stock pages are and
	// as the retained interface shows it: the title in the docked top band's
	// slot, the sections on the stock plates from 181 u, the subject's summary
	// in the content column and BACK in the bottom band's raised section.
	windowDef arena_mode_selector
	{
		rect		0,0,640,480
		visible		( "gui::arena_view" == 0 )

		windowDef arena_mode_title
		{
			rect		39,19,314,16
			forecolor	1,1,1,0.5
			text		"#str_42000"
			textscale	0.25
			font		"fonts/marine"
			noevents	1
		}

		windowDef arena_mode_description
		{
			rect		395,186,218,120
			visible		( "Desktop::arena_modeSubject" == 0 )
			forecolor	0.62,0.68,0.36,1
			text		"#str_230044"
			textscale	0.27
			font		"fonts/lowpixel"
			noevents	1
		}

		windowDef arena_mode_mission_description
		{
			rect		395,186,218,120
			visible		( "Desktop::arena_modeSubject" == 1 )
			forecolor	0.62,0.68,0.36,1
			text		"#str_231552"
			textscale	0.27
			font		"fonts/lowpixel"
			noevents	1
		}

		windowDef arena_mode_arena_description
		{
			rect		395,186,218,120
			visible		( "Desktop::arena_modeSubject" == 2 )
			forecolor	0.62,0.68,0.36,1
			text		"#str_231553"
			textscale	0.27
			font		"fonts/lowpixel"
			noevents	1
		}

		windowDef arena_mode_mission_plate
		{
			rect		0,169,413,52
			background	"gfx/guis/mainmenu/b1_dark"
			matcolor	1,1,1,0.4
			noevents	1
		}

		windowDef arena_mode_mission_corner
		{
			rect		32,188,12,12
			background	"gfx/guis/mainmenu/corner"
			matcolor	0.564,0.603,0.286,0.4
			noevents	1
		}

		windowDef arena_mode_mission_title
		{
			rect		44,181,320,23
			forecolor	1,1,1,0.8
			text		"#str_230038"
			textscale	0.31
			font		"fonts/marine"
			noevents	1
		}

		windowDef arena_mode_mission_card
		{
			rect		24,181,333,26

			onMouseEnter {
				stoptransitions "arena_mode_mission_card" ;
				set "arena_mode_mission_plate::matcolor_w" "1" ;
				transition "arena_mode_mission_title::forecolor" "1,1,1,0.8" "0.890,0.537,0,1" "0" ;
				transition "arena_mode_mission_corner::matcolor" "0.564,0.603,0.286,0.4" "0.890,0.537,0,1" "0" ;
				set "arena_mode_mission_title::textscale" "0.32" ;
				set "Desktop::arena_modeSubject" "1" ;
				set "cmd" "play main_menu_mouseover" ;
			}

			onMouseExit {
				transition "arena_mode_mission_plate::matcolor_w" "1" "0.4" "300" ;
				transition "arena_mode_mission_title::forecolor" "0.890,0.537,0,1" "1,1,1,0.8" "300" ;
				transition "arena_mode_mission_corner::matcolor" "0.890,0.537,0,1" "0.564,0.603,0.286,0.4" "300" ;
				transition "arena_mode_mission_title::textscale" "0.32" "0.31" "300" ;
				if ( "Desktop::arena_modeSubject" == 1 ) {
					set "Desktop::arena_modeSubject" "0" ;
				}
			}

			onAction {
				set "cmd" "play main_menu_selection" ;
				namedevent "arenaOpenMission" ;
			}
		}

		windowDef arena_mode_arena_plate
		{
			rect		0,199,413,52
			background	"gfx/guis/mainmenu/b1_dark"
			matcolor	1,1,1,0.4
			noevents	1
		}

		windowDef arena_mode_arena_corner
		{
			rect		32,218,12,12
			background	"gfx/guis/mainmenu/corner"
			matcolor	0.564,0.603,0.286,0.4
			noevents	1
		}

		windowDef arena_mode_arena_title
		{
			rect		44,211,320,23
			forecolor	1,1,1,0.8
			text		"#str_42002"
			textscale	0.31
			font		"fonts/marine"
			noevents	1
		}

		windowDef arena_mode_arena_card
		{
			rect		24,211,333,26

			onMouseEnter {
				stoptransitions "arena_mode_arena_card" ;
				set "arena_mode_arena_plate::matcolor_w" "1" ;
				transition "arena_mode_arena_title::forecolor" "1,1,1,0.8" "0.890,0.537,0,1" "0" ;
				transition "arena_mode_arena_corner::matcolor" "0.564,0.603,0.286,0.4" "0.890,0.537,0,1" "0" ;
				set "arena_mode_arena_title::textscale" "0.32" ;
				set "Desktop::arena_modeSubject" "2" ;
				set "cmd" "play main_menu_mouseover" ;
			}

			onMouseExit {
				transition "arena_mode_arena_plate::matcolor_w" "1" "0.4" "300" ;
				transition "arena_mode_arena_title::forecolor" "0.890,0.537,0,1" "1,1,1,0.8" "300" ;
				transition "arena_mode_arena_corner::matcolor" "0.890,0.537,0,1" "0.564,0.603,0.286,0.4" "300" ;
				transition "arena_mode_arena_title::textscale" "0.32" "0.31" "300" ;
				if ( "Desktop::arena_modeSubject" == 2 ) {
					set "Desktop::arena_modeSubject" "0" ;
				}
			}

			onAction {
				set "cmd" "play main_menu_selection" ;
				namedevent "arenaOpenBrowser" ;
			}
		}

		windowDef arena_mode_back_plate
		{
			rect		532,441,109,30
			background	"gfx/guis/mainmenu/b4_light"
			matcolor	0.545,0.588,0.294,0.4
			noevents	1
		}

		windowDef arena_mode_back_corner
		{
			rect		542,449,11,11
			background	"gfx/guis/mainmenu/corner"
			matcolor	0.564,0.603,0.286,0.4
			noevents	1
		}

		windowDef arena_mode_back_title
		{
			rect		552,443,88,17
			forecolor	1,1,1,0.8
			text		"#str_42005"
			textscale	0.28
			font		"fonts/marine"
			noevents	1
		}

		windowDef arena_mode_back
		{
			rect		536,444,105,23

			onMouseEnter {
				stoptransitions "arena_mode_back" ;
				set "arena_mode_back_plate::matcolor_w" "0.8" ;
				transition "arena_mode_back_title::forecolor" "1,1,1,0.8" "0.890,0.537,0,1" "0" ;
				transition "arena_mode_back_corner::matcolor" "0.564,0.603,0.286,0.4" "0.890,0.537,0,1" "0" ;
				set "arena_mode_back_title::textscale" "0.29" ;
				set "cmd" "play main_menu_mouseover" ;
			}

			onMouseExit {
				transition "arena_mode_back_plate::matcolor_w" "0.8" "0.4" "300" ;
				transition "arena_mode_back_title::forecolor" "0.890,0.537,0,1" "1,1,1,0.8" "300" ;
				transition "arena_mode_back_corner::matcolor" "0.890,0.537,0,1" "0.564,0.603,0.286,0.4" "300" ;
				transition "arena_mode_back_title::textscale" "0.29" "0.28" "300" ;
			}

			onAction {
				set "cmd" "play main_menu_selection" ;
				namedevent "arenaCloseSelector" ;
			}
		}
	}

