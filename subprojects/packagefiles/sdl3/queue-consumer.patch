+/* openQ4 private queue guard. All mutable fields below are protected by the
+ * event queue lock. Only the atomic health summary is read without that lock. */
+static bool oq4_queue_polling, oq4_queue_active, oq4_queue_closed, oq4_queue_fence_queued, oq4_queue_verified;
+static SDL_AtomicInt oq4_queue_health;
