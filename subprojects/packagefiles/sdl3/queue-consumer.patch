+static void OQ4_QueueFault(void)
+{
+    if (oq4_queue_active) {
+        SDL_SetAtomicInt(&oq4_queue_health, 0);
+        SDL_SetError("openQ4 native SDL queue continuity was lost");
+    }
+}
+static void OQ4_QueueRetireLocked(void)
+{
+    oq4_queue_active = oq4_queue_closed = oq4_queue_fence_queued = oq4_queue_verified = false;
+    oq4_queue_dispatch = oq4_queue_fence_sequence = 0;
+    oq4_queue_count = oq4_queue_consumed = 0;
+    oq4_queue_get_entry = NULL;
+    SDL_SetAtomicInt(&oq4_queue_health, 0);
+}
+bool OQ4_WIN_QueueHealthy(void) { return SDL_GetAtomicInt(&oq4_queue_health) != 0; }
+void OQ4_WIN_QueueRetire(void)
+{
+    SDL_LockMutex(SDL_EventQ.lock);
+    OQ4_QueueRetireLocked();
+    SDL_UnlockMutex(SDL_EventQ.lock);
+}
+bool OQ4_WIN_QueueEnable(void)
+{
+    SDL_EventEntry *entry;
+    bool ready = false;
+    if (!SDL_IsMainThread()) return false;
+    SDL_LockMutex(SDL_EventQ.lock);
+    if (SDL_EventQ.active && !oq4_queue_active && !oq4_queue_polling && oq4_queue_generation < SDL_MAX_UINT64 && oq4_queue_sequence < SDL_MAX_UINT64 &&
+        SDL_GetAtomicInt(&SDL_EventQ.count) >= 0 &&
+        (Uint64)SDL_GetAtomicInt(&SDL_EventQ.count) <= SDL_MAX_UINT64 - oq4_queue_sequence) {
+        ++oq4_queue_generation;
+        for (entry = SDL_EventQ.head; entry; entry = entry->next) {
+            SDL_zero(entry->oq4_record);
+            entry->oq4_record.version = 1;
+            entry->oq4_record.kind = entry->event.type == SDL_EVENT_POLL_SENTINEL ? OQ4_QUEUE_SENTINEL : OQ4_QUEUE_OUTSIDE;
+            entry->oq4_record.generation = oq4_queue_generation;
+            entry->oq4_record.queue_sequence = ++oq4_queue_sequence;
+        }
+        oq4_queue_active = true;
+        SDL_SetAtomicInt(&oq4_queue_health, 1);
+        ready = true;
+    }
+    SDL_UnlockMutex(SDL_EventQ.lock);
+    return ready;
+}
+bool OQ4_WIN_QueueBegin(Uint64 dispatch)
+{
+    bool ready = false;
+    SDL_LockMutex(SDL_EventQ.lock);
+    if (oq4_queue_active && OQ4_WIN_QueueHealthy() && dispatch && !oq4_queue_dispatch) {
+        oq4_queue_dispatch = dispatch;
+        oq4_queue_count = oq4_queue_consumed = 0;
+        oq4_queue_closed = oq4_queue_fence_queued = oq4_queue_verified = false;
+        ready = true;
+    }
+    SDL_UnlockMutex(SDL_EventQ.lock);
+    return ready;
+}
+bool OQ4_WIN_QueueEnd(Uint64 dispatch, Uint32 *count)
+{
+    bool ready = false;
+    SDL_LockMutex(SDL_EventQ.lock);
+    if (oq4_queue_active && OQ4_WIN_QueueHealthy() && dispatch == oq4_queue_dispatch && !oq4_queue_closed) {
+        oq4_queue_closed = true;
+        *count = oq4_queue_count;
+        ready = true;
+    }
+    SDL_UnlockMutex(SDL_EventQ.lock);
+    return ready;
+}
+void OQ4_WIN_QueueEmpty(Uint64 dispatch)
+{
+    SDL_LockMutex(SDL_EventQ.lock);
+    if (dispatch == oq4_queue_dispatch && !oq4_queue_count && !oq4_queue_fence_queued) {
+        oq4_queue_dispatch = 0;
+        oq4_queue_closed = false;
+    } else OQ4_QueueFault();
+    SDL_UnlockMutex(SDL_EventQ.lock);
+}
+static bool OQ4_QueueVerifiedLocked(Uint64 dispatch, Uint64 sequence)
+{
+    return oq4_queue_active && OQ4_WIN_QueueHealthy() && oq4_queue_verified &&
+        dispatch && dispatch == oq4_queue_dispatch && sequence && sequence == oq4_queue_fence_sequence &&
+        oq4_queue_closed && oq4_queue_consumed == oq4_queue_count;
+}
+bool OQ4_WIN_QueueVerified(Uint64 dispatch, Uint64 sequence)
+{
+    bool verified;
+    SDL_LockMutex(SDL_EventQ.lock);
+    verified = OQ4_QueueVerifiedLocked(dispatch, sequence);
+    SDL_UnlockMutex(SDL_EventQ.lock);
+    return verified;
+}
+bool OQ4_WIN_QueueAcknowledge(Uint64 dispatch, Uint64 sequence)
+{
+    bool verified;
+    SDL_LockMutex(SDL_EventQ.lock);
+    verified = OQ4_QueueVerifiedLocked(dispatch, sequence);
+    if (verified) {
+        oq4_queue_dispatch = oq4_queue_fence_sequence = 0;
+        oq4_queue_count = oq4_queue_consumed = 0;
+        oq4_queue_closed = oq4_queue_verified = oq4_queue_fence_queued = false;
+    }
+    SDL_UnlockMutex(SDL_EventQ.lock);
+    return verified;
+}
+/* Capture before allocator/log callbacks; assign actual ordinal only at link. */
+typedef struct OQ4_QueueAdmission {
+    Uint64 generation, dispatch, fence_sequence;
+    int fence;
+    SDL_Event marker;
+} OQ4_QueueAdmission;
+static bool OQ4_QueueAdmissionBegin(const SDL_Event *event, OQ4_QueueAdmission *out)
+{
+    SDL_zero(*out);
+    out->fence = OQ4_WIN_ClaimFenceQueueAdmission(event, &out->dispatch, &out->fence_sequence);
+    if (out->fence < 0) { OQ4_QueueFault(); return false; }
+    if (oq4_queue_active) {
+        if (!OQ4_WIN_QueueHealthy()) return true; /* legacy queue remains available after fault */
+        out->generation = oq4_queue_generation;
+        if (out->fence) { SDL_copyp(&out->marker, event); }
+        else out->dispatch = OQ4_WIN_CurrentNativeDispatch(); /* worker additions are explicit Outside */
+    }
+    return true;
+}
+static bool OQ4_QueueAdmissionCommit(SDL_EventEntry *entry, const SDL_Event *event, const OQ4_QueueAdmission *origin)
+{
+    SDL_zero(entry->oq4_record);
+    if (!oq4_queue_active) return origin->fence == 0;
+    if (!OQ4_WIN_QueueHealthy()) return origin->fence == 0;
+    if (!origin->generation || origin->generation != oq4_queue_generation || oq4_queue_sequence == SDL_MAX_UINT64) {
+        OQ4_QueueFault(); return false;
+    }
+    entry->oq4_record.version = 1;
+    entry->oq4_record.generation = oq4_queue_generation;
+    entry->oq4_record.kind = event->type == SDL_EVENT_POLL_SENTINEL ? OQ4_QUEUE_SENTINEL : OQ4_QUEUE_OUTSIDE;
+    if (origin->fence) {
+        if (!oq4_queue_closed || oq4_queue_fence_queued || origin->dispatch != oq4_queue_dispatch ||
+            !origin->fence_sequence || SDL_memcmp(event, &origin->marker, sizeof(*event))) {
+            OQ4_QueueFault(); return false;
+        }
+        entry->oq4_record.kind = OQ4_QUEUE_FENCE;
+        entry->oq4_record.dispatch = origin->dispatch;
+        entry->oq4_record.ordinal = oq4_queue_count;
+        entry->oq4_record.fence_sequence = origin->fence_sequence;
+        oq4_queue_fence_sequence = origin->fence_sequence;
+        oq4_queue_fence_queued = true;
+    } else if (origin->dispatch && entry->oq4_record.kind != OQ4_QUEUE_SENTINEL) {
+        if (oq4_queue_closed || origin->dispatch != oq4_queue_dispatch || oq4_queue_count == 4096) {
+            OQ4_QueueFault(); return false;
+        }
+        entry->oq4_record.kind = OQ4_QUEUE_COLLECTION;
+        entry->oq4_record.dispatch = origin->dispatch;
+        entry->oq4_record.ordinal = ++oq4_queue_count;
+    }
+    entry->oq4_record.queue_sequence = ++oq4_queue_sequence;
+    return true;
+}
+static void OQ4_QueueRemoved(SDL_EventEntry *entry)
+{
+    const bool authorized = entry == oq4_queue_get_entry;
+    oq4_queue_get_entry = NULL; /* one exact Cut, never a reentrant blanket permit */
+    if (!oq4_queue_active) return;
+    if (entry->oq4_record.kind == OQ4_QUEUE_SENTINEL && entry->event.type == SDL_EVENT_POLL_SENTINEL) return;
+    if (!authorized || entry->oq4_record.generation != oq4_queue_generation) OQ4_QueueFault();
+}
+/* Called instead of invoking mutable queue filters directly. A false result is
+ * still removed by legacy SDL; either mutation or removal invalidates affinity. */
+static bool OQ4_QueueFilter(SDL_EventFilter filter, void *userdata, SDL_EventEntry *entry)
+{
+    SDL_Event before;
+    const bool guarded = oq4_queue_active;
+    const Uint64 generation = oq4_queue_generation;
+    bool accepted;
+    SDL_copyp(&before, &entry->event);
+    accepted = filter(userdata, &entry->event);
+    if (guarded && oq4_queue_active && generation == oq4_queue_generation && OQ4_WIN_QueueHealthy() &&
+        SDL_memcmp(&before, &entry->event, sizeof(before))) OQ4_QueueFault();
+    return accepted;
+}
+#endif
