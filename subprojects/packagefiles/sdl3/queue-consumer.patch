+        receipt.kind > OQ4_QUEUE_FENCE || receipt.reserved) { OQ4_QueueFault(); goto done; }
+    if (receipt.kind == OQ4_QUEUE_COLLECTION) {
+        if (receipt.dispatch != oq4_queue_dispatch || receipt.ordinal != oq4_queue_consumed + 1 ||
+            receipt.ordinal > oq4_queue_count || receipt.fence_sequence || oq4_queue_verified) { OQ4_QueueFault(); goto done; }
+    } else if (receipt.kind == OQ4_QUEUE_FENCE) {
+        if (!oq4_queue_closed || !oq4_queue_fence_queued || oq4_queue_verified || receipt.dispatch != oq4_queue_dispatch ||
+            receipt.ordinal != oq4_queue_count || oq4_queue_consumed != oq4_queue_count ||
+            receipt.fence_sequence != oq4_queue_fence_sequence) { OQ4_QueueFault(); goto done; }
+    } else if (receipt.dispatch || receipt.ordinal || receipt.fence_sequence ||
+        (receipt.kind == OQ4_QUEUE_SENTINEL) != (entry->event.type == SDL_EVENT_POLL_SENTINEL)) {
+        OQ4_QueueFault(); goto done;
+    }
+    SDL_copyp(&candidate, &entry->event);
+    oq4_queue_get_entry = entry;
+    SDL_CutEvent(entry);
+    if (!oq4_queue_active || !OQ4_WIN_QueueHealthy()) goto done;
+    if (receipt.kind == OQ4_QUEUE_COLLECTION) ++oq4_queue_consumed;
+    if (receipt.kind == OQ4_QUEUE_FENCE) oq4_queue_verified = true;
