rmlui_library = static_library('rmlui-core', rmlui_sources,
  include_directories: rmlui_includes,
  cpp_args: rmlui_args + ['-DRMLUI_VERSION="6.3"'],
  pic: true, install: false)
rmlui_dep = declare_dependency(link_with: rmlui_library,
  include_directories: rmlui_includes, compile_args: rmlui_args)
meson.override_dependency('rmlui', rmlui_dep)
